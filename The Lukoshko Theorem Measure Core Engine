        }
        .ws-panel-body label.ws-lab { font-size: 0.78rem; color: var(--text-secondary); }
        .ws-metric { font-size: 1.2rem; font-weight: 600; color: var(--accent); word-break: break-all; }
        .ws-out-rows { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; font-size: 0.82rem; }
        .ws-out-rows .k { color: var(--text-secondary); white-space: nowrap; }
        .ws-out-rows .v { word-break: break-all; font-variant-numeric: tabular-nums; }
