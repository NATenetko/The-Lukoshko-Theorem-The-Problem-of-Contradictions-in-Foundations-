</head>
<body>
    <div class="container">
        <div class="title-row">
            <h1>Бинарные последовательности</h1>
            <span class="title-btns">
                <label class="len-fuse" title="Предохранитель длины ввода/материализации. Числа считаются за O(N) без предела — поднимайте без ограничения; рендер всегда режется срезом.">предел длины <input type="number" id="computeLenInput" class="cond-num" min="1"></label>
                <button class="btn btn-secondary plugin-open-btn" id="workspaceOpenBtn" title="Рабочая область: открыть плагины как инструменты">🎛 Рабочая область</button>
                <button class="btn btn-secondary plugin-open-btn" id="pluginOpenBtn" title="Загрузить/снять плагины">🧩 Плагины <span class="plugin-count" id="pluginCountBadge">0</span></button>
            </span>
        </div>
        <p class="subtitle">
            Класс = длина &middot; Позиция = десятичное значение + 1 &middot;
            <code>O(N)</code> вместо <code>O(2<sup>N</sup>)</code>
        </p>

        <div class="input-section">
            <div class="input-group">
                <label>Введите последовательность</label>
                <div class="lang-row">
                    <select id="inputLang" class="lang-sel" title="Как читать введённое"></select>
                    <span id="langOpts"></span>
                </div>
                <div class="input-row">
                    <input type="text" id="sequenceInput" placeholder="например: 101" value="101" autocomplete="off" spellcheck="false">
                    <button class="btn" id="generateBtn">СГЕНЕРИРОВАТЬ</button>
                </div>
                <div class="expr-out" id="exprOut"></div>
                <div class="error-msg" id="errorMsg"></div>
            </div>
        </div>

        <div class="info-panel" id="infoPanel">
            <div class="info-card">
                <div class="info-label">Класс (длина)</div>
                <div class="info-value class-name" id="className">000</div>
            </div>
            <div class="info-card">
                <div class="info-label">Всего вариантов</div>
                <div class="info-value total" id="totalVariants">8</div>
            </div>
            <div class="info-card highlight">
                <div class="info-label">Ваша позиция</div>
                <div class="info-value position" id="position">6 / 8</div>
            </div>
            <div class="info-card">
                <div class="info-label">Диапазон класса</div>
                <div class="info-value range" id="classRange">000 – 111</div>
            </div>
        </div>

        <div class="panel repr-panel">
            <div class="panel-header">
                <span class="panel-title-group">
                    <span class="panel-title">Представления</span>
                </span>
                <span class="panel-badge" id="reprBadge">—</span>
            </div>
            <div class="repr-body" id="reprBody"></div>
        </div>

        <div class="tables-grid">
            <!-- ─── ЛЕВАЯ ПАНЕЛЬ: ПУТЬ O(N) ─── -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Путь</span>
                    <span class="panel-badge" id="pathBadge">O(3)</span>
                </div>
                <div class="panel-body path-scroll" id="pathScroller">
                    <table>
                        <thead>
                            <tr>
                                <th>Шаг</th>
                                <th>Префикс</th>
                                <th>Класс</th>
                                <th>Диапазон</th>
                                <th>Позиция</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="pathBody"></tbody>
                    </table>
                </div>
                <div class="panel-footer" id="pathFooter"></div>
            </div>

            <!-- ─── ПРАВАЯ ПАНЕЛЬ: ВСЕ ВАРИАНТЫ ─── -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title-group">
                        <span class="panel-title">Все варианты класса</span>
                        <button class="jump-btn" id="stepUpBtn" title="На один вариант вверх (↑)">↑</button>
                        <button class="jump-btn" id="stepDownBtn" title="На один вариант вниз (↓)">↓</button>
                        <button class="jump-btn" id="jumpBtn" title="Вернуться к текущей позиции">↟</button>
                        <button class="jump-btn" id="backBtn" disabled title="Назад по истории">↩</button>
                    </span>
                    <span class="panel-badge" id="fullBadge">2<sup>3</sup></span>
                </div>
                <div class="panel-body full-viewport" id="fullViewport">
                    <div class="full-table-wrap">
                        <div class="full-header-row">
                            <div class="full-cell">№</div>
                            <div class="full-cell">Последовательность</div>
                            <div class="full-cell">Визуально</div>
                            <div class="full-cell"></div>
                        </div>
                        <div class="full-body">
                            <div class="full-content" id="fullContent">
                                <div class="full-visible" id="fullVisible"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer" id="fullFooter"></div>
            </div>
        </div>

        <div class="panel struct-panel">
            <div class="panel-header">
                <span class="panel-title-group">
                    <span class="panel-title">Структура</span>
                </span>
