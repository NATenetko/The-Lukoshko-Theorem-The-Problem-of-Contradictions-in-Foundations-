            border-radius: 8px; padding: 6px 7px 7px; background: rgba(88,166,255,0.03); }
        .cond-group.op-or { border-left-color: var(--purple); background: rgba(163,113,247,0.045); }
        .cond-group.root { border: none; border-left: none; padding: 0; background: none; }
        .cond-group-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 0 2px 6px; }
        .cond-group.root > .cond-group-head { padding-bottom: 4px; }
        .cond-kids { display: flex; flex-direction: column; gap: 6px; padding-left: 12px; }
        .cond-group.root > .cond-kids { padding-left: 0; }
        .op-toggle { cursor: pointer; font-size: 0.72rem; font-weight: 600; letter-spacing: 1px;
            padding: 3px 11px; border-radius: 20px; border: 1px solid var(--accent);
            background: rgba(88,166,255,0.12); color: var(--accent); font-family: inherit; }
        .op-toggle:hover { background: rgba(88,166,255,0.26); }
        .cond-group.op-or > .cond-group-head > .op-toggle { border-color: var(--purple);
            background: rgba(163,113,247,0.14); color: var(--purple); }
        .cond-group.op-or > .cond-group-head > .op-toggle:hover { background: rgba(163,113,247,0.28); }
        .cond-letter { font-family: 'SF Mono', Monaco, monospace; font-size: 0.76rem; font-weight: 600;
            color: var(--purple); min-width: 1.1em; }
        .grp-size { font-size: 0.7rem; color: var(--text-secondary); font-family: 'SF Mono', Monaco, monospace;
            white-space: nowrap; opacity: .85; }
        .cond-formula { font-family: 'SF Mono', Monaco, monospace; font-size: 0.82rem;
            color: var(--accent); word-break: break-word; line-height: 1.5; }
        .cond-legend { font-size: 0.72rem; color: var(--text-secondary); line-height: 1.6; word-break: break-word; }
        .cond-legend b { color: var(--purple); font-family: 'SF Mono', Monaco, monospace; font-weight: 600; }
        .search-run { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .search-run .btn { padding: 8px 18px; font-size: 0.85rem; }
        .search-expr { font-size: 0.78rem; color: var(--text); word-break: break-word; flex: 1; min-width: 0; }
        .expr-tech { font-family: 'SF Mono', Monaco, monospace; font-size: 0.72rem;
            color: var(--text-secondary); opacity: .7; margin-left: 8px; word-break: break-all; }
        .canvas-wrap { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); padding: 6px; }
        #searchCanvas { display: block; width: 100%; }
        .search-nums { font-family: 'SF Mono', Monaco, monospace; font-size: 0.76rem;
            color: var(--text-secondary); word-break: break-all; line-height: 1.6; }
        .search-rec { font-family: 'SF Mono', Monaco, monospace; font-size: 0.84rem; color: var(--green);
            background: rgba(63,185,80,0.08); border: 1px solid var(--border); border-radius: 8px; padding: 7px 11px; }
        .search-stats { font-family: 'SF Mono', Monaco, monospace; font-size: 0.78rem; color: var(--text-secondary);
            margin-top: 6px; padding: 0 2px; }
        #searchClasses { max-height: 240px; overflow-y: auto; padding-right: 3px; }
        #searchClasses::-webkit-scrollbar { width: 6px; }
        #searchClasses::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
        .cls-row { cursor: pointer; }
        .cls-row:hover { background: rgba(88,166,255,0.12); }
        .cls-row.sel { background: rgba(88,166,255,0.18); }
        .cls-ex { font-family: 'SF Mono', Monaco, monospace; color: var(--accent); }
        .match-controls { display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
            font-size: 0.75rem; color: var(--text-secondary); }
        .match-list { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
        .match-list .full-row { cursor: pointer; }
        .match-list .full-row:first-child { border-top: none; }
        .match-list .full-row .seq-long { word-break: break-all; letter-spacing: 1px; }
        .search-empty { color: var(--text-secondary); font-size: 0.8rem; padding: 12px; text-align: center; }

        /* ── ПРАВИЛО (подстановки) ── */
        .rule-panel { margin-top: 16px; }
        #ruleLevelsBox { max-height: 240px; overflow-y: auto; padding-right: 3px; }
        #ruleLevelsBox::-webkit-scrollbar { width: 6px; }
        #ruleLevelsBox::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
        .lvl-row { cursor: pointer; }
        .lvl-row:hover { background: rgba(88,166,255,0.12); }
        .lvl-row.sel { background: rgba(88,166,255,0.18); }
        .lvl-row .lvl-numonly { color: var(--text-secondary); }
        .rule-word { font-family: 'SF Mono', Monaco, monospace; font-size: 0.82rem; letter-spacing: 1px;
            word-break: break-all; line-height: 1.7; color: var(--accent); background: var(--bg);
            border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; min-height: 22px; }
        .rule-word .binary-dots { margin-top: 6px; }

        @media (max-width: 800px) {
            .cond-lit { width: 92px; }
            .search-run { flex-direction: column; align-items: stretch; }
            .cond-tail { margin-left: 0; }
            .cond-kids { padding-left: 6px; }
            .cond-group { padding: 5px 4px 6px; }
            .tables-grid {
                grid-template-columns: 1fr;
            }
            .container { padding: 16px 18px 20px; }
            .info-panel { grid-template-columns: 1fr 1fr; }
            .input-section { flex-direction: column; }
            .btn { width: 100%; }
            .nav-buttons { flex-direction: column; }
            .full-row,
            .full-header-row {
                grid-template-columns: 38px 1fr auto 72px;
                padding: 7px 10px;
                font-size: 0.75rem;
            }
            .full-row.current-row { padding-left: 7px; }
            .path-scroll td,
            .path-scroll th { padding: 7px 10px; font-size: 0.75rem; }
        }

        /* ─── Меры (плагины) ─── */
        .measure-metric {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--accent);
            margin: 4px 0 10px;
            word-break: break-all;
            line-height: 1.25;
        }
        .measure-rows {
            display: grid;
            grid-template-columns: max-content 1fr;
            gap: 5px 16px;
            font-size: 0.85rem;
        }
        .measure-rows .mk { color: var(--text-secondary); white-space: nowrap; }
        .measure-rows .mv { color: var(--text); font-variant-numeric: tabular-nums; word-break: break-all; }

        /* ─── Плагины: кнопка и окно ─── */
        .title-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .title-btns { display: inline-flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .len-fuse { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--text-dim, #8b949e); white-space: nowrap; }
        .len-fuse .cond-num { width: 88px; }
        .plugin-open-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 0.85rem; padding: 8px 14px; }
        .plugin-count {
            background: var(--accent-glow); color: #fff; border-radius: 10px;
            padding: 1px 8px; font-size: 0.75rem; font-weight: 700; min-width: 20px; text-align: center;
        }
        .plugin-overlay {
            position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-start; justify-content: center;
            padding: 4vh 12px; background: rgba(1,4,9,0.72); overflow-y: auto;
        }
        .plugin-overlay[hidden] { display: none; }
        .plugin-modal {
            background: var(--surface); color: var(--text); border: 1px solid var(--border);
            border-radius: 14px; padding: 22px 24px; width: min(620px, 96vw); margin: auto;
            box-shadow: 0 20px 80px rgba(0,0,0,0.6); font-family: inherit;
        }
        .plugin-dialog-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .plugin-diag { font-size: 0.76rem; color: var(--text-secondary); margin: 4px 0 8px; }
        .plugin-hint { font-size: 0.78rem; color: var(--text-secondary); margin: 4px 0 8px; line-height: 1.45; }
        .plugin-tag-ok, .plugin-tag-warn { font-size: 0.68rem; font-weight: 700; padding: 1px 7px; border-radius: 8px; letter-spacing: 0.5px; text-transform: none; margin-left: 6px; }
        .plugin-tag-ok { background: rgba(63,185,80,0.16); color: var(--green); }
        .plugin-tag-warn { background: rgba(210,153,29,0.16); color: var(--orange); }
        .plugin-drop {
            border: 1.5px dashed var(--border); border-radius: 12px; padding: 18px; text-align: center;
            margin: 14px 0; transition: border-color 0.15s, background 0.15s;
        }
        .plugin-drop.drag { border-color: var(--accent); background: rgba(88,166,255,0.07); }
        .plugin-drop-hint { color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 12px; }
        .plugin-pick-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .plugin-pick { cursor: pointer; font-size: 0.85rem; }
        .plugin-status { font-size: 0.82rem; line-height: 1.5; margin: 6px 0; white-space: pre-wrap; }
        .plugin-status .ok { color: var(--green); }
        .plugin-status .warn { color: var(--orange); }
        .plugin-status .err { color: var(--red); }
        .plugin-list-head { display: flex; align-items: center; justify-content: space-between; margin: 14px 0 6px; }
        .plugin-list { display: flex; flex-direction: column; gap: 6px; }
        .plugin-item {
            display: flex; align-items: center; gap: 10px; padding: 8px 12px;
