        .ws-panel-head .wsk { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 1px; color: var(--purple); }
        .ws-panel-head .wsid { font-weight: 600; }
        .ws-panel-head .wslabel { color: var(--text-secondary); font-size: 0.8rem; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ws-panel-head .wsclose { background: none; border: 1px solid var(--border); color: var(--red); cursor: pointer; border-radius: 6px; width: 26px; height: 26px; font-size: 1.05rem; line-height: 1; }
