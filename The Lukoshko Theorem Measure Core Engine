        .ws-chip:hover { border-color: var(--accent); background: rgba(88,166,255,0.08); }
        .ws-chip .ws-chip-kind { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 1px; color: var(--purple); }
        .ws-chip .ws-chip-id { font-weight: 600; }
        .ws-palette-group-label { width: 100%; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-secondary); margin-top: 4px; }
        .ws-panels {
            flex: 1; overflow: auto; padding: 18px;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; align-content: start;
        }
        .ws-empty { color: var(--text-secondary); font-size: 0.9rem; grid-column: 1/-1; text-align: center; padding: 40px 0; }
        .ws-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; }
