        }
        .plugin-item .pk { color: var(--purple); font-weight: 600; white-space: nowrap; }
        .plugin-item .pid { color: var(--text); font-weight: 600; }
        .plugin-item .plabel { color: var(--text-secondary); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .plugin-item .pbuiltin { color: var(--text-secondary); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; }
        .plugin-item .premove {
            background: none; border: 1px solid var(--border); color: var(--red); cursor: pointer;
            border-radius: 6px; width: 24px; height: 24px; font-size: 1rem; line-height: 1;
        }
        .plugin-item .premove:hover { background: rgba(248,81,73,0.12); border-color: var(--red); }
        .plugin-item .premove:disabled { color: var(--text-secondary); cursor: default; opacity: 0.5; }
        .plugin-empty { color: var(--text-secondary); font-size: 0.82rem; padding: 6px 2px; }
        .plugin-sec { margin: 14px 0; padding-top: 12px; border-top: 1px solid var(--border); }
        .plugin-sec:first-of-type { border-top: none; padding-top: 0; }
        .plugin-folder-row { display: flex; gap: 8px; align-items: center; margin: 8px 0; flex-wrap: wrap; }
