        // ─── СОСТОЯНИЕ ───
        let currentSequence = '101';
        let historyStack = [];
        let historyIdx = -1;

        // ─── Пределы: COMPUTE-порог РАЗВЯЗАН с RENDER-защитами ───
        // Ядро точно на любой длине (BigInt, O(N)); длина упиралась лишь в «колпак показа».
        //   computeLen      — ЖИВОЙ предел длины ВВОДА/материализации (см. ниже): высокий дефолт,
        //                     поднимается пользователем БЕЗ верхней границы. Гейтит только ВВОД и
        //                     выписывание строк; числа считаются всегда. core-only state —
        //                     плагину виден лишь на чтение через Engine.limits.
        //   RULE_LEVELS_CAP — предохранитель числа уровней L-системы: числа уровней растут
        //                     экспоненциально (BigInt), память ~O(K²) бит — это реальная цена,
        //                     а не колпак показа. Рендер уровней при этом режется срезом.
        //   SEARCH_LEN_CAP  — предел числа классов в ПОИСКЕ: patCountAll это O(nMax·|Q|), а выбор
        //                     класса строит суффикс-таблицу O(N·|Q|) — её сторожит PATSUFFIX_CELL_BUDGET.
        //   RENDER_PATH_CAP — сколько строк рисует панель пути (дальше срез «первые/последние»).
        //   DOTS_CAP        — докуда рисуем кружочки по-битно; длиннее — сводка (снимает O(N²)).
        //   SOFT_HINT_LEN   — с этой длины показываем ненавязчивый намёк о стоимости.
        const RULE_LEVELS_CAP = 8192;
        const SEARCH_LEN_CAP = 4096;
        const RENDER_PATH_CAP = 256;
        const DOTS_CAP = 64;
        const SOFT_HINT_LEN = 512;
        const PATSUFFIX_CELL_BUDGET = 6_000_000;   // (N+1)·|Q| ячеек-BigInt: выше — честный отказ

        // computeLen — динамический предохранитель длины. Дефолт высокий, чтобы масштаб ничего
        // не сдерживал; поле в шапке поднимает его без предела. Значение живёт в localStorage.
        const COMPUTE_LEN_DEFAULT = 1 << 20;   // 1 048 576 бит
        const COMPUTE_LEN_KEY = 'matrix.computeLen';
        function loadComputeLen() {
            try {
                const v = parseInt(localStorage.getItem(COMPUTE_LEN_KEY), 10);
                if (Number.isInteger(v) && v >= 1) return v;
            } catch (e) {}
            return COMPUTE_LEN_DEFAULT;
        }
        let computeLen = loadComputeLen();
        function setComputeLen(v) {
            v = Math.floor(Number(v));
            if (!Number.isFinite(v) || v < 1) return computeLen;   // нижняя граница 1, верхней нет
            computeLen = v;
            try { localStorage.setItem(COMPUTE_LEN_KEY, String(v)); } catch (e) {}
            return computeLen;
        }

        // Поле «предел длины» в шапке: поднимает/опускает computeLen без верхней границы.
        const computeLenInput = document.getElementById('computeLenInput');
        if (computeLenInput) {
            computeLenInput.value = computeLen;
            computeLenInput.addEventListener('change', () => {
                const v = setComputeLen(computeLenInput.value);
                computeLenInput.value = v;
                if (typeof validateLive === 'function') validateLive();
            });
        }

        // ─── УТИЛИТЫ ───
        function repeatChar(ch, n) {
            let s = '';
            for (let i = 0; i < n; i++) s += ch;
            return s;
        }

        function padBinStr(i, len) {
            let s = (typeof i === 'bigint' ? i : BigInt(i)).toString(2);
            while (s.length < len) s = '0' + s;
            return s;
        }

        function seqProps(seq) {
            const len = seq.length;
            // dec и total — точные BigInt: работают на любой длине без потери точности.
            // dec = сама строка как двоичное число; total = 2^len (сдвиг). Обе операции O(N),
            // множество 2^N нигде не материализуется.
            return { len, dec: BigInt('0b' + seq), total: 1n << BigInt(len) };
        }

        function fmtNum(n) {
            return n.toLocaleString();
        }

        // ─── Компактный вид больших чисел (без «экспонентов» e+N в интерфейсе) ───
        // Точные степени двойки — как 2^k; прочие большие числа — «≈D цифр» (D оценивается по
        // битовой длине, БЕЗ выписывания числа), точное — в тултип, если оно обозримо. Мелкие
        // числа — целиком с разделителями. Это держит DOM ограниченным на любой длине.
        function bitLenBig(b) { return b <= 0n ? 0 : b.toString(2).length; }
        function digitsFromBits(bits) { return bits <= 0 ? 1 : Math.floor(bits * 0.3010299956639812) + 1; }
        function pow2Html(k) { return `2<sup>${k}</sup>`; }   // «всего вариантов» = 2^N без выписывания
        // → { text, title }. exactBits (если задан) — заранее известная битовая длина, чтобы не
        //   звать toString(2) на огромном числе (напр. для позиции в пути/инфо).
        function fmtScale(b, exactBits) {
            const neg = b < 0n, abs = neg ? -b : b;
            if (abs <= 999999999999999n) { const s = fmtNum(b); return { text: s, title: s }; }
            const bits = (exactBits != null) ? exactBits : bitLenBig(abs);
            const dtxt = digitsFromBits(bits).toLocaleString();
            const title = digitsFromBits(bits) <= 120 ? (neg ? '-' : '') + abs.toString() : `${dtxt} десятичных разрядов`;
            return { text: `≈${dtxt} цифр`, title };
        }

        // ─── BigInt-хелперы (min/max/clamp работают и для BigInt, и для Number) ───
        function bmax(a, b) { return a > b ? a : b; }
        function bmin(a, b) { return a < b ? a : b; }
        function bclamp(x, lo, hi) { return x < lo ? lo : (x > hi ? hi : x); }

        // ═══════════════════════════════════════════════════════════════════
        // СЛОЙ ПРЕДСТАВЛЕНИЙ — объект ↔ двоичная структура
        // Живёт строго ДО processSequence (интерпретация) и строго ПОСЛЕ него
        // (представление). Ядро — patCountAll/patSuffix/patUnrank/findRecurrence,
        // меры S−V, L-системы, дерево условий — о нём не знает вовсе: оно как
        // получало двоичную строку, так и получает.
        // Добавить завтра base64, IP-адрес, MIDI = одна запись в INTERPRETERS.
        // ═══════════════════════════════════════════════════════════════════

        // ─── Теоретико-числовые признаки ───
        // Все, кроме простоты и разложения, ТОЧНЫ на любой длине: они сводятся
        // к целочисленному корню, а он на BigInt точен всегда.
        function isqrt(n) {
            if (n < 0n) return null;
            if (n < 2n) return n;
            let x = 1n << BigInt((n.toString(2).length + 1) >> 1), y = (x + n / x) >> 1n;
            while (y < x) { x = y; y = (x + n / x) >> 1n; }
            return x;
        }
        const isSquare = n => { if (n < 0n) return false; const r = isqrt(n); return r * r === n; };
        const isPow2 = n => n > 0n && (n & (n - 1n)) === 0n;
        // n — Фибоначчи ⟺ 5n²+4 или 5n²−4 полный квадрат. Именно n², не n:
        // «5n*n» дало бы 5·n и признак сломался бы на всех входах.
        const isFib = n => { if (n < 0n) return false; const q = 5n * (n * n); return isSquare(q + 4n) || isSquare(q - 4n); };
        const isTri = n => n >= 0n && isSquare(8n * n + 1n);

        function mpow(b, e, m) { let r = 1n; b %= m; while (e > 0n) { if (e & 1n) r = r * b % m; b = b * b % m; e >>= 1n; } return r; }
        const MR_BASES = [2n, 3n, 5n, 7n, 11n, 13n, 17n, 19n, 23n, 29n, 31n, 37n];
        // На этих 12 основаниях Миллер–Рабин ДОКАЗЫВАЕТ простоту ниже границы;
        // выше — сильное свидетельство, и так и надо писать в интерфейсе.
        const MR_DET_MAX = 3317044064679887385961981n;
        function isPrime(n) {
            if (n < 2n) return false;
            for (const p of MR_BASES) { if (n === p) return true; if (n % p === 0n) return false; }
            let d = n - 1n, r = 0n;
            while ((d & 1n) === 0n) { d >>= 1n; r++; }
            for (const a of MR_BASES) {
                let x = mpow(a, d, n);
                if (x === 1n || x === n - 1n) continue;
                let ok = false;
                for (let i = 1n; i < r; i++) { x = x * x % n; if (x === n - 1n) { ok = true; break; } }
                if (!ok) return false;
            }
            return true;
        }
        // Единственное место с настоящей математической границей. Возвращаем ещё и
        // остаток: молчаливое «разложение не найдено» хуже честного «вот остаток».
        const FACTOR_STEPS = 300000;
        function factorize(n, steps) {
            steps = steps || FACTOR_STEPS;
            const f = [];
            if (n < 2n) return { f, rest: n, exhausted: false };
            let d = 2n, c = 0;
            while (d * d <= n && c < steps) { if (n % d === 0n) { let e = 0; while (n % d === 0n) { n /= d; e++; } f.push([d, e]); } d += d === 2n ? 1n : 2n; c++; }
            return { f, rest: n, exhausted: c >= steps && d * d <= n };
        }
        function factorText(n) {
            if (n < 2n) return String(n);
            const r = factorize(n);
            const parts = r.f.map(([p, e]) => p + (e > 1 ? '^' + e : ''));
            if (r.rest > 1n) {
                if (!r.exhausted) parts.push(String(r.rest));
                else if (isPrime(r.rest)) parts.push(`[${r.rest} — простое по Миллеру–Рабину]`);
                else parts.push(`[остаток ${String(r.rest).length} цифр — составной, множители за пределом проверки]`);
            }
            return parts.join(' · ');
        }

        // ─── Разбор выражения: рекурсивный спуск на BigInt ───
        // Тот же приём и тот же формат ошибок {msg,pos}, что у patParse ниже.
        // base — основание ГОЛОГО литерала; префиксы 0b/0x/0d перекрывают его всегда.
        function exprEval(s, base) {
            let i = 0;
            const err = (m, p) => { throw { msg: m, pos: p === undefined ? i : p }; };
            const ws = () => { while (i < s.length && /\s/.test(s[i])) i++; };
            const peek = () => { ws(); return s[i]; };
            const word = w => { ws(); if (s.slice(i, i + w.length).toUpperCase() === w && !/[A-Za-zА-Яа-я]/.test(s[i + w.length] || '')) { i += w.length; return true; } return false; };
            const lit2 = t => { ws(); if (s.startsWith(t, i)) { i += t.length; return true; } return false; };

            function expr() { let n = xorx(); while (word('OR')) n = n | xorx(); return n; }
            function xorx() { let n = andx(); while (word('XOR')) n = n ^ andx(); return n; }
            function andx() { let n = shift(); while (word('AND')) n = n & shift(); return n; }
            function shift() {
                let n = add();
                for (;;) {
                    if (lit2('<<')) { const k = add(); if (k < 0n || k > 4096n) err('сдвиг вне разумного диапазона'); n = n << k; }
                    else if (lit2('>>')) { const k = add(); if (k < 0n || k > 4096n) err('сдвиг вне разумного диапазона'); n = n >> k; }
                    else return n;
                }
            }
            function add() { let n = mul(); for (;;) { const c = peek(); if (c === '+') { i++; n = n + mul(); } else if (c === '-') { i++; n = n - mul(); } else return n; } }
            function mul() {
                let n = unary();
                for (;;) {
                    const c = peek();
                    if (c === '*' && s[i + 1] !== '*') { i++; n = n * unary(); }
                    else if (c === '/') { i++; const d = unary(); if (d === 0n) err('деление на ноль'); if (n % d !== 0n) err(`${n} / ${d} не нацело — в целых числах результата нет`); n = n / d; }
                    else if (c === '%') { i++; const d = unary(); if (d === 0n) err('остаток по нулю'); n = n % d; }
                    else return n;
                }
            }
            function unary() { if (peek() === '-') { i++; return -unary(); } return power(); }
            function power() {
                const b = atom(); ws();
                if (s[i] === '^' || s.startsWith('**', i)) {
                    i += s[i] === '^' ? 1 : 2;
                    const e = unary();
                    if (e < 0n) err('отрицательная степень — в целых числах результата нет');
                    if (e > 20000n) err('показатель слишком велик');
                    return b ** e;
                }
                return b;
            }
            function atom() {
                ws();
                if (s[i] === '(') { i++; const n = expr(); ws(); if (s[i] !== ')') err('не закрыта скобка'); i++; return n; }
                const st = i;
                if (s[i] === '0' && /[bxd]/i.test(s[i + 1] || '')) {
                    const k = s[i + 1].toLowerCase(); i += 2; const d0 = i;
                    const re = k === 'b' ? /[01]/ : k === 'x' ? /[0-9a-fA-F]/ : /[0-9]/;
                    while (i < s.length && re.test(s[i])) i++;
                    if (i === d0) err(`после 0${k} нет цифр`, st);
                    return BigInt((k === 'b' ? '0b' : k === 'x' ? '0x' : '') + s.slice(d0, i));
                }
                while (i < s.length && /[0-9]/.test(s[i])) i++;
                if (i === st) err('ожидалось число', st);
                const lit = s.slice(st, i);
                if (base === 2) {
                    if (!/^[01]+$/.test(lit)) err(`литерал «${lit}»: в этом языке только 0 и 1 — используйте префикс 0d или язык «число»`, st);
                    return BigInt('0b' + lit);
                }
                return BigInt(lit);
            }
            if (!s.trim()) err('пусто', 0);
            const value = expr();
            let rhs = null;
            ws();
            if (s[i] === '=') { i++; ws(); if (i < s.length) rhs = expr(); }
            ws();
            if (i < s.length) err(`лишний символ «${s[i]}»`);
            return { value, rhs };
        }

        // ─── Кодеки ───
        const _te = new TextEncoder(), _td = new TextDecoder('utf-8', { fatal: true });
        const bytesToBits = b => [...b].map(x => x.toString(2).padStart(8, '0')).join('');
        const bitsToBytes = s => { const o = []; for (let i = 0; i < s.length; i += 8) o.push(parseInt(s.slice(i, i + 8), 2)); return Uint8Array.from(o); };

        const NUC = { dna: { A: '00', C: '01', G: '10', T: '11' }, rna: { A: '00', C: '01', G: '10', U: '11' } };

        function alphaWidth(A) { return Math.max(1, Math.ceil(Math.log2(A.length))); }

        // ─── РЕЕСТР ИНТЕРПРЕТАТОРОВ ───
        // Контракт: decode(значение, opts) → {bits}|{err}; encode(биты, opts) → {text,extra}|{err}.
        // Инвариант encode(decode(x)) === x проверяется самопроверкой для ВСЕХ записей разом.
        const INTERPRETERS = {
            bin: {
                label: 'двоичная строка', ph: 'например: 101', unit: n => `${n} бит`,
                decode: v => /^[01]+$/.test(v) ? { bits: v } : { err: 'только 0 и 1' },
                encode: b => ({ text: b })
            },
            num: {
                label: 'число / выражение', ph: 'например: 3+5  ·  2^10-1  ·  0b1010 AND 0b1100',
                unit: n => `число до ${n} бит`,
                decode: v => {
                    let r;
                    try { r = exprEval(v, 10); } catch (e) { return { err: e && e.msg ? e.msg : String(e && e.message || e) }; }
                    if (r.value < 0n) return { err: `результат ${r.value} отрицательный — двоичной строки нет` };
                    const bits = r.value.toString(2);
                    let note = `${r.value} → ${bits}`;
                    if (r.rhs !== null) note = r.value === r.rhs ? `верно: обе части равны ${r.value} → ${bits}`
                        : `неверно: слева ${r.value}, справа ${r.rhs} · загружена левая часть → ${bits}`;
                    return { bits, note };
                },
                encode: b => {
                    const n = BigInt('0b' + b);
                    const ones = (b.match(/1/g) || []).length;
                    const props = [];
                    if (n % 2n === 0n) props.push('чётное'); else props.push('нечётное');
                    if (isPow2(n)) props.push('степень двойки');
                    if (isSquare(n)) props.push('полный квадрат');
                    if (isFib(n)) props.push('число Фибоначчи');
                    if (isTri(n)) props.push('треугольное');
                    if (n >= 2n) props.push(isPrime(n) ? (n < MR_DET_MAX ? 'простое' : 'вероятно простое (Миллер–Рабин)') : 'составное');
                    return {
                        text: String(n),
                        extra: [
                            ['шестнадцатеричное', '0x' + n.toString(16).toUpperCase()],
                            ['бит / единиц / нулей', `${b.length} / ${ones} / ${b.length - ones}`],
                            ['свойства', props.join(' · ')]
                        ]
                    };
                }
            },
            text: {
                label: 'текст UTF-8', ph: 'например: Hi!  ·  привет', unit: n => `${Math.floor(n / 8)} байт`,
                decode: v => v ? { bits: bytesToBits(_te.encode(v)) } : { err: 'пусто' },
                encode: b => {
                    if (b.length % 8) return { err: `${b.length} бит не кратно 8 — не целое число байт` };
                    try { return { text: _td.decode(bitsToBytes(b)) }; }
                    catch (e) { return { err: 'байты не складываются в корректный UTF-8' }; }
                }
            },
            dna: {
                label: 'ДНК / РНК', ph: 'например: GATTACA', unit: n => `${Math.floor(n / 2)} нуклеотидов`,
                opt: { k: 'nuc', values: [['dna', 'ДНК (A C G T)'], ['rna', 'РНК (A C G U)']] },
                decode: (v, o) => {
                    const m = NUC[(o && o.nuc) || 'dna'], names = Object.keys(m).join('');
                    if (!v) return { err: 'пусто' };
                    const out = [];
                    for (const ch of v.toUpperCase()) { if (!(ch in m)) return { err: `символ «${ch}» не из алфавита ${names}` }; out.push(m[ch]); }
                    return { bits: out.join('') };
                },
                encode: (b, o) => {
                    if (b.length % 2) return { err: `${b.length} бит нечётно — не целое число нуклеотидов` };
                    const m = NUC[(o && o.nuc) || 'dna'];
                    const inv = Object.fromEntries(Object.entries(m).map(([k, v]) => [v, k]));
                    let t = '';
                    for (let i = 0; i < b.length; i += 2) t += inv[b.slice(i, i + 2)];
                    return { text: t, extra: [['таблица', Object.entries(m).map(([k, v]) => k + '=' + v).join('  ')]] };
                }
            },
            alpha: {
                label: 'свой алфавит', ph: 'например: ABCABBA',
                opt: { k: 'A', ph: 'ABC', lab: 'алфавит' },
                unit: null,
                decode: (v, o) => {
                    const A = (o && o.A) || '';
                    if (A.length < 2) return { err: 'задайте алфавит хотя бы из двух символов' };
                    if (new Set(A).size !== A.length) return { err: 'в алфавите повторяются символы' };
                    if (!v) return { err: 'пусто' };
                    const k = alphaWidth(A), out = [];
                    for (const ch of v) { const idx = A.indexOf(ch); if (idx < 0) return { err: `символ «${ch}» не в алфавите «${A}»` }; out.push(idx.toString(2).padStart(k, '0')); }
                    return { bits: out.join('') };
                },
                encode: (b, o) => {
                    const A = (o && o.A) || '';
                    if (A.length < 2) return { err: 'алфавит не задан' };
                    const k = alphaWidth(A);
                    if (b.length % k) return { err: `${b.length} бит не кратно ${k} — алфавит «${A}» кодируется по ${k} бит на символ` };
                    let t = '';
                    for (let i = 0; i < b.length; i += k) {
                        const v = parseInt(b.slice(i, i + k), 2);
                        // Неотображённый код называем явно, а не подменяем ближайшим символом.
                        if (v >= A.length) return { err: `код ${b.slice(i, i + k)} не отображён: в алфавите «${A}» ${A.length} символов на ${1 << k} кодов` };
                        t += A[v];
                    }
                    const spare = (1 << k) - A.length;
                    return { text: t, extra: [['ширина', `${k} бит на символ` + (spare ? `, ${spare} код(ов) не отображено` : ', ровно степень двойки')]] };
                }
            }
        };

        // Показать точное (возможно очень длинное) число: при длинной строке уменьшаем
        // шрифт и разрешаем перенос, чтобы 60-значное значение не ломало карточку.
        function setBigValue(el, str) {
            el.textContent = str;
            const long = str.length > 14;
            el.style.fontSize = long ? '0.85rem' : '';
            el.style.wordBreak = long ? 'break-all' : '';
            el.style.lineHeight = long ? '1.3' : '';
        }

        function isValid(str) {
            return /^[01]+$/.test(str);
        }

        function validateInput(value) {
            if (!value) {
                sequenceInput.classList.remove('valid', 'invalid');
                errorMsg.textContent = '';
                return false;
            }
            if (!isValid(value)) {
                sequenceInput.classList.add('invalid');
                sequenceInput.classList.remove('valid');
                errorMsg.textContent = 'Только 0 и 1!';
                return false;
            }
            sequenceInput.classList.add('valid');
            sequenceInput.classList.remove('invalid');
            errorMsg.textContent = '';
            return true;
        }

        // ═══ ИНТЕРФЕЙС СЛОЯ ПРЕДСТАВЛЕНИЙ ═══

        let curLang = 'bin';
        let langOpts = { nuc: 'dna', A: 'ABC' };

        function renderLangSelect() {
            inputLang.innerHTML = Object.entries(INTERPRETERS)
                .map(([k, v]) => `<option value="${k}"${k === curLang ? ' selected' : ''}>${esc(v.label)}</option>`).join('');
        }

        function renderLangOpts() {
            const I = INTERPRETERS[curLang], o = I.opt;
            sequenceInput.placeholder = I.ph;
            if (!o) { langOptsEl.innerHTML = ''; return; }
            if (o.values) {
                langOptsEl.innerHTML = `<select data-opt="${o.k}">` + o.values
                    .map(([v, lab]) => `<option value="${v}"${langOpts[o.k] === v ? ' selected' : ''}>${esc(lab)}</option>`).join('') + '</select>';
            } else {
                langOptsEl.innerHTML = `<span class="cond-lab">${esc(o.lab || '')}</span>` +
                    `<input type="text" data-opt="${o.k}" placeholder="${esc(o.ph || '')}" value="${esc(langOpts[o.k] || '')}">`;
            }
        }

        // Объект на выбранном языке → биты. Предел показа сообщается в единицах
        // ЭТОГО языка: «25 символов» понятнее, чем «200 бит».
        function resolveInput(raw) {
            const I = INTERPRETERS[curLang];
            const r = I.decode(raw, langOpts);
            if (r.err) return { err: r.err };
            if (!r.bits) return { err: 'пусто' };
            if (r.bits.length > computeLen) {
                const u = I.unit ? I.unit(computeLen) : `${computeLen} бит`;
                return { err: `${r.bits.length} бит — предел ${computeLen} (это ${u}); поднимите «предел длины» в шапке` };
            }
            return { bits: r.bits, note: r.note };
        }

        // Живая подсказка при наборе: показывает, ВО ЧТО превратится ввод, ещё до нажатия.
        function validateLive() {
            const v = sequenceInput.value.trim();
            if (!v) {
                sequenceInput.classList.remove('valid', 'invalid');
                errorMsg.textContent = ''; exprOut.textContent = '';
                return;
            }
            const r = resolveInput(v);
            if (r.err) {
                sequenceInput.classList.add('invalid');
                sequenceInput.classList.remove('valid');
                errorMsg.textContent = r.err;
                exprOut.textContent = '';
            } else {
                sequenceInput.classList.add('valid');
                sequenceInput.classList.remove('invalid');
                // Ненавязчивый намёк о стоимости: ядро дёшево, но панель пути и рендер
                // растут — честно предупреждаем, не блокируя. Это «стена в динамике».
                const hint = r.bits.length > SOFT_HINT_LEN
                    ? ` · ${r.bits.length} бит — тяжёлый рендер, путь показывается срезом`
                    : '';
                errorMsg.textContent = '';
                exprOut.textContent = (r.note || (curLang === 'bin' ? '' : `→ ${r.bits}`)) + hint;
                exprOut.classList.toggle('warn', !!(r.note && r.note.startsWith('неверно')));
            }
        }

        // Ввод, пришедший ИЗНУТРИ системы, — всегда двоичная строка, поэтому язык
        // переключаем на «двоичная строка»: иначе поле врало бы о своём содержимом.
        function loadBinIntoField(bin) {
            sequenceInput.value = bin;
            if (curLang !== 'bin') { curLang = 'bin'; inputLang.value = 'bin'; renderLangOpts(); }
            validateInput(bin);
            exprOut.textContent = '';
        }

        // ─── Панель представлений: одна строка на язык ───
        function renderRepr(seq) {
            reprBadge.textContent = `${seq.length} бит`;
            const rows = [];
            for (const [k, I] of Object.entries(INTERPRETERS)) {
                if (k === 'bin') continue;
                const r = I.encode(seq, langOpts);
                if (r.err) {
                    // Не прячем: причина информативнее пустоты.
                    rows.push(`<div class="repr-row dim"><span class="repr-lang">${esc(I.label)}</span>
                        <span class="repr-val bad">${esc(r.err)}</span></div>`);
                    continue;
                }
                let extra = (r.extra || []).map(([lab, val]) => `<b>${esc(lab)}:</b> ${esc(val)}`).join(' &nbsp;·&nbsp; ');
                if (k === 'num') {
                    const n = BigInt('0b' + seq);
                    extra += (extra ? ' &nbsp;·&nbsp; ' : '') + '<b>множители:</b> ' + (seq.length <= 64
                        ? esc(factorText(n))
                        : `<button class="repr-btn" id="factorBtn">разложить (${seq.length} бит — может занять время)</button>`);
                }
                rows.push(`<div class="repr-row"><span class="repr-lang">${esc(I.label)}</span>
                    <span class="repr-val">${esc(r.text)}</span>
                    ${extra ? `<span class="repr-extra">${extra}</span>` : ''}</div>`);
            }
            reprBody.innerHTML = rows.join('');
        }

        // Сводка кружочков по готовым счётчикам (без строки) — общий вид для длинных рядов.
        function dotsSummary(ones, total) {
            return `<div class="binary-dots dots-summary">`
                + `<span class="dot one"></span>${ones}`
                + ` &nbsp;<span class="dot zero"></span>${total - ones}`
                + ` &nbsp;<span class="dots-len">${total} бит</span></div>`;
        }
        // Число единиц в BigInt по значащим битам (O(bitLength)); нуль-биты не входят в
        // toString(2), поэтому длинное поле из нулей НЕ материализуется.
        function popcountBig(x) {
            if (x <= 0n) return 0;
            const s = x.toString(2);
            let ones = 0;
            for (let i = 0; i < s.length; i++) if (s.charCodeAt(i) === 49) ones++;   // '1'
            return ones;
        }
        function dotsHtml(str) {
            // Длинную строку не рисуем по кружку на бит (иначе панель пути даёт O(N²)
            // узлов, а окно класс-листа — десятки тысяч спанов). Сворачиваем в сводку.
            if (str.length > DOTS_CAP) {
                let ones = 0;
                for (const ch of str) if (ch === '1') ones++;
                return dotsSummary(ones, str.length);
            }
            let h = '<div class="binary-dots">';
            for (const ch of str) {
                h += `<span class="dot ${ch === '0' ? 'zero' : 'one'}"></span>`;
            }
            h += '</div>';
            return h;
        }

        // ─── ИНФО-ПАНЕЛЬ ───
        function updateInfo(seq) {
            const p = seqProps(seq);
            // Класс = «0»×N, диапазон = «0»×N … «1»×N. При большой длине N литералов
            // переполняют карточку — показываем компактно «0×N», а не N нулей подряд.
            const long = p.len > DOTS_CAP;
            const cls = long ? `0×${p.len}` : repeatChar('0', p.len);
            const top = long ? `1×${p.len}` : repeatChar('1', p.len);

            classNameEl.textContent = cls;
            // 2^N и позиция — компактно (степень + число разрядов), без гигантских чисел в DOM.
            const firstOne = seq.indexOf('1');
            const decBits = firstOne < 0 ? 0 : (p.len - firstOne);   // значащих бит в dec — дёшево, без toString
            const pos = fmtScale(p.dec + 1n, decBits);
            for (const el of [totalVariantsEl, positionEl]) { el.style.fontSize = ''; el.style.wordBreak = ''; el.style.lineHeight = ''; }
            totalVariantsEl.innerHTML = pow2Html(p.len);
            positionEl.innerHTML = `<span title="${esc(pos.title)}">${pos.text}</span> / ${pow2Html(p.len)}`;
            classRangeEl.textContent = `${cls} – ${top}`;

            const card = infoPanel.querySelector('.highlight');
            card.style.animation = 'none';
            void card.offsetHeight;
            card.style.animation = 'pulse 2s infinite';

            fullBadge.innerHTML = `2<sup>${p.len}</sup>`;
        }

        // ─── ПУТЬ O(N) ───
        // Вычисление пути дешёвое на любой длине; дорог только DOM. Поэтому при большом N
        // РИСУЕМ срез (первые/последние K строк), а вычисление НЕ ограничиваем. word-break
        // переносит длинные строки/числа в несколько строк вместо смазывания.
        function renderPath(seq) {
            const n = seq.length;
            const firstOne = seq.indexOf('1');   // для оценки числа разрядов dec без BigInt (O(N) один раз)

            // Ряд строится за O(1) от i: строки-классы компактны (0×i / 1×i), префикс — срез
            // head…tail, число единиц приходит готовым (ones), позиция — 2^i + число разрядов.
            // Так в DOM не попадают ни строки длины N, ни гигантские десятичные числа.
            const rowFor = (i, ones) => {
                const isLast = (i === n);
                let prefixShow, dots;
                if (i <= DOTS_CAP) {
                    const prefix = seq.slice(0, i);
                    prefixShow = prefix.length > 48 ? prefix.slice(0, 24) + '…' + prefix.slice(-24) : prefix;
                    dots = dotsHtml(prefix);
                } else {
                    prefixShow = seq.slice(0, 24) + '…' + seq.slice(i - 24, i);
                    dots = dotsSummary(ones, i);
                }
                let posCell;
                if (i <= 50) {
                    const dec = BigInt('0b' + seq.slice(0, i));
                    posCell = `${dec + 1n} / ${pow2Html(i)}`;
                } else {
                    const bits = i > firstOne && firstOne >= 0 ? i - firstOne : 0;   // значащих бит в dec
                    posCell = `<span title="позиция среди 2^${i}">≈${digitsFromBits(bits).toLocaleString()}-значное</span> / ${pow2Html(i)}`;
                }
                return `
                    <tr class="${isLast ? 'current-row' : ''}">
                        <td class="position-num">${i} / ${i}</td>
                        <td style="letter-spacing:2px;word-break:break-all;font-weight:${isLast ? '700' : '400'}">
                            ${prefixShow} ${dots}
                        </td>
                        <td style="letter-spacing:2px;color:var(--purple);word-break:break-all">0×${i}</td>
                        <td style="color:var(--orange);font-size:0.82rem;word-break:break-all">0×${i} – 1×${i}</td>
                        <td style="font-weight:${isLast ? '700' : '400'};color:var(--accent);word-break:break-all">${posCell}</td>
                        <td>${isLast ? '<span class="badge here">ВЫ ЗДЕСЬ</span>' : ''}</td>
                    </tr>
                `;
            };

            let html = '', note = '';
            if (n <= RENDER_PATH_CAP) {
                let ones = 0;
                for (let i = 1; i <= n; i++) { if (seq[i - 1] === '1') ones++; html += rowFor(i, ones); }
            } else {
                const k = RENDER_PATH_CAP >> 1;   // первые k и последние k строк
                let ones = 0;
                for (let i = 1; i <= k; i++) { if (seq[i - 1] === '1') ones++; html += rowFor(i, ones); }
                const hidden = n - 2 * k;
                html += `<tr class="path-skip"><td colspan="6" style="text-align:center;color:var(--text-secondary);font-size:0.78rem;padding:9px">… ${hidden} строк скрыто для скорости — вычисление полное, показаны первые и последние ${k} …</td></tr>`;
                // ones(i) для хвоста: от полного числа единиц, откатывая назад (O(N) один проход + O(k))
                let totalOnes = 0; for (let j = 0; j < n; j++) if (seq[j] === '1') totalOnes++;
                const base = n - k + 1;
                const tailOnes = new Array(k);
                let acc = totalOnes;
                for (let i = n; i >= base; i--) { tailOnes[i - base] = acc; if (seq[i - 1] === '1') acc--; }
                for (let i = base; i <= n; i++) html += rowFor(i, tailOnes[i - base]);
                note = ` · показано ${2 * k} из ${n}`;
            }

            pathBody.innerHTML = html;
            pathBadge.textContent = `O(${n})`;
            pathFooter.textContent = `${n} строк${note}`;
        }

        // ─── СТРУКТУРА (S, V) ───
        function countTransitions(str) {
            let v = 0;
            for (let i = 1; i < str.length; i++) {
                if (str[i] !== str[i - 1]) v++;
            }
            return v;
        }

        function runLengths(str) {
            if (!str) return [];
            const segs = [];
            let i = 0;
            while (i < str.length) {
                const bit = str[i];
                let j = i;
                while (j < str.length && str[j] === bit) j++;
                const s = j - i;
                segs.push({ bit, s, v: s - 1 });
                i = j;
            }
            return segs;
        }

        // ─── АЛГЕБРА МЕР ───
        // S (содержание) и V (объём) рождаются ТОЛЬКО из оператора склейки, а не из
        // присваивания V=S−1. Лист-бит = (S:1, V:0). Склейка k частей: S=ΣS, V=ΣV+(k−1),
        // где (k−1) — «швы» между частями. Множество {S−V=1} замкнуто под склейкой,
        // поэтому инвариант исполняется на каждом узле сам, без отдельной проверки.
        function mCombine(parts, pattern) {
            let S = 0n, V = 0n;
            for (const p of parts) { S += p.S; V += p.V; }
            V += BigInt(parts.length - 1); // швы = k−1
            return { S, V, pattern, k: parts.length };
        }
        function mRun(bit, len) {
            // серия длины len = склейка len листьев-битов → (S:len, V:len−1). Считаем НАПРЯМУЮ
            // (O(1)), а строку-паттерн строим лишь когда она короткая и реально нужна для показа;
            // для длинного ряда — компактно «bit×len» (иначе один длинный ряд стоил бы O(N)).
            const L = BigInt(len);
            return { S: L, V: len > 0 ? L - 1n : -1n, pattern: len <= 64 ? bit.repeat(len) : `${bit}×${len}`, k: len };
        }

        function renderStructure(seq) {
            const n = seq.length;
            const segs = runLengths(seq);

            // Снизу вверх: каждая серия — мера, целое — склейка серий (со швами).
            const runMeasures = segs.map(s => mRun(s.bit, s.s));
            const whole = runMeasures.length ? mCombine(runMeasures, seq) : mCombine([{ S: 0n, V: -1n }], seq);

            structBadge.textContent = `S=${fmtNum(whole.S)} · V=${fmtNum(whole.V)}`;

            let html = '';
            const seqShow = seq.length > 48 ? seq.slice(0, 24) + '…' + seq.slice(-24) : seq;   // не льём строку длины N в DOM

            // ── Целое: крупно содержание S и объём V ──
            html += `<div class="sv-head">`
                + `<div class="sv-seq" title="${n} бит">${seqShow}</div>`
                + `<div class="sv-nums">`
                +   `<span class="sv-chip sv-s">Содержание S = <b>${fmtNum(whole.S)}</b></span>`
                +   `<span class="sv-chip sv-v">Объём V = <b>${fmtNum(whole.V)}</b></span>`
                +   `<span class="sv-chip sv-inv">S = V + 1</span>`
                + `</div></div>`;

            // ── Меры (серии): видимые S и V каждой ── (при большом числе — срез)
            html += `<div class="struct-level-label">Меры (серии): ${segs.length}</div>`;
            html += `<div class="sv-cards">`;
            const cardOf = idx => {
                const m = runMeasures[idx], seg = segs[idx];
                const patHtml = seg.s <= 24 ? `${m.pattern} ${dotsHtml(m.pattern)}` : `${seg.bit}×${seg.s}`;
                return `<div class="sv-card"><div class="sv-card-pat">${patHtml}</div>`
                    + `<div class="sv-card-nums">S=<b>${fmtNum(m.S)}</b> · V=<b>${fmtNum(m.V)}</b></div></div>`;
            };
            if (runMeasures.length <= RENDER_PATH_CAP) {
                for (let idx = 0; idx < runMeasures.length; idx++) html += cardOf(idx);
            } else {
                const k = RENDER_PATH_CAP >> 1;
                for (let idx = 0; idx < k; idx++) html += cardOf(idx);
                html += `<div class="sv-card sv-card-skip">… ${runMeasures.length - 2 * k} мер скрыто …</div>`;
                for (let idx = runMeasures.length - k; idx < runMeasures.length; idx++) html += cardOf(idx);
            }
            html += `</div>`;

            // ── Векторы S и V + видимая сборка объёма: V = ΣV + швы ──
            // Суммы — в закрытой форме (O(1), без обхода всех серий): ΣS = n, ΣV = n − #серий.
            const sumS = BigInt(n), sumV = BigInt(n - segs.length);
            const seams = BigInt(Math.max(0, runMeasures.length - 1));
            // Векторы режем ПО ИНДЕКСАМ до форматирования (не мапим все серии).
            const fmtVec = (get, len) => {
                const join = (a, b) => { const out = []; for (let i = a; i < b; i++) out.push(get(i)); return out.join(', '); };
                if (len <= RENDER_PATH_CAP) return join(0, len);
                const k = RENDER_PATH_CAP >> 1;
                return join(0, k) + `, … (${len - 2 * k} скрыто) …, ` + join(len - k, len);
            };
            const sVec = fmtVec(i => fmtNum(runMeasures[i].S), runMeasures.length);
            const vVec = fmtVec(i => fmtNum(runMeasures[i].V), runMeasures.length);
            html += `<div class="sv-vectors">`
                + `<div>Вектор S: [${sVec}]<span class="sv-dim">ΣS = ${fmtNum(sumS)}</span></div>`
                + `<div>Вектор V: [${vVec}]<span class="sv-dim">ΣV = ${fmtNum(sumV)}</span></div>`
                + `<div class="sv-assemble">Объём целого: V = ΣV + швы = ${fmtNum(sumV)} + ${fmtNum(seams)} = <b>${fmtNum(whole.V)}</b></div>`
                + `<div class="sv-assemble">Содержание целого: S = ΣS = <b>${fmtNum(whole.S)}</b></div>`
                + `</div>`;

            // ── Уровни снизу вверх: агрегаты объёма растут по мере склейки ──
            // биты (несклеенные листья) → серии → целое. S сохраняется (всего бит),
            // V растёт: 0 → ΣV(серий) → n−1, каждый шов добавляет объём.
            html += `<div class="struct-level-label" style="margin-top:10px">Уровни (снизу вверх)</div>`;
            html += `<div class="sv-levels">`
                + `<div class="sv-lvl"><span>биты ×${n}</span><span>ΣS=${fmtNum(BigInt(n))} · ΣV=${fmtNum(0n)}</span></div>`
                + `<div class="sv-lvl"><span>серии ×${segs.length}</span><span>ΣS=${fmtNum(sumS)} · ΣV=${fmtNum(sumV)}</span></div>`
                + `<div class="sv-lvl sv-lvl-top"><span>целое</span><span>S=${fmtNum(whole.S)} · V=${fmtNum(whole.V)}</span></div>`
                + `</div>`;

            structTree.innerHTML = html;

            structFooter.textContent = `${segs.length} мер · S=${fmtNum(whole.S)} · V=${fmtNum(whole.V)} · S−V=${fmtNum(whole.S - whole.V)}`;
        }

        // ─── ВИРТУАЛЬНЫЙ СКРОЛЛ (правая панель) ───
        let vsLen = 0;
        let vsTotal = 0n;      // 2^len — точный BigInt (может быть астрономическим)
        let vsHighlight = 0n;  // индекс текущей строки — точный BigInt
        let vsSpacerH = 0;
        let vsCompressed = false;
        let vsTopIdx = 0n;     // индекс верхней видимой строки (BigInt) — источник истины в сжатом режиме
        let vsWheelAccum = 0;  // накопитель дробных «строк» от колеса/тачпада
        let vsUserScrolling = false; // пользователь тащит ползунок (только тогда пересчитываем из scrollTop)
        let lastSi = -1n;
        let lastEi = -1n;
        let lastFooter = '';
        // ROW_HEIGHT и HEADER_H замеряются вживую (устойчиво к любому масштабу/зуму)
        let ROW_HEIGHT = 32;
        let HEADER_H = 33;
        const OVERSCAN = 6;
        const MAX_SAFE_HEIGHT = 16_000_000;
        const COMPRESSED_SPACER = 40000;

        function visRowsCount() {
            const vh = fullViewport.clientHeight || 380;
            return Math.max(1, Math.floor(vh / ROW_HEIGHT));
        }
        function maxTopIdx() {
            const m = vsTotal - BigInt(visRowsCount());
            return m > 0n ? m : 0n;
        }

        function buildFullRow(idx, len, highlight) {
            const cur = idx === highlight;
            const num = idx + 1n;
            const numF = fmtScale(num);   // компактный номер: «≈D цифр» при огромном значении (без гигантского узла)
            // O(bitLength), НЕ O(len): при длинном ряде показ (head…tail) и счёт кружочков
            // берём прямо из BigInt, без материализации len-строки из нулей — иначе каждый
            // видимый ряд стоил бы O(len), и высокий computeLen тормозил бы скролл.
            let binShow, dots;
            if (len > DOTS_CAP) {
                const tail = (idx & ((1n << 24n) - 1n)).toString(2).padStart(24, '0');   // младшие 24 бита
                const head = (idx >> BigInt(len - 24)).toString(2).padStart(24, '0');     // старшие 24 бита
                binShow = head + '…' + tail;
                dots = dotsSummary(popcountBig(idx), len);
            } else {
                // Короткий ряд (≤ DOTS_CAP): строка дёшева, поведение как прежде.
                const bin = padBinStr(idx, len);
                binShow = bin.length > 48 ? bin.slice(0, 24) + '…' + bin.slice(-24) : bin;
                dots = dotsHtml(bin);
            }
            return `
                <div class="full-row${cur ? ' current-row' : ''}" data-index="${idx}">
                    <div class="full-cell position-num" title="${esc(numF.title)}">${numF.text}</div>
                    <div class="full-cell" style="letter-spacing:2px;font-weight:${cur ? '700' : '400'}">${binShow}</div>
                    <div class="full-cell">${dots}</div>
                    <div class="full-cell">${cur ? '<span class="badge here">ВЫ ЗДЕСЬ</span>' : ''}</div>
                </div>
            `;
        }

        // Замер реальной высоты строки и заголовка при текущем масштабе браузера.
        // Все строки имеют одинаковую длину, поэтому одна проба даёт точную высоту для всех.
        function measureMetrics() {
            let probe = false;
            if (!fullVisible.firstElementChild) {
                fullVisible.innerHTML = buildFullRow(0n, vsLen || 1, -1n);
                probe = true;
            }
            const row = fullVisible.firstElementChild;
            if (row) {
                const h = row.getBoundingClientRect().height;
                if (h > 0) ROW_HEIGHT = h;
            }
            const header = document.querySelector('.full-header-row');
            if (header) {
                const hh = header.getBoundingClientRect().height;
                if (hh > 0) HEADER_H = hh;
            }
            if (probe) fullVisible.innerHTML = '';
        }

        function rebuildDOM(si, ei) {
            lastSi = si;
            lastEi = ei;
            let html = '';
            for (let i = si; i < ei; i++) {
                html += buildFullRow(i, vsLen, vsHighlight);
            }
            fullVisible.innerHTML = html;
            updateFooter();
        }

        function calcVS() {
            const st = fullViewport.scrollTop;
            const vh = fullViewport.clientHeight || 380;
            const W = Math.ceil(vh / ROW_HEIGHT) + OVERSCAN * 2; // размер окна в строках (мал)
            const Wb = BigInt(W);

            let si, ei, winTop; // si/ei — BigInt (могут быть астрономическими)
            if (vsCompressed) {
                // Сжатый режим: содержимое задаётся vsTopIdx (плавный шаг по строкам),
                // а позиция окна берётся из текущего scrollTop, чтобы строки попали во вьюпорт.
                const topIdx = bclamp(vsTopIdx, 0n, maxTopIdx());
                si = bmax(0n, topIdx - BigInt(OVERSCAN));
                ei = bmin(vsTotal, si + Wb);
                si = bmax(0n, ei - Wb);
                // Разница (topIdx - si) и (ei - si) всегда мала → безопасно в Number.
                winTop = st - HEADER_H - Number(topIdx - si) * ROW_HEIGHT;
                const maxWinTop = Math.max(0, vsSpacerH - Number(ei - si) * ROW_HEIGHT);
                winTop = Math.max(0, Math.min(maxWinTop, winTop));
            } else {
                // Обычный режим: точное соответствие 1:1 с поправкой на залипающий заголовок.
                // Здесь total помещается в безопасный диапазон, индексы малы.
                const rel = st - HEADER_H;
                const siNum = Math.max(0, Math.floor(rel / ROW_HEIGHT) - OVERSCAN);
                si = BigInt(siNum);
                ei = bmin(vsTotal, BigInt(Math.ceil((rel + vh) / ROW_HEIGHT) + OVERSCAN));
                winTop = siNum * ROW_HEIGHT;
            }
            return { si, ei, winTop };
        }

        // Отрисовка окна: transform и содержимое обновляются в одном кадре — без «прыжков».
        function renderWindow() {
            const { si, ei, winTop } = calcVS();
            fullVisible.style.transform = `translateY(${winTop}px)`;
            if (si !== lastSi || ei !== lastEi) {
                rebuildDOM(si, ei);
            }
        }

        // Позиция скроллбара, соответствующая текущему vsTopIdx (сжатый режим).
        function expectedScrollTop() {
            const usable = Math.max(1, fullViewport.scrollHeight - fullViewport.clientHeight);
            const mt = maxTopIdx();
            // Позиция ползунка — визуальная величина, приблизительность здесь допустима
            // (в сжатом режиме спейсер и так огрубляет). Дробь берём во float.
            return mt > 0n ? Math.round((Number(vsTopIdx) / Number(mt)) * usable) : 0;
        }

        // Обработчик нативного события scroll. В сжатом режиме vsTopIdx пересчитываем из
        // scrollTop ТОЛЬКО когда пользователь реально тащит ползунок; программные сдвиги и
        // микро-дрожание браузера (при огромном спейсере 1px ≈ сотни строк) игнорируем —
        // содержимое остаётся на месте, а winTop сам поглощает пиксельный сдвиг.
        function onScroll() {
            if (!vsLen) return;
            if (vsCompressed && vsUserScrolling) {
                const usable = Math.max(1, fullViewport.scrollHeight - fullViewport.clientHeight);
                const frac = Math.max(0, Math.min(1, fullViewport.scrollTop / usable));
                // Перетаскивание ползунка задаёт долю → индекс (огрубление ожидаемо).
                vsTopIdx = BigInt(Math.round(frac * Number(maxTopIdx())));
            }
            renderWindow();
        }

        // Установить индекс верхней строки (сжатый режим) и подтянуть ползунок.
        function setTopIdx(v) {
            const clamped = bclamp(v, 0n, maxTopIdx());
            if (clamped === vsTopIdx) return;
            vsTopIdx = clamped;
            const target = expectedScrollTop();
            if (target !== Math.round(fullViewport.scrollTop)) {
                fullViewport.scrollTop = target; // может вызвать onScroll — он увидит согласованность
            }
            renderWindow();
        }

        // Перейти на delta вариантов вверх/вниз и сразу выбрать последовательность.
        function stepSelect(delta) {
            if (!vsLen) return;
            const newIdx = bclamp(vsHighlight + BigInt(delta), 0n, vsTotal - 1n);
            if (newIdx === vsHighlight) return;
            const bin = padBinStr(newIdx, vsLen);
            loadBinIntoField(bin);
            processSequence(bin);
        }

        // Прокрутка на delta строк — единообразно на любом масштабе.
        function stepRows(delta) {
            if (!vsLen) return;
            if (vsCompressed) {
                setTopIdx(vsTopIdx + BigInt(delta));
            } else {
                fullViewport.scrollTop += delta * ROW_HEIGHT;
                renderWindow();
            }
        }

        // Прокрутка так, чтобы строка idx оказалась в центре вьюпорта.
        function scrollToIndex(idx) {
            const vh = fullViewport.clientHeight || 380;
            if (!vsLen || vsTotal <= 1n) { fullViewport.scrollTop = 0; return; }
            if (vsCompressed) {
                setTopIdx(idx - BigInt(Math.floor(visRowsCount() / 2)));
                return;
            }
            const target = HEADER_H + Number(idx) * ROW_HEIGHT - (vh - ROW_HEIGHT) / 2;
            const maxScroll = fullViewport.scrollHeight - vh;
            fullViewport.scrollTop = Math.max(0, Math.min(maxScroll, target));
            renderWindow();
        }

        function initVS(len, highlight) {
            vsLen = len;
            vsTotal = 1n << BigInt(len);   // точное 2^len (BigInt)
            vsHighlight = highlight;        // BigInt
            vsWheelAccum = 0;
            lastSi = -1n;
            lastEi = -1n;
            lastFooter = '';

            // Сначала замеряем реальные размеры при текущем масштабе
            fullVisible.innerHTML = '';
            fullVisible.style.transform = 'translateY(0px)';
            measureMetrics();

            // Сжимаем, если реальная высота (2^len строк) превысила бы предел px.
            // Сравниваем в BigInt, чтобы не переполнить Number: total > maxRows.
            const maxRowsUncompressed = BigInt(Math.max(1, Math.floor(MAX_SAFE_HEIGHT / ROW_HEIGHT)));
            vsCompressed = vsTotal > maxRowsUncompressed;
            vsSpacerH = vsCompressed ? COMPRESSED_SPACER : Number(vsTotal) * ROW_HEIGHT;

            fullContent.style.height = vsSpacerH + 'px';

            // Позиционируем на текущую строку и рендерим окно (transform + содержимое сразу).
            if (vsCompressed) {
                vsTopIdx = bclamp(highlight - BigInt(Math.floor(visRowsCount() / 2)), 0n, maxTopIdx());
                fullViewport.scrollTop = expectedScrollTop();
                renderWindow();
            } else {
                fullViewport.scrollTop = 0;
                scrollToIndex(highlight);
            }
        }

        function updateFooter() {
            if (!vsLen) return;
            const text = vsCompressed
                ? `сжатый скролл · ${fmtNum(vsTotal)} строк · показано ${lastEi - lastSi}`
                : `${fmtNum(vsTotal)} строк · показано ${lastEi - lastSi}`;
            if (text !== lastFooter) {
                lastFooter = text;
                fullFooter.textContent = text;
            }
        }

        // ═══════════════════════════════════════════════════════════════════
        // СТРУКТУРНЫЙ ПОИСК
        // Любое структурное условие (мотив, запрет, распорка, следование,
        // ограничение на шаги, длины серий) — регулярное. Компилируем его в
        // конечный автомат, а дальше всё считается динамическим
        // программированием: множество 2^N не материализуется никогда.
        // ═══════════════════════════════════════════════════════════════════

        const DFA_CAP = 4096;   // предохранитель от взрыва состояний

        // ─── Разбор шаблона: подмножество regex  . | ( ) * + ? {m,n} ───
        function patParse(src) {
            let i = 0;
            const peek = () => src[i];
            function alt() {
                let n = cat();
                while (peek() === '|') { i++; n = { t: 'alt', a: n, b: cat() }; }
                return n;
            }
            function cat() {
                let n = null;
                while (i < src.length && peek() !== '|' && peek() !== ')') {
                    const r = rep();
                    n = n ? { t: 'cat', a: n, b: r } : r;
                }
                return n || { t: 'eps' };
            }
            function rep() {
                let n = atom();
                for (;;) {
                    const c = peek();
                    if (c === '*') { i++; n = { t: 'star', a: n }; }
                    else if (c === '+') { i++; n = { t: 'cat', a: n, b: { t: 'star', a: n } }; }
                    else if (c === '?') { i++; n = { t: 'alt', a: n, b: { t: 'eps' } }; }
                    else if (c === '{') {
                        i++;
                        let s = '';
                        while (i < src.length && peek() !== '}') s += src[i++];
                        if (peek() !== '}') throw { msg: 'не закрыта фигурная скобка', pos: i };
                        i++;
                        const parts = s.includes(',') ? s.split(',') : [s, s];
                        const lo = parseInt(parts[0], 10);
                        const hi = parts[1] === '' ? -1 : parseInt(parts[1], 10);
                        if (isNaN(lo) || lo < 0 || (hi >= 0 && hi < lo)) throw { msg: `неверный повтор {${s}}`, pos: i };
                        if (lo > 500 || hi > 500) throw { msg: 'повтор больше 500', pos: i };
                        let out = { t: 'eps' };
                        for (let j = 0; j < lo; j++) out = { t: 'cat', a: out, b: n };
                        if (hi < 0) out = { t: 'cat', a: out, b: { t: 'star', a: n } };
                        else for (let j = lo; j < hi; j++) out = { t: 'cat', a: out, b: { t: 'alt', a: n, b: { t: 'eps' } } };
                        n = out;
                    } else break;
                }
                return n;
            }
            function atom() {
                const c = peek();
                if (c === undefined) throw { msg: 'шаблон обрывается', pos: i };
                if (c === '(') {
                    i++;
                    const n = alt();
                    if (peek() !== ')') throw { msg: 'не закрыта скобка', pos: i };
                    i++;
                    return n;
                }
                if (c === '.') { i++; return { t: 'any' }; }
                if (c === '0' || c === '1') { i++; return { t: 'lit', c }; }
                throw { msg: `недопустимый символ «${c}»`, pos: i };
            }
            if (!src) throw { msg: 'пустой шаблон', pos: 0 };
            const n = alt();
            if (i < src.length) throw { msg: `лишний символ «${src[i]}»`, pos: i };
            return n;
        }

        // ─── Построение NFA (конструкция Томпсона) ───
        function patNfa(ast) {
            const S = [];
            const nw = () => { S.push({ eps: [], on: {} }); return S.length - 1; };
            function go(n) {
                const s = nw(), e = nw();
                if (n.t === 'eps') S[s].eps.push(e);
                else if (n.t === 'lit') S[s].on[n.c] = (S[s].on[n.c] || []).concat(e);
                else if (n.t === 'any') { for (const c of '01') S[s].on[c] = (S[s].on[c] || []).concat(e); }
                else if (n.t === 'alt') {
                    const a = go(n.a), b = go(n.b);
                    S[s].eps.push(a.s, b.s); S[a.e].eps.push(e); S[b.e].eps.push(e);
                } else if (n.t === 'cat') {
                    const a = go(n.a), b = go(n.b);
                    S[s].eps.push(a.s); S[a.e].eps.push(b.s); S[b.e].eps.push(e);
                } else if (n.t === 'star') {
                    const a = go(n.a);
                    S[s].eps.push(a.s, e); S[a.e].eps.push(a.s, e);
                }
                return { s, e };
            }
            const { s, e } = go(ast);
            return { S, start: s, accept: e };
        }

        // ─── Детерминизация (построение подмножеств) ───
        function patDfa(N) {
            const closure = seed => {
                const stack = [...seed], seen = new Set(stack);
                while (stack.length) {
                    const q = stack.pop();
                    for (const r of N.S[q].eps) if (!seen.has(r)) { seen.add(r); stack.push(r); }
                }
                return [...seen].sort((a, b) => a - b);
            };
            const key = a => a.join(','), map = new Map(), states = [], queue = [];
            const add = set => {
                const k = key(set);
                if (map.has(k)) return map.get(k);
                const id = states.length;
                map.set(k, id); states.push(set); queue.push(set);
                if (states.length > DFA_CAP) throw { msg: `взрыв состояний (>${DFA_CAP}) — упростите шаблон`, pos: 0 };
                return id;
            };
            add(closure([N.start]));
            const delta = [];
            while (queue.length) {
                const set = queue.shift(), id = map.get(key(set));
                delta[id] = {};
                for (const c of '01') {
                    const nxt = new Set();
                    for (const q of set) for (const r of (N.S[q].on[c] || [])) nxt.add(r);
                    delta[id][c] = add(closure([...nxt]));
                }
            }
            return { delta, acc: states.map(s => s.includes(N.accept)), n: states.length };
        }

        function patCompile(src) { return patDfa(patNfa(patParse(src))); }

        // ─── Произведение автоматов: И и ИЛИ — ОДНА И ТА ЖЕ конструкция ───
        // Оба автомата полные (и детерминизация, и само произведение строят полные),
        // поэтому объединению детерминизация не нужна: пара состояний по-прежнему
        // однозначно определяет следующую пару. Меняется ровно правило приёмки пары.
        // Отсюда и одинаковая цена: |Q| ≤ |A|·|B| и для И, и для ИЛИ.
        function dfaProduct(A, B, or) {
            const map = new Map(), pairs = [], queue = [], delta = [], acc = [];
            const what = or ? 'объединении' : 'пересечении';
            const add = (a, b) => {
                const k = a * B.n + b;
                if (map.has(k)) return map.get(k);
                const id = pairs.length;
                map.set(k, id); pairs.push([a, b]); queue.push([a, b]);
                if (pairs.length > DFA_CAP) throw { msg: `взрыв состояний при ${what} (>${DFA_CAP})`, pos: 0 };
                return id;
            };
            add(0, 0);
            while (queue.length) {
                const [a, b] = queue.shift(), id = map.get(a * B.n + b);
                delta[id] = {};
                for (const c of '01') delta[id][c] = add(A.delta[a][c], B.delta[b][c]);
                acc[id] = or ? (A.acc[a] || B.acc[b]) : (A.acc[a] && B.acc[b]);
            }
            return { delta, acc, n: pairs.length };
        }

        function dfaIntersect(A, B) { return dfaProduct(A, B, false); }
        function dfaUnion(A, B) { return dfaProduct(A, B, true); }

        // ─── Дополнение: DFA после детерминизации полный, поэтому точное ───
        function dfaComplement(D) { return { delta: D.delta, acc: D.acc.map(x => !x), n: D.n }; }

        // ─── Минимизация (разбиение Мура) ───
        // Пересечение условий даёт много эквивалентных состояний. Слияние их удерживает
        // размер автомата: 8 наложенных условий дают 954 состояния, после минимизации 160.
        // Важнее итога — пик: минимизация между пересечениями не даёт промежуточным
        // автоматам разрастаться и упереться в DFA_CAP.
        // Недостижимых состояний не бывает: и детерминизация, и пересечение строят
        // только достижимое; мёртвые состояния корректно сливаются в одно.
        function dfaMinimize(D) {
            if (D.n <= 1) return D;
            let cls = D.acc.map(a => (a ? 1 : 0));
            let k = new Set(cls).size;
            for (;;) {
                const m = new Map(), nc = new Array(D.n);
                for (let q = 0; q < D.n; q++) {
                    const key = cls[q] + '|' + cls[D.delta[q]['0']] + '|' + cls[D.delta[q]['1']];
                    if (!m.has(key)) m.set(key, m.size);
                    nc[q] = m.get(key);
                }
                if (m.size === k) break;
                cls = nc; k = m.size;
            }
            // Стартовое состояние обязано остаться нулевым: patCountAll/patSuffix/patUnrank
            // считают стартом индекс 0. САМО это НЕ выполняется: цикл выше выходит по
            // `m.size === k` НЕ применив nc, поэтому при обрыве на первой же итерации в cls
            // остаётся исходный вектор приёмки, где принимающему старту достаётся id 1, а
            // ноль — мёртвому состоянию. Тогда счёт молча выходил нулевым (например
            // «не содержит 1»), а если принимали ВСЕ состояния, то k=1 при cls из единиц —
            // delta[0] оставалась undefined и patCountAll падал.
            // Поэтому нумеруем классы явно, в порядке первого появления при скане q от нуля.
            const ren = new Map();
            for (let q = 0; q < D.n; q++) if (!ren.has(cls[q])) ren.set(cls[q], ren.size);
            cls = cls.map(c => ren.get(c));
            k = ren.size;

            const delta = new Array(k), acc = new Array(k);
            for (let q = 0; q < D.n; q++) {
                const c = cls[q];
                if (delta[c]) continue;
                delta[c] = { '0': cls[D.delta[q]['0']], '1': cls[D.delta[q]['1']] };
                acc[c] = D.acc[q];
            }
            return { delta, acc, n: k };
        }

        // ═══ КОМПИЛЯТОРЫ РЕЖИМОВ ═══
        // Каждый режим — своя форма ввода, но все сводятся к одному автомату,
        // поэтому новый вид поиска стоит формы, а не движка.

        const litOk = s => /^[01]+$/.test(s);

        // «шаги»: нотация 1_0_0_1_0 — какие пары допустимы по обе стороны «_».
        // Состояния: 0 начало · 1 был ноль · 2 была единица · 3 тупик.
        function stepsDfa(allowed) {
            const st = c => (c === '0' ? 1 : 2);
            const delta = [];
            delta[0] = { '0': 1, '1': 2 };
            for (const last of ['0', '1']) {
                const from = st(last);
                delta[from] = {};
                for (const c of ['0', '1']) delta[from][c] = allowed[last + c] ? st(c) : 3;
            }
            delta[3] = { '0': 3, '1': 3 };
            return { delta, acc: [true, true, true, false], n: 4 };
        }

        // все блоки длины |Y| кроме самого Y — для строгого «после X всегда Y»
        function notBlock(Y) {
            const m = Y.length, alts = [];
            for (let v = 0; v < (1 << m); v++) {
                const s = v.toString(2).padStart(m, '0');
                if (s !== Y) alts.push(s);
            }
            return alts.length ? '(' + alts.join('|') + ')' : null;
        }

        // серии: нули длиной z0..z1, единицы o0..o1, строго чередуясь
        function runsPattern(z0, z1, o0, o1) {
            const Z = `0{${z0},${z1}}`, O = `1{${o0},${o1}}`;
            return `(${Z})?(${O}${Z})*(${O})?`;
        }

        // Одно условие → автомат. Бросает {msg} при плохом вводе.
        function buildCondition(c) {
            const need = (v, what) => { if (!litOk(v)) throw { msg: `${what}: только 0 и 1, не пусто`, pos: 0 }; return v; };
            // human — фраза на русском: что именно ищется. negatable = есть ли у неё
            // естественное отрицание («содержит» → «не содержит»); иначе обёртка.
            let D, expr, human, negatable = false;
            // Плагин-условие: своя форма, но на выходе — обычный ДКА. Ядро видит
            // только ДКА, поэтому «сломаться» может лишь внутри плагина: исключение
            // ловим, неполный ДКА отсекаем валидатором. Дальше — общий хвост
            // (отрицание + минимизация), тот же, что у встроенных режимов.
            const plug = PLUGINS.condition[c.mode];
            if (plug) {
                const r = safeRun(() => plug.compile(c, Engine), c.mode);
                if (!r.ok) throw { msg: `плагин «${c.mode}»: ${r.err}`, pos: 0 };
                const out = r.value || {};
                const bad = validateDfa(out.D);
                if (bad) throw { msg: `плагин «${c.mode}» вернул некорректный ДКА: ${bad}`, pos: 0 };
                D = out.D;
                expr = out.expr || c.mode;
                human = out.human || `плагин ${c.mode}`;
                negatable = !!out.negatable;
            } else
            switch (c.mode) {
                case 'motif':
                    expr = `.*${need(c.a, 'мотив')}.*`;
                    human = `содержит ${c.a}`; negatable = true;
                    D = patCompile(expr); break;
                case 'mask':
                    if (!/^[01.]+$/.test(c.a)) throw { msg: 'маска: только 0, 1 и точка', pos: 0 };
                    expr = c.a;
                    human = `подходит под шаблон ${c.a} (точка — любой бит), длина ${c.a.length}`;
                    negatable = true;
                    D = patCompile(expr); break;
                case 'spacer':
                    need(c.a, 'мотив'); need(c.b, 'распорка');
                    expr = `${c.a}(${c.b}${c.a})*`;
                    human = `мотив ${c.a}, повторяющийся через ${c.b}`;
                    D = patCompile(expr); break;
                case 'runs': {
                    const z0 = +c.z0, z1 = +c.z1, o0 = +c.o0, o1 = +c.o1;
                    for (const [v, nm] of [[z0, 'нулей от'], [z1, 'нулей до'], [o0, 'единиц от'], [o1, 'единиц до']])
                        if (!Number.isInteger(v) || v < 1 || v > 200) throw { msg: `${nm}: целое от 1 до 200`, pos: 0 };
                    if (z1 < z0 || o1 < o0) throw { msg: 'в диапазоне серий «до» меньше «от»', pos: 0 };
                    expr = runsPattern(z0, z1, o0, o1);
                    const rng = (a, b) => a === b ? `ровно ${a}` : `по ${a}–${b}`;
                    human = `серии нулей ${rng(z0, z1)}, серии единиц ${rng(o0, o1)}`;
                    D = patCompile(expr); break;
                }
                case 'steps': {
                    const allowed = c.allowed || {};
                    const all = ['00', '01', '10', '11'];
                    if (!all.some(p => allowed[p])) throw { msg: 'шаги: разрешите хотя бы одну пару', pos: 0 };
                    const on = all.filter(p => allowed[p]), off = all.filter(p => !allowed[p]);
                    expr = 'шаги: ' + on.join(' ');
                    // Понятнее назвать запрещённое: именно оно и отсеивает варианты.
                    if (!off.length) human = 'любые пары на шаге (без ограничений)';
                    else if (on.length === 2 && allowed['01'] && allowed['10'])
                        human = 'на шаге не бывает пар 00 и 11 (строгое чередование)';
                    else human = `на шаге не бывает ${off.length === 1 ? 'пары' : 'пар'} ${off.join(' и ')}`;
                    D = stepsDfa(allowed); break;
                }
                case 'implies': {
                    // «если есть X, то есть Y»  ≡  ¬(есть X ∧ ¬есть Y)
                    need(c.a, 'посылка'); need(c.b, 'следствие');
                    const A = patCompile(`.*${c.a}.*`), B = patCompile(`.*${c.b}.*`);
                    D = dfaComplement(dfaIntersect(A, dfaComplement(B)));
                    expr = `если есть ${c.a} → есть ${c.b}`;
                    human = `если где-то есть ${c.a}, то где-то есть и ${c.b}`; break;
                }
                case 'after': {
                    // строго: за каждым X немедленно следует Y
                    need(c.a, 'посылка'); need(c.b, 'следствие');
                    if (c.b.length > 7) throw { msg: 'следствие длиннее 7 — слишком много вариантов', pos: 0 };
                    const m = c.b.length, nb = notBlock(c.b);
                    const bad = `.*${c.a}.{0,${m - 1}}` + (nb ? `|.*${c.a}${nb}.*` : '');
                    D = dfaComplement(patCompile(bad));
                    expr = `после ${c.a} всегда ${c.b}`;
                    human = `сразу за каждым ${c.a} стоит ${c.b}`; break;
                }
                case 'expr':
                default:
                    expr = c.a || '';
                    human = `подходит под выражение ${expr}`;
                    D = patCompile(expr); break;
            }
            const base = human;   // фраза ДО отрицания — для легенды формулы
            if (c.not) {
                D = dfaComplement(D);
                expr = `НЕ (${expr})`;
                human = negatable ? 'не ' + human : `неверно, что: ${human}`;
            }
            D = dfaMinimize(D);
            return { D, expr, human, base };
        }

        // ═══ ДЕРЕВО УСЛОВИЙ ═══
        // Узел — либо ЛИСТ {mode,…,not,off} (его собирает buildCondition), либо
        // ГРУППА {op:'and'|'or', kids:[…], not, off}. Дерево схлопывается в ОДИН
        // минимизированный полный DFA ДО того, как запустится хоть одна аналитическая
        // функция, поэтому patCountAll/patSuffix/patUnrank/findRecurrence не меняются
        // вообще: для них ничего не произошло. Растёт только константа |Q|.
        const isGroup = n => !!(n && n.op);

        // Путь узла: '' — корень, '0.2.1' — kids[0].kids[2].kids[1].
        const childPath = (p, i) => (p === '' ? String(i) : p + '.' + i);

        // Собирает поддерево. sizes: Map путь→|Q| (для бейджей; дерево не мутируем).
        function buildNode(node, path, sizes) {
            if (!isGroup(node)) {
                const r = buildCondition(node);
                sizes.set(path, r.D.n);
                return r;
            }
            const kids = node.kids || [];
            const act = [];
            kids.forEach((k, i) => { if (!k.off) act.push([k, i]); });
            if (!act.length) throw { msg: path === '' ? 'не задано ни одного условия' : `группа ${path.split('.').map(x => +x + 1).join('.')} пуста`, pos: 0 };

            const or = node.op === 'or';
            let D = null; const exprs = [], humans = [];
            for (const [k, i] of act) {
                const r = buildNode(k, childPath(path, i), sizes);
                exprs.push(r.expr);
                humans.push(isGroup(k) && (k.kids || []).filter(x => !x.off).length > 1 ? `(${r.human})` : r.human);
                // Минимизируем после КАЖДОГО произведения — это удерживает пик размера.
                D = D ? dfaMinimize(dfaProduct(D, r.D, or)) : r.D;
            }
            let expr = exprs.join(or ? '  ИЛИ  ' : '  И  ');
            let human = humans.join(or ? ' или ' : ' и ');
            if (node.not) {
                // Дополнение бесплатно: |Q| не меняется, переворачивается только acc.
                D = dfaComplement(D);
                expr = `НЕ (${expr})`;
                human = `неверно, что: ${human}`;
            }
            sizes.set(path, D.n);
            return { D, expr, human };
        }

        // Точка входа. Принимает узел ИЛИ плоский массив условий (легаси-форма
        // пресетов и самопроверки — она означает «всё через И»).
        function buildSpec(tree, sizes) {
            const root = Array.isArray(tree) ? { op: 'and', kids: tree } : tree;
            return buildNode(root, '', sizes || new Map());
        }

        // ─── Подсчёт по ВСЕМ классам одним инкрементальным проходом ───
        // v[n] получается из v[n−1] умножением на матрицу переходов, поэтому
        // длины 1..nMax считаются за один проход, а не за nMax отдельных.
        function patCountAll(D, nMax) {
            let v = new Array(D.n).fill(0n);
            v[0] = 1n;
            const out = new Array(nMax + 1).fill(0n);
            for (let n = 1; n <= nMax; n++) {
                const w = new Array(D.n).fill(0n);
                for (let q = 0; q < D.n; q++) {
                    const x = v[q];
                    if (x) { w[D.delta[q]['0']] += x; w[D.delta[q]['1']] += x; }
                }
                v = w;
                let t = 0n;
                for (let q = 0; q < D.n; q++) if (D.acc[q]) t += v[q];
                out[n] = t;
            }
            return out;
        }

        // ─── Таблица суффиксов: f[j][q] = сколько принимаемых продолжений
        //     длины j из состояния q. Основа распаковки. ───
        function patSuffix(D, N) {
            const f = [new Array(D.n)];
            for (let q = 0; q < D.n; q++) f[0][q] = D.acc[q] ? 1n : 0n;
            for (let j = 1; j <= N; j++) {
                f[j] = new Array(D.n);
                for (let q = 0; q < D.n; q++) f[j][q] = f[j - 1][D.delta[q]['0']] + f[j - 1][D.delta[q]['1']];
            }
            return f;
        }

        // ─── m-я подходящая строка длины N в числовом порядке ───
        function patUnrank(f, D, N, m) {
            let q = 0, s = '';
            for (let j = N; j > 0; j--) {
                const zero = f[j - 1][D.delta[q]['0']];
                if (m < zero) { s += '0'; q = D.delta[q]['0']; }
                else { m -= zero; s += '1'; q = D.delta[q]['1']; }
            }
            return s;
        }

        // ─── Большие числа: без «экспонентов» e+N — показываем число разрядов ───
        // Мелкое (≤18 знаков) — целиком; большое — «≈D цифр», точное (если обозримо) — в title.
        function fmtCount(b) {
            const s = b.toString();
            if (s.length <= 18) return { text: fmtNum(b), title: s };
            const d = s.length.toLocaleString();
            return { text: `≈${d} цифр`, title: s.length <= 200 ? s : `${d} десятичных разрядов` };
        }

        // ═══════════════════════════════════════════════════════════════════
        // ПРАВИЛА (подстановки / L-система) — слой ПОВЕРХ ядра
        // Правило заменяет атом на слово (0→…, 1→…). Применяя от аксиомы,
        // разворачиваем последовательность вправо; «провалиться в атом» =
        // «применить правило ещё раз» = «дописать справа». Инвариант S−V=1
        // держится сам (любое непустое слово: N атомов, N−1 швов), ядро меры
        // не трогается. Длина растёт экспоненциально, НО считается без
        // выписывания строки — счётчики (нулей, единиц) линейны по матрице
        // подстановки, поэтому S/V любого уровня берутся за O(уровней).
        // ═══════════════════════════════════════════════════════════════════

        const RULE_MAX_IMG = 32;   // предел длины образа и аксиомы

        function ruleCounts(word) {
            let z = 0n, o = 0n;
            for (const c of word) { if (c === '0') z++; else o++; }
            return [z, o];
        }

        // Длины (и S=len, V=len−1) уровней 0..K через матрицу подстановки.
        // Строку НЕ материализуем — только числа. O(K) операций BigInt.
        function ruleLevels(rule, axiom, K) {
            const [z0, o0] = ruleCounts(rule['0']);
            const [z1, o1] = ruleCounts(rule['1']);
            let [z, o] = ruleCounts(axiom);
            const out = [];
            for (let k = 0; k <= K; k++) {
                const len = z + o;
                out.push({ k, len, S: len, V: len - 1n });
                // новый вектор: вклад нулей (×из 0) плюс единиц (×из 1)
                const nz = z * z0 + o * z1;
                const no = z * o0 + o * o1;
                z = nz; o = no;
            }
            return out;
        }

        // Материализуем строку, разворачивая пока длина ≤ maxLen. Возвращаем
        // последний влезающий уровень. Никогда не строим строку длиннее maxLen.
        function ruleExpand(rule, axiom, maxLen) {
            let word = axiom, level = 0;
            for (;;) {
                let next = '';
                let ok = true;
                for (const c of word) {
                    next += rule[c];
                    if (next.length > maxLen) { ok = false; break; }
                }
                if (!ok) break;
                word = next; level++;
                if (word.length === axiom.length && level > 0) break; // неподвижное по длине (напр. 0→0,1→1)
                if (level > 4000) break;
            }
            return { word, level };
        }

        // Есть ли бесконечное слово вправо: образ ведущего символа аксиомы
        // начинается с него же (правило префикс-сохраняющее).
        function rulePrefixKept(rule, axiom) {
            if (!axiom) return false;
            const lead = axiom[0];
            return rule[lead] && rule[lead][0] === lead;
        }

        // ─── РЕКУРРЕНТНАЯ СВЯЗЬ МЕЖДУ КЛАССАМИ ───
        // Для любого регулярного условия последовательность количеств по классам
        // ВСЕГДА удовлетворяет линейной рекуррентности порядка ≤ |Q| (следствие
        // Кэли–Гамильтона). Находим её: структурное правило внутри
        // последовательности превращается в закон, связывающий все классы.

        function bgcd(a, b) { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { const t = a % b; a = b; b = t; } return a; }
        function rat(n, d) {
            if (d === 0n) return null;
            if (d < 0n) { n = -n; d = -d; }
            const g = bgcd(n, d) || 1n;
            return [n / g, d / g];
        }
        function rAdd(x, y) { return rat(x[0] * y[1] + y[0] * x[1], x[1] * y[1]); }
        function rSub(x, y) { return rat(x[0] * y[1] - y[0] * x[1], x[1] * y[1]); }
        function rMul(x, y) { return rat(x[0] * y[0], x[1] * y[1]); }
        function rDiv(x, y) { return y[0] === 0n ? null : rat(x[0] * y[1], x[1] * y[0]); }
        const R0 = [0n, 1n];

        // Гаусс с полным приведением; null, если система вырождена
        function solveLin(M, v, d) {
            const A = M.map((row, i) => row.concat([v[i]]));
            for (let col = 0; col < d; col++) {
                let piv = -1;
                for (let r = col; r < d; r++) if (A[r][col][0] !== 0n) { piv = r; break; }
                if (piv < 0) return null;
                const t = A[col]; A[col] = A[piv]; A[piv] = t;
                const p = A[col][col];
                for (let c = col; c <= d; c++) { A[col][c] = rDiv(A[col][c], p); if (!A[col][c]) return null; }
                for (let r = 0; r < d; r++) {
                    if (r === col || A[r][col][0] === 0n) continue;
                    const f = A[r][col];
                    for (let c = col; c <= d; c++) A[r][c] = rSub(A[r][c], rMul(f, A[col][c]));
                }
            }
            return A.map(row => row[d]);
        }

        // ─── Берлекэмп–Мэсси по простому модулю: минимальный порядок за O(len·L) ───
        // Заменяет перебор порядков: находим истинный порядок за один проход,
        // равномерно быстро даже для |Q|=160. Наивный Гаусс O(D⁴) убран.
        function bmModInv(a, P) {
            let [old_r, r] = [((a % P) + P) % P, P];
            let [old_s, s] = [1n, 0n];
            while (r !== 0n) { const q = old_r / r;[old_r, r] = [r, old_r - q * r];[old_s, s] = [s, old_s - q * s]; }
            return ((old_s % P) + P) % P;
        }
        function bmOrder(seq, P) {
            const S = seq.map(x => ((x % P) + P) % P);
            let C = [1n], B = [1n], L = 0, m = 1, b = 1n;
            for (let n = 0; n < S.length; n++) {
                let d = S[n];
                for (let i = 1; i <= L; i++) d = (d + C[i] * S[n - i]) % P;
                d = ((d % P) + P) % P;
                if (d === 0n) { m++; }
                else if (2 * L <= n) {
                    const T = C.slice(), coef = (d * bmModInv(b, P)) % P;
                    while (C.length < B.length + m) C.push(0n);
                    for (let i = 0; i < B.length; i++) C[i + m] = ((C[i + m] - coef * B[i]) % P + P) % P;
                    L = n + 1 - L; B = T; b = d; m = 1;
                } else {
                    const coef = (d * bmModInv(b, P)) % P;
                    while (C.length < B.length + m) C.push(0n);
                    for (let i = 0; i < B.length; i++) C[i + m] = ((C[i + m] - coef * B[i]) % P + P) % P;
                    m++;
                }
            }
            return L;
        }
        // Истинный порядок ряда a[1..nMax]: два простых должны согласиться.
        function recurrenceOrder(a, nMax) {
            const seq = [];
            for (let n = 1; n <= nMax; n++) seq.push(a[n]);
            const L1 = bmOrder(seq, 2147483647n);   // 2^31−1
            const L2 = bmOrder(seq, 2147483477n);
            const L = Math.max(L1, L2);
            return { L, trusted: L1 === L2 && 2 * L <= nMax };
        }

        // Скорость роста λ ≈ a(n)/a(n−1) — доминантное собственное число (мера роста
        // языка). BigInt-безопасно. null, если ряд конечен/нулевой в хвосте.
        function growthRate(a, nMax) {
            let hi = nMax;
            while (hi > 1 && a[hi] === 0n) hi--;
            if (hi < 2 || a[hi - 1] === 0n) return null;
            return Number((a[hi] * 1000000n) / a[hi - 1]) / 1e6;
        }
        const NAMED_CONSTS = [
            [1.6180339887, 'φ, золотое сечение'], [1.8392867552, 'трибоначчи-константа'],
            [1.9275619754, 'тетраначчи-константа'], [1.4142135624, '√2'],
            [1.3247179572, 'пластиковое число'], [1.7220838057, 'ψ, суперзолотое'],
            [2, 'удвоение'], [3, 'утроение']
        ];
        function namedConstant(lam) {
            if (lam == null) return null;
            if (lam < 1.0001) return 'полиномиальный рост';
            for (const [v, name] of NAMED_CONSTS) if (Math.abs(lam - v) < 5e-4) return name;
            return null;
        }

        // Порядок находим Берлекэмп–Мэсси (истинный, за один проход), затем ОДИН раз
        // решаем систему на этом порядке для точных коэффициентов. Высокие порядки —
        // без коэффициентов (стена чисел): показываем порядок + скорость роста λ.
        const REC_EXACT_MAX = 24;
        function findRecurrence(a, nMax, maxD, qn) {
            let last = 0;
            for (let n = 1; n <= nMax; n++) if (a[n] !== 0n) last = n;
            if (last === 0) return { kind: 'empty' };
            // хвост пуст → конечное семейство (закона роста нет)
            if (last <= nMax - 4) {
                const cls = [];
                for (let n = 1; n <= last; n++) if (a[n] !== 0n) cls.push(n);
                return { kind: 'finite', last, cls };
            }

            const { L, trusted } = recurrenceOrder(a, nMax);
            if (L === 0) return { kind: 'none' };

            // Низкий порядок — точные коэффициенты + проверка по всему ряду.
            const cap = qn ? Math.min(REC_EXACT_MAX, qn) : REC_EXACT_MAX;
            if (L <= cap && nMax >= 2 * L + 2) {
                const d = L, end = Math.min(nMax, 2 * d + 12);
                const M = [], v = [];
                for (let i = 0; i < d; i++) {
                    const n = end - d + 1 + i, row = [];
                    for (let j = 1; j <= d; j++) row.push([a[n - j], 1n]);
                    M.push(row); v.push([a[n], 1n]);
                }
                const c = solveLin(M, v, d);
                if (c) {
                    let from = -1;
                    for (let n = nMax; n > d; n--) {
                        let s = R0;
                        for (let j = 1; j <= d; j++) s = rAdd(s, rMul(c[j - 1], [a[n - j], 1n]));
                        if (s && s[1] === 1n && s[0] === a[n]) from = n; else break;
                    }
                    if (from > 0 && (nMax - from + 1) >= 2 * d + 2) return { kind: 'found', d, c, from };
                }
            }
            // Высокий порядок (или мало данных для точной проверки) — только порядок.
            return { kind: 'order', d: L, trusted };
        }

        function fmtRecurrence(res) {
            if (res.kind === 'empty') return 'совпадений нет ни в одном классе';
            if (res.kind === 'finite') {
                const list = res.cls.length <= 8 ? res.cls.join(', ') : res.cls.slice(0, 8).join(', ') + ', …';
                return `в просмотренном диапазоне совпадения только в классах ${list} — закона не видно, попробуйте увеличить «классы до»`;
            }
            if (res.kind === 'order') {
                return res.trusted
                    ? `линейная рекуррентность порядка ${res.d} (коэффициенты не выписываем)`
                    : `рекуррентность порядка ≥ ${res.d} — данных мало, увеличьте «классы до»`;
            }
            if (res.kind === 'none') return 'линейной рекуррентности не обнаружено';
            const parts = [];
            for (let j = 1; j <= res.d; j++) {
                const p = res.c[j - 1][0], q = res.c[j - 1][1];
                if (p === 0n) continue;
                const neg = p < 0n, ap = neg ? -p : p;
                const coef = q === 1n ? (ap === 1n ? '' : `${ap}·`) : `${ap}/${q}·`;
                parts.push({ neg, s: `${coef}a(n−${j})` });
            }
            if (!parts.length) return 'a(n) = 0';
            let s = (parts[0].neg ? '−' : '') + parts[0].s;
            for (let i = 1; i < parts.length; i++) s += (parts[i].neg ? ' − ' : ' + ') + parts[i].s;
            return `a(n) = ${s}` + (res.from > 1 ? `   (при n ≥ ${res.from})` : '');
        }

        // Строка-статистика: число состояний, порядок рекуррентности, скорость роста λ.
        function buildStatsLine(qn, rec, lam) {
            const parts = [`состояний ${qn}`];
            if (rec.kind === 'found' || rec.kind === 'order') parts.push(`порядок ${rec.d}`);
            if (lam != null) {
                const name = namedConstant(lam);
                parts.push(`рост λ ≈ ${lam.toFixed(4)}` + (name ? ` (${name})` : ''));
            }
            return parts.join('  ·  ');
        }

        // ═══ ИНТЕРФЕЙС ПОИСКА ═══

        const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

        const MODES = {
            motif:   { label: 'содержит',            f: [{ k: 'a', ph: '01001' }] },
            mask:    { label: 'маска (. = любой)',   f: [{ k: 'a', ph: '1.0.1' }] },
            spacer:  { label: 'мотив через распорку',f: [{ k: 'a', ph: '111010' }, { k: 'b', ph: '0000', lab: 'через' }] },
            steps:   { label: 'шаги: какие пары',    f: [{ k: 'allowed', w: 'steps' }] },
            runs:    { label: 'длины серий',         f: [{ k: 'z0', w: 'num', lab: 'нулей от' }, { k: 'z1', w: 'num', lab: 'до' },
                                                        { k: 'o0', w: 'num', lab: 'единиц от' }, { k: 'o1', w: 'num', lab: 'до' }] },
            implies: { label: 'если есть … то есть', f: [{ k: 'a', ph: '01' }, { k: 'b', ph: '001', lab: 'то есть' }] },
            after:   { label: 'после … всегда',      f: [{ k: 'a', ph: '11' }, { k: 'b', ph: '0', lab: 'всегда' }] },
            expr:    { label: 'выражение',           f: [{ k: 'a', ph: '111010(0000111010)*', w: 'expr' }] }
        };

        const PRESETS = [
            { t: '111010 через 0000', c: [{ mode: 'spacer', a: '111010', b: '0000' }] },
            { t: 'если есть 01 → есть 001', c: [{ mode: 'implies', a: '01', b: '001' }] },
            { t: 'после 11 всегда 0', c: [{ mode: 'after', a: '11', b: '0' }] },
            { t: 'запрет 111', c: [{ mode: 'motif', a: '111', not: true }] },
            { t: 'запрет 11', c: [{ mode: 'motif', a: '11', not: true }] },
            { t: 'строгое чередование', c: [{ mode: 'steps', allowed: { '00': false, '01': true, '10': true, '11': false } }] },
            { t: 'серии: нулей 2–4, единиц 3', c: [{ mode: 'runs', z0: 2, z1: 4, o0: 3, o1: 3 }] },
            { t: 'содержит 01001', c: [{ mode: 'motif', a: '01001' }] },
            { t: 'маска 1.0.1', c: [{ mode: 'mask', a: '1.0.1' }] },
            { t: 'есть 11 И есть 00', c: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] },
            // ниже — то, что стало возможно с деревом: ИЛИ, разность, вложенность
            { t: 'есть 11 ИЛИ есть 00', c: { op: 'or', kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] } },
            { t: 'без 111, кроме тех, что с 01001', c: { op: 'and', kids: [{ mode: 'motif', a: '111', not: true }, { mode: 'motif', a: '01001' }] } },
            { t: '(без 111 И есть 01) ИЛИ чередование', c: { op: 'or', kids: [
                { op: 'and', kids: [{ mode: 'motif', a: '111', not: true }, { mode: 'motif', a: '01' }] },
                { mode: 'steps', allowed: { '00': false, '01': true, '10': true, '11': false } }] } }
        ];

        // Корень дерева — всегда группа. Плоский список = группа 'and' с листьями,
        // поэтому старое поведение это частный случай нового.
        let condTree = { op: 'and', kids: [{ mode: 'spacer', a: '111010', b: '0000' }] };
        let condSizes = new Map();   // путь → |Q| последней сборки (бейджи)
        let searchResult = null;     // { D, expr, counts, nMax, rec }
        let matchSel = null;         // { n, off, total, f }

        const MAX_COND_DEPTH = 6;

        function renderPresets() {
            searchPresets.innerHTML = PRESETS
                .map((p, i) => `<span class="preset-chip" data-preset="${i}">${esc(p.t)}</span>`).join('');
        }

        // ─── Навигация по дереву: путь '' = корень, '0.2' = kids[0].kids[2] ───
        function nodeAt(p) {
            let n = condTree;
            if (p !== '') for (const i of p.split('.')) n = n.kids[+i];
            return n;
        }
        function parentAt(p) {
            const parts = p.split('.'), idx = +parts.pop();
            return { parent: nodeAt(parts.join('.')), idx };
        }
        const depthOf = p => (p === '' ? 0 : p.split('.').length);

        // Буквы листьям в порядке обхода: A…Z, дальше A2, B2, …
        function letterOf(i) {
            const L = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            return L[i % 26] + (i < 26 ? '' : String(Math.floor(i / 26) + 1));
        }
        // Буква листа по пути — обходим дерево в том же порядке, что и рендер.
        function leafLetters() {
            const map = new Map();
            let k = 0;
            (function walk(node, path) {
                if (!isGroup(node)) { map.set(path, letterOf(k++)); return; }
                (node.kids || []).forEach((c, i) => walk(c, childPath(path, i)));
            })(condTree, '');
            return map;
        }

        function renderConds() {
            const letters = leafLetters();
            searchCondsEl.innerHTML = renderNode(condTree, '', letters);
            renderFormula(letters);
        }

        // Бейдж |Q|: '—' пока сборки не было, число — после НАЙТИ.
        const sizeBadge = p => {
            const v = condSizes.get(p);
            return `<span class="grp-size" data-size="${p}">${v == null ? '—' : v + ' сост.'}</span>`;
        };

        function renderNode(node, path, letters) {
            return isGroup(node) ? renderGroup(node, path, letters) : renderLeaf(node, path, letters);
        }

        function renderGroup(node, path, letters) {
            const or = node.op === 'or';
            const root = path === '';
            const deep = depthOf(path) + 1 > MAX_COND_DEPTH;
            const kids = (node.kids || []).map((c, i) => renderNode(c, childPath(path, i), letters)).join('');
            return `<div class="cond-group${or ? ' op-or' : ''}${root ? ' root' : ''}" data-grp="${path}">
                <div class="cond-group-head">
                    <button class="op-toggle" data-op="${path}" title="Переключить И ↔ ИЛИ">${or ? 'ИЛИ' : 'И'}</button>
                    <label class="cond-not"><input type="checkbox" data-path="${path}" data-k="not"${node.not ? ' checked' : ''}>НЕ</label>
                    <span class="cond-tail">
                        ${sizeBadge(path)}
                        <button class="jump-btn" data-add-cond="${path}" title="Добавить условие в эту группу">+усл</button>
                        <button class="jump-btn" data-add-grp="${path}"${deep ? ' disabled title="Глубже вкладывать нельзя"' : ' title="Добавить вложенную группу"'}>+гр</button>
                        ${root ? '' : `<button class="jump-btn" data-del="${path}" title="Убрать группу">×</button>`}
                    </span>
                </div>
                <div class="cond-kids">${kids}</div>
            </div>`;
        }

        function renderLeaf(c, path, letters) {
            const m = MODES[c.mode] || MODES.motif;
            let fields = '';
            for (const f of m.f) {
                if (f.lab) fields += `<span class="cond-lab">${esc(f.lab)}</span>`;
                if (f.w === 'steps') {
                    const al = c.allowed || { '00': true, '01': true, '10': true, '11': true };
                    fields += '<span class="steps-box">' + ['00', '01', '10', '11'].map(p =>
                        `<label><input type="checkbox" data-path="${path}" data-step="${p}"${al[p] ? ' checked' : ''}>${p}</label>`
                    ).join('') + '</span>';
                } else if (f.w === 'num') {
                    fields += `<input type="number" class="cond-num" data-path="${path}" data-k="${f.k}" min="1" max="200" value="${esc(c[f.k] ?? 1)}">`;
                } else {
                    const cls = f.w === 'expr' ? 'cond-expr' : 'cond-lit';
                    fields += `<input type="text" class="${cls}" data-path="${path}" data-k="${f.k}" placeholder="${esc(f.ph || '')}" value="${esc(c[f.k] ?? '')}">`;
                }
            }
            const opts = Object.keys(MODES).map(k =>
                `<option value="${k}"${k === c.mode ? ' selected' : ''}>${esc(MODES[k].label)}</option>`).join('');
            // Крестик прячем только у единственного условия во всём дереве —
            // иначе поиск остался бы вовсе без условий.
            const alone = condTree.kids.length === 1 && !isGroup(condTree.kids[0]);
            return `<div class="cond-row">
                <span class="cond-letter">${esc(letters.get(path) || '')}</span>
                <select data-path="${path}" data-k="mode">${opts}</select>
                ${fields}
                <span class="cond-tail">
                    ${sizeBadge(path)}
                    <label class="cond-not"><input type="checkbox" data-path="${path}" data-k="not"${c.not ? ' checked' : ''}>НЕ</label>
                    ${alone ? '' : `<button class="jump-btn" data-del="${path}" title="Убрать условие">×</button>`}
                </span>
            </div>`;
        }

        // ─── Формула: та же композиция в теоретико-множественной записи ───
        // Строится из СТРУКТУРЫ, автоматы для неё не нужны — поэтому обновляется
        // мгновенно на каждое редактирование, ещё до нажатия НАЙТИ.
        function formulaOf(node, path, letters) {
            if (!isGroup(node)) {
                const L = letters.get(path) || '?';
                // ¬ связывает крепче ∩ и ∪, поэтому ¬A — по-прежнему атом.
                return { s: node.not ? '¬' + L : L, atom: true };
            }
            const act = [];
            (node.kids || []).forEach((c, i) => { if (!c.off) act.push([c, i]); });
            if (!act.length) return { s: '∅', atom: true };

            const parts = act.map(([c, i]) => formulaOf(c, childPath(path, i), letters));
            const wrap = p => (p.atom ? p.s : '(' + p.s + ')');
            let s, atom = false;

            // Сахар «кроме»: пересечение с отрицанием печатается как разность A \ B.
            // Отдельной операции движку не нужно — это то же самое пересечение
            // с дополнением, просто в привычной глазу записи.
            // Именно !! : без приведения к булеву у листа без флага выходит undefined,
            // а undefined !== false, и сахар разности срабатывал бы вхолостую.
            const negLeaf = i => !isGroup(act[i][0]) && !!act[i][0].not;
            const bare = i => letters.get(childPath(path, act[i][1])) || '?';
            if (node.op === 'and' && act.length === 2 && (negLeaf(0) !== negLeaf(1))) {
                const k = negLeaf(0) ? 1 : 0;          // положительный операнд
                s = `${wrap(parts[k])} \\ ${bare(1 - k)}`;
            } else if (act.length === 1) {
                s = parts[0].s; atom = parts[0].atom;
            } else {
                s = parts.map(wrap).join(node.op === 'or' ? ' ∪ ' : ' ∩ ');
            }
            if (node.not) return { s: '¬(' + s + ')', atom: true };
            return { s, atom };
        }

        function renderFormula(letters) {
            condFormula.textContent = formulaOf(condTree, '', letters).s;
            const items = [];
            (function walk(node, path) {
                if (!isGroup(node)) {
                    let base = '?';
                    // base — фраза ДО отрицания; при недописанном условии показываем режим.
                    try { base = buildCondition(Object.assign({}, node, { not: false })).base; }
                    catch (e) { base = (MODES[node.mode] || MODES.motif).label + ' …'; }
                    items.push(`<b>${esc(letters.get(path) || '')}</b> = ${esc(base)}`);
                    return;
                }
                (node.kids || []).forEach((c, i) => walk(c, childPath(path, i)));
            })(condTree, '');
            condLegend.innerHTML = items.join(' · ');
        }

        // После сборки — проставить |Q| по узлам, НЕ перерисовывая дерево
        // (перерисовка увела бы фокус из поля, в котором нажали Enter).
        function paintSizes() {
            for (const el of searchCondsEl.querySelectorAll('[data-size]')) {
                const v = condSizes.get(el.dataset.size);
                el.textContent = v == null ? '—' : v + ' сост.';
            }
        }
        // Любая правка обесценивает бейджи — гасим их до следующего НАЙТИ.
        function clearSizes() { condSizes = new Map(); paintSizes(); }

        // Принимает и плоский массив (легаси-пресеты), и узел дерева.
        function setConds(src) {
            const t = JSON.parse(JSON.stringify(src));
            condTree = Array.isArray(t) ? { op: 'and', kids: t } : (isGroup(t) ? t : { op: 'and', kids: [t] });
            condSizes = new Map();
            renderConds();
        }

        // ─── Запуск поиска ───
        function runSearch() {
            searchError.textContent = '';
            let nMax = parseInt(searchNMax.value, 10);
            if (!Number.isInteger(nMax) || nMax < 1) nMax = 40;
            nMax = Math.min(nMax, SEARCH_LEN_CAP);
            searchNMax.value = nMax;

            let spec;
            const sizes = new Map();
            try {
                spec = buildSpec(condTree, sizes);
            } catch (e) {
                // Частично собранные размеры всё равно показываем — видно, где сломалось.
                condSizes = sizes; paintSizes();
                searchResults.hidden = true;
                searchResult = null;
                searchError.textContent = e && e.msg ? e.msg : String(e && e.message || e);
                searchBadge.textContent = 'ошибка';
                searchFooter.textContent = '';
                return;
            }
            condSizes = sizes;
            paintSizes();

            const t0 = performance.now();
            const counts = patCountAll(spec.D, nMax);
            // Детектор — на РАСШИРЕННОМ ряде: порядок ~L требует 2L членов, а patCountAll дёшев.
            // Это подтверждает даже высокие порядки, не требуя от пользователя задирать «классы до».
            const dN = Math.min(420, Math.max(nMax, 2 * spec.D.n + 4));
            const dCounts = dN > nMax ? patCountAll(spec.D, dN) : counts;
            const rec = findRecurrence(dCounts, dN, 12, spec.D.n);
            const lam = growthRate(dCounts, dN);
            const ms = Math.round(performance.now() - t0);

            let total = 0n, classes = 0;
            for (let n = 1; n <= nMax; n++) if (counts[n] > 0n) { total += counts[n]; classes++; }

            searchResult = { D: spec.D, expr: spec.expr, counts, nMax, rec };
            matchSel = null;

            // Основное — фраза на русском; техническая форма приглушённой припиской.
            searchExpr.innerHTML = esc(spec.human) + ` <span class="expr-tech">${esc(spec.expr)}</span>`;
            searchBadge.textContent = `${spec.D.n} сост.`;
            searchFooter.textContent = `классов с совпадениями: ${classes} из ${nMax} · всего ${fmtCount(total).text} · ${ms} мс`;
            searchResults.hidden = false;

            drawProfile();
            renderNums();
            searchRec.textContent = fmtRecurrence(rec);
            searchStats.textContent = buildStatsLine(spec.D.n, rec, lam);
            renderClasses();

            // сразу открыть первый непустой класс
            for (let n = 1; n <= nMax; n++) if (counts[n] > 0n) { selectMatchClass(n); break; }
            if (!matchSel) { matchControls.innerHTML = ''; matchList.innerHTML = '<div class="search-empty">Совпадений нет ни в одном классе</div>'; matchWhich.textContent = ''; }
        }

        // ─── Профиль по классам (лог-шкала по числу двоичных разрядов) ───
        function drawProfile() {
            if (!searchResult || searchResults.hidden) return;
            const wrap = searchCanvas.parentElement;
            const cssW = Math.max(120, wrap.clientWidth - 14), cssH = 150;
            const dpr = window.devicePixelRatio || 1;
            searchCanvas.width = Math.round(cssW * dpr);
            searchCanvas.height = Math.round(cssH * dpr);
            searchCanvas.style.height = cssH + 'px';
            const g = searchCanvas.getContext('2d');
            g.setTransform(dpr, 0, 0, dpr, 0, 0);
            g.clearRect(0, 0, cssW, cssH);

            const { counts, nMax } = searchResult;
            let maxBits = 1;
            for (let n = 1; n <= nMax; n++) if (counts[n] > 0n) maxBits = Math.max(maxBits, counts[n].toString(2).length);

            const base = cssH - 15, bw = cssW / nMax;
            const curLen = currentSequence ? currentSequence.length : -1;

            for (let n = 1; n <= nMax; n++) {
                const x = (n - 1) * bw;
                if (counts[n] === 0n) {
                    g.fillStyle = 'rgba(48,54,61,0.5)';
                    g.fillRect(x + 0.5, base - 2, Math.max(1, bw - 1), 2);
                    continue;
                }
                const h = Math.max(2, (counts[n].toString(2).length / maxBits) * (base - 6));
                g.fillStyle = n === curLen ? 'rgba(63,185,80,0.9)' : 'rgba(88,166,255,0.75)';
                g.fillRect(x + 0.5, base - h, Math.max(1, bw - 1), h);
            }

            g.strokeStyle = 'rgba(48,54,61,1)';
            g.beginPath(); g.moveTo(0, base); g.lineTo(cssW, base); g.stroke();

            g.fillStyle = '#8b949e';
            g.font = '9px "SF Mono", Monaco, monospace';
            const stepLbl = Math.max(1, Math.round(nMax / 12));
            for (let n = 1; n <= nMax; n++) {
                if (n !== 1 && n % stepLbl !== 0) continue;
                g.fillText(String(n), (n - 1) * bw + 1, cssH - 4);
            }
            if (curLen >= 1 && curLen <= nMax) {
                g.strokeStyle = 'rgba(63,185,80,0.9)';
                g.strokeRect((curLen - 1) * bw + 0.5, 1, Math.max(1, bw - 1), base - 1);
            }
        }

        function renderNums() {
            const { counts, nMax } = searchResult;
            const show = Math.min(nMax, 24);
            const parts = [];
            for (let n = 1; n <= show; n++) parts.push(counts[n] === 0n ? '0' : fmtCount(counts[n]).text);
            searchNums.textContent = 'по классам 1…' + show + ':  ' + parts.join(', ') + (nMax > show ? ' …' : '');
        }

        function renderClasses() {
            const { counts, nMax, D } = searchResult;
            const rows = [];
            for (let n = 1; n <= nMax; n++) {
                if (counts[n] === 0n) continue;
                const c = fmtCount(counts[n]);
                const totalCls = 1n << BigInt(n);
                const pct = Number((counts[n] * 1000000n) / totalCls) / 10000;
                rows.push(`<div class="sv-lvl cls-row" data-cls="${n}">
                    <span>класс ${n}<span class="cond-lab"> · доля ${pct < 0.0001 ? '<0.0001' : pct}%</span></span>
                    <span title="${esc(c.title)}">${esc(c.text)} шт</span>
                </div>`);
            }
            searchClasses.innerHTML = rows.length ? rows.join('') : '<div class="search-empty">пусто</div>';
        }

        // ─── Совпадения выбранного класса ───
        function selectMatchClass(n) {
            const { counts, D } = searchResult;
            if (!counts[n] || counts[n] === 0n) return;
            // Единственная память-цена: таблица суффиксов (n+1)·|Q| BigInt. Честно
            // отказываем, если бюджет превышен, вместо тихого зависания на аллокации.
            const cells = (n + 1) * D.n;
            if (cells > PATSUFFIX_CELL_BUDGET) {
                searchFooter.textContent = `класс ${n}: распаковка потребует ${cells.toLocaleString()} ячеек (>${PATSUFFIX_CELL_BUDGET.toLocaleString()}) — уменьшите длину класса`;
                return;
            }
            matchSel = { n, off: 0n, total: counts[n], f: patSuffix(D, n) };
            for (const el of searchClasses.querySelectorAll('.cls-row')) el.classList.toggle('sel', +el.dataset.cls === n);
            renderMatches();
        }

        function randBig(max) {
            const bits = max.toString(2).length, bytes = Math.ceil(bits / 8);
            for (;;) {
                const buf = new Uint8Array(bytes);
                crypto.getRandomValues(buf);
                let v = 0n;
                for (const b of buf) v = (v << 8n) | BigInt(b);
                v >>= BigInt(bytes * 8 - bits);
                if (v < max) return v;
            }
        }

        const MATCH_PAGE = 64n;

        function renderMatches() {
            if (!matchSel || !searchResult) return;
            const { n, off, total, f } = matchSel;
            const D = searchResult.D;
            const end = bmin(off + MATCH_PAGE, total);
            matchWhich.textContent = `· класс ${n}`;

            let html = '';
            for (let m = off; m < end; m++) {
                const bin = patUnrank(f, D, n, m);
                const cur = bin === currentSequence;
                const dots = n <= 40 ? dotsHtml(bin) : '';
                html += `<div class="full-row${cur ? ' current-row' : ''}" data-bin="${bin}">
                    <div class="full-cell position-num" title="${m + 1n}">${m + 1n}</div>
                    <div class="full-cell${n > 64 ? ' seq-long' : ''}" style="letter-spacing:2px;font-weight:${cur ? '700' : '400'}">${bin}</div>
                    <div class="full-cell">${dots}</div>
                    <div class="full-cell">${cur ? '<span class="badge here">ВЫ ЗДЕСЬ</span>' : ''}</div>
                </div>`;
            }
            matchList.innerHTML = html || '<div class="search-empty">пусто</div>';

            const tc = fmtCount(total);
            matchControls.innerHTML = `
                <button class="jump-btn" data-page="first" title="В начало">⇤</button>
                <button class="jump-btn" data-page="prev" title="Назад">←</button>
                <button class="jump-btn" data-page="next" title="Вперёд">→</button>
                <button class="jump-btn" data-page="rand" title="Случайное место">⁂</button>
                <span title="${esc(tc.title)}">${off + 1n}–${end} из ${esc(tc.text)}</span>`;
        }

        // ─── События поиска ───
        renderPresets();
        renderConds();

        searchPresets.addEventListener('click', e => {
            const chip = e.target.closest('[data-preset]');
            if (!chip) return;
            setConds(PRESETS[+chip.dataset.preset].c);
            runSearch();
        });

        condAddBtn.addEventListener('click', () => {
            condTree.kids.push({ mode: 'motif', a: '' });
            condSizes = new Map(); renderConds();
        });

        searchCondsEl.addEventListener('click', e => {
            const btn = e.target.closest('[data-del],[data-add-cond],[data-add-grp],[data-op]');
            if (!btn || btn.disabled) return;
            const d = btn.dataset;

            if (d.op !== undefined) {
                const g = nodeAt(d.op);
                g.op = g.op === 'or' ? 'and' : 'or';
            } else if (d.addCond !== undefined) {
                nodeAt(d.addCond).kids.push({ mode: 'motif', a: '' });
            } else if (d.addGrp !== undefined) {
                nodeAt(d.addGrp).kids.push({ op: 'and', kids: [{ mode: 'motif', a: '' }] });
            } else {
                const { parent, idx } = parentAt(d.del);
                parent.kids.splice(idx, 1);
                // Опустевшая подгруппа сама уходит из дерева — пустых групп не держим.
                let p = d.del.split('.').slice(0, -1).join('.');
                while (p !== '' && nodeAt(p).kids.length === 0) {
                    const up = parentAt(p);
                    up.parent.kids.splice(up.idx, 1);
                    p = p.split('.').slice(0, -1).join('.');
                }
                // Корень без условий бесполезен — сразу подставляем пустой мотив.
                if (!condTree.kids.length) condTree.kids.push({ mode: 'motif', a: '' });
            }
            condSizes = new Map();
            renderConds();
        });

        searchCondsEl.addEventListener('change', e => {
            const el = e.target;
            const p = el.dataset.path;
            if (p === undefined) return;
            const node = nodeAt(p);
            if (!node) return;

            if (el.dataset.step) {
                node.allowed = node.allowed || { '00': true, '01': true, '10': true, '11': true };
                node.allowed[el.dataset.step] = el.checked;
                clearSizes();
                return;
            }
            const k = el.dataset.k;
            if (k === 'mode') {
                const keep = node.not;
                const fresh = { mode: el.value, not: keep };
                if (el.value === 'runs') Object.assign(fresh, { z0: 2, z1: 4, o0: 3, o1: 3 });
                if (el.value === 'steps') fresh.allowed = { '00': true, '01': true, '10': true, '11': false };
                const { parent, idx } = parentAt(p);
                parent.kids[idx] = fresh;
                condSizes = new Map();
                renderConds();
                return;
            }
            if (k === 'not') {
                node.not = el.checked;
                // Отрицание меняет формулу — перерисовываем её, но не дерево.
                renderFormula(leafLetters());
            } else node[k] = el.value;
            clearSizes();
        });

        searchCondsEl.addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); runSearch(); }
        });

        searchRunBtn.addEventListener('click', runSearch);
        searchNMax.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); runSearch(); } });

        searchClasses.addEventListener('click', e => {
            const row = e.target.closest('[data-cls]');
            if (row) selectMatchClass(+row.dataset.cls);
        });

        matchControls.addEventListener('click', e => {
            const b = e.target.closest('[data-page]');
            if (!b || !matchSel) return;
            const { off, total } = matchSel;
            const act = b.dataset.page;
            if (act === 'first') matchSel.off = 0n;
            else if (act === 'prev') matchSel.off = bmax(0n, off - MATCH_PAGE);
            else if (act === 'next') matchSel.off = off + MATCH_PAGE >= total ? off : off + MATCH_PAGE;
            else if (act === 'rand') matchSel.off = total > MATCH_PAGE ? randBig(total - MATCH_PAGE) : 0n;
            renderMatches();
        });

        matchList.addEventListener('click', e => {
            const row = e.target.closest('.full-row');
            if (!row) return;
            const bin = row.dataset.bin;
            if (!bin || !isValid(bin) || bin === sequenceInput.value) return;
            loadBinIntoField(bin);
            processSequence(bin);
        });

        // ═══ ИНТЕРФЕЙС ПРАВИЛ ═══

        const RULE_PRESETS = [
            { t: 'Туэ–Морса 0→01, 1→10', i0: '01', i1: '10', ax: '0' },
            { t: 'Фибоначчи-слово 1→10, 0→1', i0: '1', i1: '10', ax: '1' },
            { t: 'ваш 1→111011, 0→0', i0: '0', i1: '111011', ax: '1' },
            { t: 'удвоение 1→11, 0→00', i0: '00', i1: '11', ax: '1' },
            { t: 'период-удвоение 1→10, 0→11', i0: '11', i1: '10', ax: '1' }
        ];

        let ruleResult = null;   // { rule, axiom, levels, expanded, prefixKept }
        let ruleSelLevel = -1;

        function renderRulePresets() {
            rulePresetsEl.innerHTML = RULE_PRESETS
                .map((p, i) => `<span class="preset-chip" data-rpreset="${i}">${esc(p.t)}</span>`).join('');
        }

        function readRule() {
            const i0 = ruleImg0El.value.trim(), i1 = ruleImg1El.value.trim(), ax = ruleAxiomEl.value.trim();
            if (!isValid(i0)) throw { msg: 'образ 0: только 0 и 1, не пусто' };
            if (!isValid(i1)) throw { msg: 'образ 1: только 0 и 1, не пусто' };
            if (!isValid(ax)) throw { msg: 'аксиома: только 0 и 1, не пусто' };
            if (i0.length > RULE_MAX_IMG || i1.length > RULE_MAX_IMG) throw { msg: `образ длиннее ${RULE_MAX_IMG}` };
            if (ax.length > RULE_MAX_IMG) throw { msg: `аксиома длиннее ${RULE_MAX_IMG}` };
            return { rule: { '0': i0, '1': i1 }, axiom: ax };
        }

        function runRule() {
            ruleError.textContent = '';
            let spec;
            try { spec = readRule(); } catch (e) {
                ruleResults.hidden = true; ruleResult = null;
                ruleError.textContent = e && e.msg ? e.msg : String(e);
                ruleBadge.textContent = 'ошибка'; ruleFooter.textContent = '';
                return;
            }
            let K = parseInt(ruleLevelsNEl.value, 10);
            if (!Number.isInteger(K) || K < 1) K = 12;
            K = Math.min(K, RULE_LEVELS_CAP);   // числа уровней растут экспоненциально — память сторожим
            ruleLevelsNEl.value = K;

            const levels = ruleLevels(spec.rule, spec.axiom, K);
            const expanded = ruleExpand(spec.rule, spec.axiom, computeLen);
            const prefixKept = rulePrefixKept(spec.rule, spec.axiom);

            ruleResult = { rule: spec.rule, axiom: spec.axiom, levels, expanded, prefixKept };
            ruleSelLevel = -1;

            const growth = spec.rule['0'].length === spec.rule['1'].length
                ? `×${spec.rule['1'].length} за уровень` : 'смешанный рост';
            ruleInfo.textContent = `0→${spec.rule['0']}  1→${spec.rule['1']}  аксиома ${spec.axiom}`;
            ruleBadge.textContent = prefixKept ? '→∞ вправо' : 'переписывается';
            ruleResults.hidden = false;

            drawRuleProfile();

            // рост длин — линейная рекуррентность (матрица 2×2, порядок ≤ 2, находится сразу).
            // Ряд с 1-индексом; берём короткий префикс, чтобы не тянуть 700-значные числа.
            const recN = Math.min(K, 48);
            const lenSeq = [0n];
            for (let k = 0; k <= recN; k++) lenSeq.push(levels[k].len);
            const rec = findRecurrence(lenSeq, recN + 1, 12);
            const lam = growthRate(lenSeq, recN + 1);
            const lamName = namedConstant(lam);
            const lamTxt = lam != null ? `  ·  λ ≈ ${lam.toFixed(4)}` + (lamName ? ` (${lamName})` : '') : '';
            ruleRec.textContent = 'рост длин: ' + fmtRecurrence(rec) + lamTxt;

            renderRuleLevels();

            // максимальный загружаемый уровень
            let maxLoad = -1;
            for (const lv of levels) if (lv.len <= BigInt(computeLen)) maxLoad = lv.k;
            ruleFooter.textContent = `${growth} · ${prefixKept ? 'есть бесконечное слово вправо' : 'нет единого бесконечного слова'}`
                + ` · загружается до уровня ${maxLoad}`;

            selectRuleLevel(expanded.level);
        }

        function renderRuleLevels() {
            const { levels } = ruleResult;
            const cap = BigInt(computeLen);
            const rowOf = lv => {
                const c = fmtScale(lv.len);   // «≈D цифр» без e-нотации; точное (если обозримо) — в title
                const loadable = lv.len <= cap;
                return `<div class="sv-lvl lvl-row${loadable ? '' : ' lvl-numonly'}" data-lvl="${lv.k}">
                    <span>уровень ${lv.k}${loadable ? '' : ' <span class="cond-lab">(только число)</span>'}</span>
                    <span title="длина: ${esc(c.title)} · S−V=1">длина ${esc(c.text)} · S−V=1</span>
                </div>`;
            };
            // Числа считаются на ВСЕ уровни; DOM режем срезом (первые/последние) — панель лёгкая.
            if (levels.length <= RENDER_PATH_CAP) {
                ruleLevelsBox.innerHTML = levels.map(rowOf).join('');
            } else {
                const k = RENDER_PATH_CAP >> 1;
                const head = levels.slice(0, k).map(rowOf).join('');
                const tail = levels.slice(levels.length - k).map(rowOf).join('');
                ruleLevelsBox.innerHTML = head
                    + `<div class="sv-lvl lvl-skip"><span>… ${levels.length - 2 * k} уровней скрыто …</span><span></span></div>`
                    + tail;
            }
        }

        function drawRuleProfile() {
            if (!ruleResult || ruleResults.hidden) return;
            const wrap = ruleCanvas.parentElement;
            const cssW = Math.max(120, wrap.clientWidth - 14), cssH = 120;
            const dpr = window.devicePixelRatio || 1;
            ruleCanvas.width = Math.round(cssW * dpr);
            ruleCanvas.height = Math.round(cssH * dpr);
            ruleCanvas.style.height = cssH + 'px';
            const g = ruleCanvas.getContext('2d');
            g.setTransform(dpr, 0, 0, dpr, 0, 0);
            g.clearRect(0, 0, cssW, cssH);

            const { levels } = ruleResult;
            const K = levels.length - 1;
            // высота ∝ числу двоичных разрядов длины (лог-шкала). Сэмплируем не более ~cssW
            // уровней (один на пиксель-столбец): toString(2) на экспоненциальных числах дорог,
            // а больше столбцов, чем пикселей, всё равно не видно → профиль остаётся дешёвым.
            const cols = Math.min(levels.length, Math.max(1, Math.floor(cssW)));
            const idxAt = i => cols <= 1 ? 0 : Math.round(i * (levels.length - 1) / (cols - 1));
            const bitsOf = lv => lv.len > 0n ? lv.len.toString(2).length : 0;
            let maxBits = 1;
            const samp = [];
            for (let i = 0; i < cols; i++) { const lv = levels[idxAt(i)]; const b = bitsOf(lv); samp.push([lv.k, b]); if (b > maxBits) maxBits = b; }
            const base = cssH - 14, bw = cssW / cols;
            for (let i = 0; i < cols; i++) {
                const [k, bits] = samp[i];
                const h = Math.max(2, (bits / maxBits) * (base - 6));
                g.fillStyle = k === ruleSelLevel ? 'rgba(63,185,80,0.9)' : 'rgba(88,166,255,0.75)';
                g.fillRect(i * bw + 0.5, base - h, Math.max(1, bw - 1), h);
            }
            g.strokeStyle = 'rgba(48,54,61,1)';
            g.beginPath(); g.moveTo(0, base); g.lineTo(cssW, base); g.stroke();
            g.fillStyle = '#8b949e';
            g.font = '9px "SF Mono", Monaco, monospace';
            const step = Math.max(1, Math.round(K / 12));
            for (let k = 0; k <= K; k++) { if (k !== 0 && k % step !== 0) continue; g.fillText(String(k), (K > 0 ? k / K : 0) * cssW + 1, cssH - 3); }
        }

        function selectRuleLevel(k) {
            if (!ruleResult) return;
            const lv = ruleResult.levels[k];
            if (!lv) return;
            ruleSelLevel = k;
            for (const el of ruleLevelsBox.querySelectorAll('.lvl-row')) el.classList.toggle('sel', +el.dataset.lvl === k);
            const cap = BigInt(computeLen);
            ruleWhich.textContent = `· уровень ${k} · длина ${fmtCount(lv.len).text}`;
            if (lv.len <= cap) {
                // материализуем ровно этот уровень (без выхода за computeLen)
                let w = ruleResult.axiom;
                for (let i = 0; i < k; i++) w = [...w].map(c => ruleResult.rule[c]).join('');
                const dots = w.length <= 40 ? dotsHtml(w) : '';
                ruleWord.innerHTML = esc(w) + dots;
                ruleWord.dataset.word = w;
                ruleLoadBtn.hidden = false;
            } else {
                ruleWord.innerHTML = `<span class="cond-lab">строка из ${fmtCount(lv.len).text} символов — не выписывается, но число точное (S−V=1)</span>`;
                ruleWord.dataset.word = '';
                ruleLoadBtn.hidden = true;
            }
            drawRuleProfile();
        }

        function loadRuleWord() {
            const w = ruleWord.dataset.word;
            if (!w || !isValid(w) || w.length > computeLen) return;
            loadBinIntoField(w);
            processSequence(w);
        }

        renderRulePresets();

        rulePresetsEl.addEventListener('click', e => {
            const chip = e.target.closest('[data-rpreset]');
            if (!chip) return;
            const p = RULE_PRESETS[+chip.dataset.rpreset];
            ruleImg0El.value = p.i0; ruleImg1El.value = p.i1; ruleAxiomEl.value = p.ax;
            runRule();
        });

        ruleRunBtn.addEventListener('click', runRule);
        for (const el of [ruleImg0El, ruleImg1El, ruleAxiomEl, ruleLevelsNEl])
            el.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); runRule(); } });

        ruleLevelsBox.addEventListener('click', e => {
            const row = e.target.closest('[data-lvl]');
            if (row) selectRuleLevel(+row.dataset.lvl);
        });

        ruleLoadBtn.addEventListener('click', loadRuleWord);
        ruleWord.addEventListener('click', loadRuleWord);

        // ─── Самопроверка ядра. Не запускается сама: вызвать __selfTest() в консоли. ───
        window.__selfTest = function () {
            const bad = [];
            const accepts = (D, s) => { let q = 0; for (const c of s) q = D.delta[q][c]; return D.acc[q]; };
            const bruteCount = (pred, N) => { let c = 0n; for (let v = 0; v < (1 << N); v++) if (pred(v.toString(2).padStart(N, '0'))) c++; return c; };

            // 1. подсчёт против полного перебора
            const pats = [['.*01001.*', s => s.includes('01001')], ['(0|10|110)*(1|11)?', s => !s.includes('111')],
                          ['1.0.1', s => s.length === 5 && s[0] === '1' && s[2] === '0' && s[4] === '1'],
                          ['(.{2})*', s => s.length % 2 === 0], ['111010(0000111010)*', null]];
            for (const [p, pred] of pats) {
                const D = patCompile(p), all = patCountAll(D, 14);
                for (let N = 1; N <= 14; N++) {
                    const want = pred ? bruteCount(pred, N) : bruteCount(s => accepts(D, s), N);
                    if (all[N] !== want) bad.push(`подсчёт ${p} N=${N}: ${all[N]} vs ${want}`);
                }
            }
            // 2. распаковка против отсортированного перебора
            for (const p of ['(0|10|110)*(1|11)?', '.*01.*']) {
                const D = patCompile(p);
                for (let N = 1; N <= 11; N++) {
                    const list = [];
                    for (let v = 0; v < (1 << N); v++) { const s = v.toString(2).padStart(N, '0'); if (accepts(D, s)) list.push(s); }
                    const f = patSuffix(D, N);
                    for (let m = 0; m < list.length; m++) if (patUnrank(f, D, N, BigInt(m)) !== list[m]) { bad.push(`распаковка ${p} N=${N} m=${m}`); break; }
                }
            }
            // 3. режимы против брутфорса
            const modes = [
                [{ mode: 'steps', allowed: { '00': true, '01': true, '10': true, '11': false } }, s => !s.includes('11')],
                [{ mode: 'implies', a: '01', b: '001' }, s => !s.includes('01') || s.includes('001')],
                [{ mode: 'after', a: '11', b: '0' }, s => { for (let i = 0; i + 2 <= s.length; i++) if (s.substr(i, 2) === '11' && s[i + 2] !== '0') return false; return true; }],
                [{ mode: 'runs', z0: 2, z1: 4, o0: 3, o1: 3 }, s => (s.match(/0+|1+/g) || []).every(r => r[0] === '0' ? (r.length >= 2 && r.length <= 4) : r.length === 3)]
            ];
            for (const [cond, pred] of modes) {
                const D = buildCondition(cond).D, all = patCountAll(D, 13);
                for (let N = 1; N <= 13; N++) if (all[N] !== bruteCount(pred, N)) { bad.push(`режим ${cond.mode} N=${N}`); break; }
            }
            // 4. рекуррентности
            const expectRec = [['(0|10|110)*(1|11)?', 3], ['(0|10)*(1)?', 2], ['(.)*', 1]];
            for (const [p, d] of expectRec) {
                const r = findRecurrence(patCountAll(patCompile(p), 60), 60, 12);
                if (r.kind !== 'found' || r.d !== d) bad.push(`рекуррентность ${p}: ожидался порядок ${d}, получено ${r.kind}/${r.d}`);
            }
            // 5. ошибки парсера
            for (const s of ['1(', '*0', '', '1a', '(1', '.*1.{40}']) {
                let threw = false;
                try { patCompile(s); } catch (e) { threw = true; }
                if (!threw) bad.push(`не поймана ошибка: ${JSON.stringify(s)}`);
            }
            // 6. дерево условий: ИЛИ, НЕ на группе, вложенность
            const has11 = s => s.includes('11'), has00 = s => s.includes('00');
            const trees = [
                ['A ИЛИ B', { op: 'or', kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] },
                    s => has11(s) || has00(s)],
                ['НЕ(A И B)', { op: 'and', not: true, kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] },
                    s => !(has11(s) && has00(s))],
                ['А\\B через НЕ', { op: 'and', kids: [{ mode: 'motif', a: '111', not: true }, { mode: 'motif', a: '01001' }] },
                    s => !s.includes('111') && s.includes('01001')],
                ['(НЕ A) ИЛИ (B И C)', { op: 'or', kids: [
                    { mode: 'motif', a: '111', not: true },
                    { op: 'and', kids: [{ mode: 'motif', a: '01' }, { mode: 'motif', a: '10' }] }] },
                    s => !s.includes('111') || (s.includes('01') && s.includes('10'))]
            ];
            for (const [nm, t, pred] of trees) {
                const D = buildSpec(t).D, all = patCountAll(D, 13);
                for (let N = 1; N <= 13; N++) if (all[N] !== bruteCount(pred, N)) { bad.push(`дерево ${nm} N=${N}: ${all[N]} vs ${bruteCount(pred, N)}`); break; }
            }
            // де Морган: ¬(¬A ∪ ¬B) обязано совпасть с A ∩ B во всех классах
            const dm = buildSpec({ op: 'or', not: true, kids: [{ mode: 'motif', a: '11', not: true }, { mode: 'motif', a: '00', not: true }] }).D;
            const both = buildSpec({ op: 'and', kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] }).D;
            const dmA = patCountAll(dm, 14), dmB = patCountAll(both, 14);
            for (let N = 1; N <= 14; N++) if (dmA[N] !== dmB[N]) { bad.push(`де Морган N=${N}: ${dmA[N]} vs ${dmB[N]}`); break; }
            // распаковка на дереве с ИЛИ — произведение с || даёт полный DFA со стартом в 0
            {
                const D = buildSpec({ op: 'or', kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] }).D;
                for (let N = 1; N <= 11; N++) {
                    const list = [];
                    for (let v = 0; v < (1 << N); v++) { const s = v.toString(2).padStart(N, '0'); if (accepts(D, s)) list.push(s); }
                    const f = patSuffix(D, N);
                    for (let m = 0; m < list.length; m++) if (patUnrank(f, D, N, BigInt(m)) !== list[m]) { bad.push(`распаковка дерева ИЛИ N=${N} m=${m}`); break; }
                }
            }
            // плоский массив (легаси-форма) обязан вести себя как группа И
            {
                const flat = buildSpec([{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }]).D;
                const grp = buildSpec({ op: 'and', kids: [{ mode: 'motif', a: '11' }, { mode: 'motif', a: '00' }] }).D;
                const x = patCountAll(flat, 14), y = patCountAll(grp, 14);
                for (let N = 1; N <= 14; N++) if (x[N] !== y[N]) { bad.push(`легаси-массив ≠ группа И, N=${N}`); break; }
            }
            // 7. СЛОЙ ПРЕДСТАВЛЕНИЙ
            // Круговой ход по ВСЕМУ реестру разом: encode(decode(x)) === x на допустимых,
            // и явная ошибка (а не мусор) на недопустимых. Новый язык подключается сюда
            // одной строкой — потому проверка и написана над реестром, а не под каждый язык.
            const ROUND = [
                ['bin', {}, ['0', '1', '101', '111010', '0000'], ['', '2', '1a', 'abc']],
                ['num', {}, [], ['3+', '1/0', '7/2', '5-9', '(1+2', '0b', 'abc', '2^-1']],
                ['text', {}, ['A', 'Hi!', 'привет', '日本', '🧬', 'a🧬я'], ['']],
                ['dna', { nuc: 'dna' }, ['A', 'ACGT', 'GATTACA'], ['ACGU', 'X', '']],
                ['dna', { nuc: 'rna' }, ['AUGC', 'AAUU'], ['ACGT', '']],
                ['alpha', { A: 'ABC' }, ['A', 'ABCABBA', 'CCC'], ['D', '']],
                ['alpha', { A: 'ABCD' }, ['ADCB', 'AAAA'], ['E', '']],
                ['alpha', { A: '0123456789ABCDEF' }, ['AF0', 'DEAD'], ['G', '']]
            ];
            for (const [id, opts, good, evil] of ROUND) {
                const I = INTERPRETERS[id];
                for (const x of good) {
                    const d = I.decode(x, opts);
                    if (d.err) { bad.push(`${id}: допустимое «${x}» отвергнуто — ${d.err}`); continue; }
                    const e = I.encode(d.bits, opts);
                    if (e.err) { bad.push(`${id}: «${x}» → ${d.bits} → ошибка обратно: ${e.err}`); continue; }
                    const want = id === 'dna' ? x.toUpperCase() : x;
                    if (e.text !== want) bad.push(`${id}: круговой ход «${x}» → «${e.text}»`);
                }
                for (const x of evil) if (!I.decode(x, opts).err) bad.push(`${id}: недопустимое «${x}» принято молча`);
            }
            // язык «число»: значения, приоритеты, префиксы, словесные операторы
            const EXPR = [['3+5', 8n], ['3 + 5 = 8', 8n], ['2^10', 1024n], ['2^10-1', 1023n], ['2^3^2', 512n],
                ['(3+5)*2', 16n], ['100/4', 25n], ['17%5', 2n], ['1<<10', 1024n], ['1024>>3', 128n],
                ['0b1010+0b1100', 22n], ['0b1010 AND 0b1100', 8n], ['0b1010 OR 0b1100', 14n],
                ['0b1010 XOR 0b1100', 6n], ['0xff', 255n], ['0d101', 101n], ['-3+10', 7n],
                ['2^64', 18446744073709551616n], ['2**8', 256n], ['0', 0n], ['1<<60', 1n << 60n]];
            for (const [src, want] of EXPR) {
                let v; try { v = exprEval(src, 10).value; } catch (e) { bad.push(`выражение «${src}»: ${e.msg}`); continue; }
                if (v !== want) bad.push(`выражение «${src}»: ${v} ≠ ${want}`);
            }
            // «=» как проверка равенства, а не присваивание
            if (exprEval('3+5=8', 10).rhs !== 8n) bad.push('«3+5=8»: правая часть не разобрана');
            if (exprEval('3+5=9', 10).rhs !== 9n) bad.push('«3+5=9»: правая часть не разобрана');
            // теоретико-числовые признаки против прямого перебора
            for (let i = 0n; i < 4000n; i++) {
                if (isSquare(i) !== Number.isInteger(Math.sqrt(Number(i)))) { bad.push(`isSquare(${i})`); break; }
            }
            {
                const F = new Set(); let a = 0n, b = 1n;
                for (let i = 0; i < 60; i++) { F.add(a);[a, b] = [b, a + b]; }
                for (let i = 0n; i < 10000n; i++) if (isFib(i) !== F.has(i)) { bad.push(`isFib(${i})`); break; }
            }
            for (let i = 0n; i < 3000n; i++) {
                let t = false; for (let k = 0n; k * (k + 1n) / 2n <= i; k++) if (k * (k + 1n) / 2n === i) t = true;
                if (isTri(i) !== t) { bad.push(`isTri(${i})`); break; }
            }
            {
                const LIM = 20000, sv = new Uint8Array(LIM).fill(1); sv[0] = sv[1] = 0;
                for (let i = 2; i * i < LIM; i++) if (sv[i]) for (let j = i * i; j < LIM; j += i) sv[j] = 0;
                for (let i = 2; i < LIM; i++) if (isPrime(BigInt(i)) !== !!sv[i]) { bad.push(`isPrime(${i})`); break; }
            }
            // согласованность слоя с ядром: разбор «0b»+строка обязан дать то же, что seqProps
            for (let t = 0; t < 200; t++) {
                const L = 1 + Math.floor(Math.random() * 60);
                let s = '1'; for (let i = 1; i < L; i++) s += Math.random() < 0.5 ? '0' : '1';
                if (exprEval('0b' + s, 10).value !== seqProps(s).dec) { bad.push(`расхождение с seqProps на «${s}»`); break; }
                if (INTERPRETERS.num.encode(s).text !== String(seqProps(s).dec)) { bad.push(`num.encode ≠ seqProps на «${s}»`); break; }
            }
            // разложение: произведение множителей обязано вернуть исходное число
            for (const n of [360n, 1n, 2n, 97n, 1024n, 123456789n, 999983n]) {
                const r = factorize(n);
                let p = 1n; for (const [q, e] of r.f) for (let i = 0; i < e; i++) p *= q;
                if (p * r.rest !== n) bad.push(`factorize(${n}) не восстанавливает число`);
            }

            // ─── Масштаб / меры / изоляция плагинов ───
            // (m1) алгебра мер: эталон 111011→S6,V5 и инвариант S=V+1 на случайных строках.
            {
                const w = '111011';
                const whole = mCombine(runLengths(w).map(s => mRun(s.bit, s.s)), w);
                if (whole.S !== 6n || whole.V !== 5n) bad.push(`мера 111011: ожидалось S6,V5, получено S${whole.S},V${whole.V}`);
                for (let t = 0; t < 40; t++) {
                    const L = 1 + Math.floor(Math.random() * 40);
                    let s = Math.random() < 0.5 ? '0' : '1';
                    for (let i = 1; i < L; i++) s += Math.random() < 0.5 ? '0' : '1';
                    const wh = mCombine(runLengths(s).map(x => mRun(x.bit, x.s)), s);
                    if (wh.S - wh.V !== 1n) bad.push(`инвариант S−V=1 нарушен на «${s}»: S${wh.S},V${wh.V}`);
                    if (wh.S !== BigInt(s.length)) bad.push(`S ≠ длине на «${s}»`);
                }
            }
            // (m2) плагин НЕ вмешивается в ядро: перезапись встроенного id запрещена.
            {
                let threw = false;
                try { Engine.register('representation', 'bin', { decode: () => ({ bits: '0' }), encode: () => ({ text: '0' }) }); }
                catch (e) { threw = true; }
                if (!threw) bad.push('register не запретил перезапись встроенного representation/bin');
            }
            // (m3) createCore изолирован: регистрация в под-ядре не видна в главном, и наоборот.
            {
                const sub = Engine.createCore();
                sub.register('measure', 'exp-x', { run: () => ({ value: 1 }) });
                if (Engine.list('measure').includes('exp-x')) bad.push('createCore: под-ядро протекло в главный Engine.list()');
                if (!sub.list('measure').includes('exp-x')) bad.push('createCore: под-ядро не помнит свою регистрацию');
                const D = patCompile('.*11.*');
                if (String(sub.patCountAll(D, 8)) !== String(patCountAll(D, 8))) bad.push('createCore: patCountAll расходится с ядром');
                let subThrew = false;
                try { sub.register('measure'); } catch (e) { subThrew = true; }
                if (!subThrew) bad.push('createCore.register не проверил аргументы');
            }
            // (m4) ruleLevels масштабируется за старый потолок 4000 (числа, без материализации).
            {
                const lv = ruleLevels({ '0': '0', '1': '111011' }, '1', 5000);
                if (lv.length !== 5001) bad.push(`ruleLevels: ожидалось 5001 уровней, получено ${lv.length}`);
                if (!(lv[5000].len > lv[4000].len)) bad.push('ruleLevels: длина не растёт за уровнем 4000');
                if (lv[5000].S - lv[5000].V !== 1n) bad.push('ruleLevels: S−V=1 нарушен на уровне 5000');
            }
            // (m5) поверхность Engine: новые методы есть, limits только на чтение.
            {
                for (const m of ['runLengths', 'mCombine', 'mRun', 'ruleLevels', 'ruleCounts', 'ruleExpand', 'createCore']) {
                    if (typeof Engine[m] !== 'function') bad.push(`Engine.${m} отсутствует`);
                }
                if (!Engine.limits || typeof Engine.limits.computeLen !== 'number') bad.push('Engine.limits.computeLen не число');
                const before = Engine.limits.computeLen;
                try { Engine.limits.computeLen = before + 1; } catch (e) {}   // getter без сеттера: строгий режим бросит
                if (Engine.limits.computeLen !== before) bad.push('Engine.limits.computeLen оказался записываемым');
            }

            // ─── Плагины: структурная валидация + собственный self-test каждого ───
            // Каждый плагин может поставлять свой selfTest(Engine) → массив проблем.
            // Так проверка растёт вместе с плагинами, а ядро остаётся общим.
            for (const kind of ['representation', 'condition', 'measure']) {
                for (const [id, p] of Object.entries(PLUGINS[kind])) {
                    if (typeof p.selfTest === 'function') {
                        const r = safeRun(() => p.selfTest(Engine), `${kind}/${id}`);
                        if (!r.ok) bad.push(`плагин ${kind}/${id}.selfTest упал: ${r.err}`);
                        else if (Array.isArray(r.value)) for (const m of r.value) bad.push(`плагин ${kind}/${id}: ${m}`);
                    }
                    // representation: encode∘decode = тождество там, где encode успешен.
                    if (kind === 'representation') {
                        for (const L of [8, 16, 24, 40]) {
                            let s = '1'; for (let i = 1; i < L; i++) s += Math.random() < 0.5 ? '0' : '1';
                            const e = p.encode(s, {});
                            if (e && e.err) continue;   // это представление не кодирует такую длину — не ошибка
                            if (!e || typeof e.text !== 'string') { bad.push(`repr/${id}: encode без text на длине ${L}`); continue; }
                            const d = p.decode(e.text, {});
                            if (!d || d.err) { bad.push(`repr/${id}: decode отверг собственный вывод «${e.text}»: ${d && d.err}`); continue; }
                            if (d.bits !== s) bad.push(`repr/${id}: encode∘decode ≠ тождество на длине ${L}`);
                        }
                    }
                    // condition: если плагин дал sample-cfg — компилируем через плагин-путь и
                    // проверяем полноту получившегося ДКА (инвариант, на который опирается ядро).
                    if (kind === 'condition' && p.sample) {
                        const r = safeRun(() => buildCondition({ mode: id, ...p.sample }), `cond/${id}`);
                        if (!r.ok) bad.push(`cond/${id}: sample не компилируется — ${r.err}`);
                        else { const vbad = validateDfa(r.value.D); if (vbad) bad.push(`cond/${id}: ДКА некорректен — ${vbad}`); }
                    }
                }
            }

            console.log(bad.length ? '❌ ' + bad.length + ' проблем:\n' + bad.join('\n') : '✅ самопроверка пройдена');
            return bad;
        };

        // ─── ОСНОВНАЯ ───
        function processSequence(seq, skipHistory) {
            if (!isValid(seq) || !seq) return;
            if (seq.length > computeLen) {
                errorMsg.textContent = `Длина ${seq.length} > предел ${computeLen}. Поднимите «предел длины» в шапке.`;
                return;
            }

            if (!skipHistory) {
                const prev = currentSequence;
                if (prev && prev !== seq && isValid(prev)) {
                    historyStack.length = historyIdx + 1;
                    historyStack.push(prev);
                    historyIdx++;
                }
            }

            currentSequence = seq;
            updateBackBtn();
            updateInfo(seq);
            renderRepr(seq);
            renderPath(seq);
            renderStructure(seq);
            // отметка текущего класса на профиле и подсветка «ВЫ ЗДЕСЬ» в совпадениях
            drawProfile();
            if (matchSel) renderMatches();

            const p = seqProps(seq);
            initVS(p.len, p.dec);

            navHint.textContent = '';
        }

        function prevClass() {
            if (currentSequence.length <= 1) return;
            const next = currentSequence.slice(1);
            loadBinIntoField(next);
            processSequence(next);
        }

        function nextClass() {
            const nextLen = currentSequence.length + 1;
            if (nextLen > computeLen) {
                errorMsg.textContent = `Максимальная длина ${computeLen}.`;
                return;
            }
            const next = '0' + currentSequence;
            loadBinIntoField(next);
            processSequence(next);
        }

        function goBack() {
            if (historyIdx < 0) return;
            const seq = historyStack[historyIdx];
            historyIdx--;
            loadBinIntoField(seq);
            processSequence(seq, true);
        }

        function updateBackBtn() {
            backBtn.disabled = historyIdx < 0;
        }

        // ─── СОБЫТИЯ ───
        // Единственная точка входа: интерпретируем ввод на выбранном языке и
        // отдаём БИТЫ существующему конвейеру. Дальше ядро работает как раньше.
        function submitInput() {
            const v = sequenceInput.value.trim();
            const r = resolveInput(v);
            if (r.err) {
                sequenceInput.classList.add('invalid');
                sequenceInput.classList.remove('valid');
                errorMsg.textContent = r.err;
                exprOut.textContent = '';
                return;
            }
            errorMsg.textContent = '';
            exprOut.textContent = r.note || (curLang === 'bin' ? '' : `→ ${r.bits}`);
            exprOut.classList.toggle('warn', !!(r.note && r.note.startsWith('неверно')));
            processSequence(r.bits);
        }

        generateBtn.addEventListener('click', submitInput);
        sequenceInput.addEventListener('input', validateLive);
        sequenceInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); submitInput(); } });

        inputLang.addEventListener('change', () => {
            curLang = inputLang.value;
            renderLangOpts();
            validateLive();
        });

        const onLangOpt = e => {
            const k = e.target.dataset && e.target.dataset.opt;
            if (!k) return;
            langOpts[k] = e.target.value;
            validateLive();
            if (currentSequence) renderRepr(currentSequence);
        };
        langOptsEl.addEventListener('change', onLangOpt);
        langOptsEl.addEventListener('input', onLangOpt);

        // Разложение больших чисел — по кнопке: на 200 битах это десятки миллисекунд,
        // и платить их на каждый ввод незачем.
        reprBody.addEventListener('click', e => {
            if (e.target.id !== 'factorBtn' || !currentSequence) return;
            e.target.outerHTML = esc(factorText(BigInt('0b' + currentSequence)));
        });

        prevClassBtn.addEventListener('click', prevClass);
        nextClassBtn.addEventListener('click', nextClass);
        backBtn.addEventListener('click', goBack);

        // ─── JUMP TO CURRENT POSITION ───
        jumpBtn.addEventListener('click', () => {
            if (!vsLen || vsTotal <= 1n) return;
            scrollToIndex(vsHighlight);
        });

        fullViewport.addEventListener('scroll', onScroll, { passive: true });

        // Отмечаем реальное перетаскивание ползунка/тач-скролл — только тогда onScroll
        // пересчитывает позицию из scrollTop (иначе — программные сдвиги и дрожание).
        fullViewport.addEventListener('pointerdown', () => { if (vsCompressed) vsUserScrolling = true; });
        fullViewport.addEventListener('touchstart', () => { if (vsCompressed) vsUserScrolling = true; }, { passive: true });
        window.addEventListener('pointerup', () => { vsUserScrolling = false; });
        window.addEventListener('touchend', () => { vsUserScrolling = false; });

        // Колесо/тачпад: в сжатом режиме листаем плавно по строкам (иначе 1px ≈ десятки
        // строк). Дробные «строки» накапливаем, чтобы тачпад шёл гладко.
        fullViewport.addEventListener('wheel', e => {
            if (!vsLen || !vsCompressed) return; // обычный режим — нативная прокрутка
            e.preventDefault();
            let dr;
            if (e.deltaMode === 1) dr = e.deltaY;                        // строки
            else if (e.deltaMode === 2) dr = e.deltaY * visRowsCount();  // страницы
            else dr = e.deltaY / ROW_HEIGHT;                            // пиксели
            vsWheelAccum += dr;
            const whole = Math.trunc(vsWheelAccum);
            if (whole !== 0) {
                vsWheelAccum -= whole;
                setTopIdx(vsTopIdx + BigInt(whole));
            }
        }, { passive: false });

        // Кнопки «на один вариант» — с выбором последовательности
        stepUpBtn.addEventListener('click', () => stepSelect(-1));
        stepDownBtn.addEventListener('click', () => stepSelect(1));

        // Клавиши: ↑/↓ — по одному варианту, PageUp/PageDown — на экран, Home/End — к краям.
        document.addEventListener('keydown', e => {
            const t = e.target;
            if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT')) return;
            if (!vsLen) return;
            const page = Math.max(1, visRowsCount() - 1);
            switch (e.key) {
                case 'ArrowDown': stepSelect(1); e.preventDefault(); break;
                case 'ArrowUp':   stepSelect(-1); e.preventDefault(); break;
                case 'PageDown':  stepRows(page); e.preventDefault(); break;
                case 'PageUp':    stepRows(-page); e.preventDefault(); break;
                case 'Home':
                    if (vsCompressed) setTopIdx(0n); else fullViewport.scrollTop = 0;
                    e.preventDefault(); break;
                case 'End':
                    if (vsCompressed) setTopIdx(maxTopIdx()); else fullViewport.scrollTop = fullViewport.scrollHeight;
                    e.preventDefault(); break;
            }
        });

        // Пересчёт при смене масштаба/зума или размера окна: заново замеряем строку
        // и восстанавливаем позицию на текущей последовательности.
        let resizeTimer = null;
        window.addEventListener('resize', () => {
            if (!vsLen) return;
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => { initVS(vsLen, vsHighlight); drawProfile(); drawRuleProfile(); }, 150);
        });

        fullViewport.addEventListener('click', e => {
            const row = e.target.closest('.full-row');
            if (!row) return;
            let idx;
            try { idx = BigInt(row.dataset.index); } catch (_) { return; }
            const bin = padBinStr(idx, vsLen);
            if (bin === sequenceInput.value) return;
            loadBinIntoField(bin);
            processSequence(bin);
        });

        // ═══════════════════════════════════════════════════════════════════
        // СЛОЙ ПЛАГИНОВ — публичный API поверх ядра (как VST к DAW)
        // Плагин НЕ трогает ядро: он получает замороженный Engine (чистые функции
        // и замкнутую алгебру ДКА) и возвращает объект. Что бы он ни вернул, ядро
        // видит только ДКА/числа, а алгебра ДКА замкнута — инвариант держится
        // структурно. Исключение плагина ловится safeRun, некорректный выход
        // отсекается валидатором: сломается плагин, а не система.
        // ═══════════════════════════════════════════════════════════════════

        const PLUGINS = { representation: {}, condition: {}, measure: {} };
        // Неснимаемое ядро — ТОЛЬКО базовые языки-представления (это часть самого
        // приложения, а не загружаемые плагины). Всё прочее, включая примеры
        // recurrence/onesmod/base64, — обычные плагины: их можно снять × и загрузить.
        const BUILTIN = { representation: new Set(['bin', 'num', 'text', 'dna', 'alpha']), condition: new Set(), measure: new Set() };

        // Граница исполнения: любое падение плагина превращается в результат-ошибку,
        // а не в исключение, рвущее ядро.
        function safeRun(fn, label) {
            try { return { ok: true, value: fn() }; }
            catch (e) { return { ok: false, err: (e && e.msg) || (e && e.message) || String(e), label }; }
        }

        // Валидатор инварианта ДКА: полный (по 0 и 1), переходы в диапазоне, старт 0.
        // Ровно то, на что молча опираются patCountAll/patSuffix/patUnrank.
        function validateDfa(D) {
            if (!D || typeof D.n !== 'number' || D.n < 1) return 'ДКА пуст или без размера';
            if (!Array.isArray(D.delta) || !Array.isArray(D.acc)) return 'нет delta/acc';
            if (D.acc.length < D.n) return 'acc короче числа состояний';
            for (let q = 0; q < D.n; q++) {
                const d = D.delta[q];
                if (!d) return `состояние ${q}: нет переходов`;
                for (const c of ['0', '1']) {
                    const t = d[c];
                    if (typeof t !== 'number' || !Number.isInteger(t)) return `состояние ${q}, символ ${c}: переход не целое`;
                    if (t < 0 || t >= D.n) return `состояние ${q}, символ ${c}: переход ${t} вне 0..${D.n - 1}`;
                }
            }
            return null;
        }

        // Ядро, отдаваемое плагину. Заморожено: плагин не может подменить функции.
        const Engine = Object.freeze({
            version: '1.0',
            // автоматное ядро (замкнутая алгебра)
            compile: patCompile,
            dfaProduct, dfaIntersect, dfaUnion, dfaComplement, dfaMinimize,
            patCountAll, patSuffix, patUnrank, findRecurrence, growthRate,
            fmtRecurrence, namedConstant, recurrenceOrder,
            // числовые признаки и разбор
            seqProps, exprEval, isPrime, isFib, isTri, isSquare, isPow2, factorize,
            // готовые кирпичи для условий
            helpers: Object.freeze({ stepsDfa, notBlock, runsPattern, padBinStr }),
            // валидатор доступен и плагину
            validateDfa,
            // МАСШТАБ ПЛАГИНАМ: алгебра мер (S/V) и L-система — те же O(N)-примитивы, что в ядре.
            // Плагин считает содержание/объём и уровни, не трогая ядро.
            runLengths, mCombine, mRun,
            ruleLevels, ruleCounts, ruleExpand,
            // Границы — ТОЛЬКО чтение (computeLen — живой геттер, сеттера плагину нет).
            limits: Object.freeze({
                get computeLen() { return computeLen; },
                RENDER_PATH_CAP, DOTS_CAP, DFA_CAP, PATSUFFIX_CELL_BUDGET,
                SEARCH_LEN_CAP, RULE_LEVELS_CAP
            }),

            // Регистрация плагина. kind ∈ {representation, condition, measure}.
            register(kind, id, plugin) {
                if (!PLUGINS[kind]) throw new Error(`неизвестный вид плагина: ${kind}`);
                if (!id || !plugin) throw new Error('register: нужны id и объект плагина');
                const req = { representation: ['decode', 'encode'], condition: ['compile'], measure: ['run'] }[kind];
                for (const m of req) if (typeof plugin[m] !== 'function') throw new Error(`плагин ${kind}/${id}: нет метода ${m}()`);
                // Плагин НЕ вмешивается в ядро: перезапись встроенного id запрещена (симметрично
                // unregister). Ядро-функции и так неизменяемы (Object.freeze); сторожим реестр.
                if (BUILTIN[kind] && BUILTIN[kind].has(id)) throw new Error(`${kind}/${id} — встроенный, перезаписать нельзя`);
                if (PLUGINS[kind][id] && PLUGINS[kind][id] !== plugin) console.warn(`Engine.register: ${kind}/${id} уже установлен — перезаписываю пользовательский плагин`);
                PLUGINS[kind][id] = plugin;
                // Встроенные реестры — просто первые клиенты этого же API.
                if (kind === 'representation') {
                    INTERPRETERS[id] = plugin;
                    if (typeof renderLangSelect === 'function' && inputLang) renderLangSelect();
                }
                if (kind === 'condition') {
                    MODES[id] = { label: plugin.label || id, f: plugin.fields || [] };
                    if (typeof renderConds === 'function') renderConds();
                }
                if (kind === 'measure' && typeof renderMeasureSelect === 'function') renderMeasureSelect();
                return Engine;
            },
            // Снять плагин. Встроенные (bundled) защищены множеством BUILTIN.
            unregister(kind, id) {
                if (!PLUGINS[kind] || !PLUGINS[kind][id]) return false;
                if (BUILTIN[kind] && BUILTIN[kind].has(id)) throw new Error(`${kind}/${id} — встроенный, снять нельзя`);
                delete PLUGINS[kind][id];
                if (kind === 'representation') {
                    delete INTERPRETERS[id];
                    if (curLang === id) { curLang = 'bin'; }
                    if (typeof renderLangSelect === 'function' && inputLang) renderLangSelect();
                    if (typeof renderLangOpts === 'function') renderLangOpts();
                }
                if (kind === 'condition') {
                    delete MODES[id];
                    // Узлы дерева на снятом режиме больше не в списке — сбросим их на 'motif',
                    // чтобы дерево оставалось валидным.
                    if (typeof condTree === 'object') {
                        (function fix(node) {
                            if (node.op) (node.kids || []).forEach(fix);
                            else if (node.mode === id) { node.mode = 'motif'; delete node.a; }
                        })(condTree);
                    }
                    if (typeof renderConds === 'function') renderConds();
                }
                if (kind === 'measure') {
                    if (mpSelect && mpSelect.value === id) mpResults && (mpResults.hidden = true);
                    if (typeof renderMeasureSelect === 'function') renderMeasureSelect();
                }
                return true;
            },
            list(kind) { return kind ? Object.keys(PLUGINS[kind] || {}) : { ...PLUGINS }; },
            isBuiltin(kind, id) { return !!(BUILTIN[kind] && BUILTIN[kind].has(id)); },

            // «СВОЁ ЯДРО»: изолированный синхронный инстанс для экспериментов плагина.
            // Свой приватный реестр и те же чистые функции; НЕ пишет в главные
            // PLUGINS/INTERPRETERS/MODES/UI. Плагины под-ядра не видны в главном Engine.list()
            // и наоборот. Сломался/удалён плагин → под-ядро GC, ядро и соседи нетронуты.
            // Форма API готова под будущий worker: createCore({worker:true}) → Promise (пока не поддержан).
            createCore(opts) {
                if (opts && opts.worker) throw new Error('createCore: параллельный (worker) режим пока не поддержан — используйте синхронный createCore()');
                const reg = { representation: {}, condition: {}, measure: {} };
                const sub = Object.freeze({
                    version: Engine.version + '-sub',
                    isSubCore: true,
                    parent: Engine,
                    // те же ЧИСТЫЕ функции ядра (ДКА — данные; изоляция = отдельный реестр)
                    compile: patCompile,
                    dfaProduct, dfaIntersect, dfaUnion, dfaComplement, dfaMinimize,
                    patCountAll, patSuffix, patUnrank, findRecurrence, growthRate,
                    fmtRecurrence, namedConstant, recurrenceOrder,
                    seqProps, exprEval, isPrime, isFib, isTri, isSquare, isPow2, factorize,
                    helpers: Object.freeze({ stepsDfa, notBlock, runsPattern, padBinStr }),
                    validateDfa, safeRun,
                    runLengths, mCombine, mRun,
                    ruleLevels, ruleCounts, ruleExpand,
                    limits: Engine.limits,
                    // приватный реестр под-ядра — НЕ трогает главный реестр/UI
                    register(kind, id, plugin) {
                        if (!reg[kind]) throw new Error(`неизвестный вид плагина: ${kind}`);
                        if (!id || !plugin) throw new Error('register: нужны id и объект плагина');
                        const req = { representation: ['decode', 'encode'], condition: ['compile'], measure: ['run'] }[kind];
                        for (const m of req) if (typeof plugin[m] !== 'function') throw new Error(`плагин ${kind}/${id}: нет метода ${m}()`);
                        reg[kind][id] = plugin;
                        return sub;
                    },
                    unregister(kind, id) {
                        if (!reg[kind] || !reg[kind][id]) return false;
                        delete reg[kind][id];
                        return true;
                    },
                    get(kind, id) { return reg[kind] ? reg[kind][id] : undefined; },
                    list(kind) {
                        return kind ? Object.keys(reg[kind] || {})
                            : { representation: { ...reg.representation }, condition: { ...reg.condition }, measure: { ...reg.measure } };
                    }
                });
                return sub;
            }
        });
        window.Engine = Engine;

        // Встроенные представления — доказательство, что API их покрывает.
        for (const [id, p] of Object.entries(INTERPRETERS)) PLUGINS.representation[id] = p;

        // ─── UI мер (measure-плагинов) ───
        const mpSelect = document.getElementById('mpSelect');
        const mpRunBtn = document.getElementById('mpRunBtn');
        const mpSaveBtn = document.getElementById('mpSaveBtn');
        const mpExportBtn = document.getElementById('mpExportBtn');
        const mpError = document.getElementById('mpError');
        const mpResults = document.getElementById('mpResults');
        const mpMetric = document.getElementById('mpMetric');
        const mpRows = document.getElementById('mpRows');
        const mpBadge = document.getElementById('mpBadge');
        const mpInfo = document.getElementById('mpInfo');
        const mpFooter = document.getElementById('mpFooter');
        const mpLogInfo = document.getElementById('mpLogInfo');

        let mpLastResult = null;
        const MP_LOG_KEY = 'matrix.measureLog';

        function renderMeasureSelect() {
            if (!mpSelect) return;
            const ids = Object.keys(PLUGINS.measure);
            mpSelect.innerHTML = ids.length
                ? ids.map(id => `<option value="${esc(id)}">${esc(PLUGINS.measure[id].label || id)}</option>`).join('')
                : '<option value="">— плагины мер не подключены —</option>';
            mpBadge.textContent = ids.length ? `${ids.length} шт.` : '—';
        }

        // Вход для меры: берём ДКА последнего поиска, иначе компилируем текущее дерево.
        function measurePluginInput() {
            if (searchResult) return { D: searchResult.D, counts: searchResult.counts, nMax: searchResult.nMax, seq: currentSequence, Engine };
            const spec = buildSpec(condTree, new Map());   // может бросить — ловим выше
            let nMax = parseInt(searchNMax.value, 10);
            if (!Number.isInteger(nMax) || nMax < 1) nMax = 40;
            nMax = Math.min(nMax, SEARCH_LEN_CAP);
            return { D: spec.D, counts: patCountAll(spec.D, nMax), nMax, seq: currentSequence, Engine };
        }

        function runMeasure() {
            mpError.textContent = '';
            const id = mpSelect && mpSelect.value;
            const plugin = id && PLUGINS.measure[id];
            if (!plugin) { mpError.textContent = 'Выберите подключённый плагин меры.'; return; }

            let input;
            try { input = measurePluginInput(); }
            catch (e) { mpResults.hidden = true; mpError.textContent = 'условие: ' + ((e && e.msg) || (e && e.message) || String(e)); return; }

            const t0 = performance.now();
            const r = safeRun(() => plugin.run(input), id);
            const ms = Math.round(performance.now() - t0);
            if (!r.ok) { mpResults.hidden = true; mpError.textContent = `плагин «${id}»: ${r.err}`; return; }

            const out = r.value || {};
            // Мягкая валидация выхода: значение обязано быть сериализуемым.
            let payload;
            try { payload = JSON.stringify(out, (k, v) => typeof v === 'bigint' ? v.toString() : v); }
            catch (_) { mpResults.hidden = true; mpError.textContent = `плагин «${id}»: результат не сериализуется`; return; }

            mpMetric.textContent = out.value === undefined ? '(нет значения)' : String(out.value);
            const rows = Array.isArray(out.rows) ? out.rows : [];
            mpRows.innerHTML = rows.map(([k, v]) => `<span class="mk">${esc(String(k))}</span><span class="mv">${esc(String(v))}</span>`).join('')
                + (out.note ? `<span class="mk">заметка</span><span class="mv">${esc(String(out.note))}</span>` : '');
            mpResults.hidden = false;
            mpFooter.textContent = `плагин «${id}» · ${input.D.n} сост. · ${ms} мс`;

            mpLastResult = { plugin: id, when: new Date().toISOString(), seq: input.seq, states: input.D.n, out: JSON.parse(payload) };
            updateLogInfo();
        }

        function readLog() { try { return JSON.parse(localStorage.getItem(MP_LOG_KEY) || '[]'); } catch (_) { return []; } }
        function updateLogInfo() {
            if (!mpLogInfo) return;
            const n = readLog().length;
            mpLogInfo.textContent = n ? `в журнале: ${n}` : '';
        }
        function saveMeasureToLog() {
            if (!mpLastResult) { mpError.textContent = 'Нечего сохранять — сначала примените меру.'; return; }
            let log;
            try { log = readLog(); log.push(mpLastResult); localStorage.setItem(MP_LOG_KEY, JSON.stringify(log)); }
            catch (e) { mpError.textContent = 'не удалось сохранить в localStorage: ' + (e && e.message || e); return; }
            mpError.textContent = ''; updateLogInfo();
        }
        function downloadJson(name, obj) {
            const blob = new Blob([JSON.stringify(obj, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob); a.download = name;
            document.body.appendChild(a); a.click();
            setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 0);
        }
        function exportMeasure() {
            if (!mpLastResult) { mpError.textContent = 'Нечего экспортировать — сначала примените меру.'; return; }
            downloadJson(`measure-${mpLastResult.plugin}-${Date.now()}.json`, mpLastResult);
        }

        if (mpRunBtn) mpRunBtn.addEventListener('click', runMeasure);
        if (mpSaveBtn) mpSaveBtn.addEventListener('click', saveMeasureToLog);
        if (mpExportBtn) mpExportBtn.addEventListener('click', exportMeasure);
        renderMeasureSelect();
        updateLogInfo();

        // ═══════════════════════════════════════════════════════════════════
        // ЗАГРУЗЧИК ПЛАГИНОВ ИЗ ИНТЕРФЕЙСА
        // Пользователь выбирает .js-файлы или папку → читаем текст → выполняем
        // (файл-плагин зовёт window.Engine.register). Реестр сам обновляет UI.
        // Успешно загруженное кэшируется в localStorage и авто-применяется при
        // следующем открытии. Ядро не трогается.
        // ═══════════════════════════════════════════════════════════════════

        const PLUGIN_CACHE_KEY = 'matrix.pluginCache';
        const REG_SOURCE = {};   // `${kind}/${id}` → имя источника (для чистки кэша)

        const pluginOverlay = document.getElementById('pluginOverlay');
        const pluginOpenBtn = document.getElementById('pluginOpenBtn');
        const pluginCloseBtn = document.getElementById('pluginCloseBtn');
        const pluginFileInput = document.getElementById('pluginFileInput');
        const pluginDrop = document.getElementById('pluginDrop');
        const pluginStatus = document.getElementById('pluginStatus');
        const pluginList = document.getElementById('pluginList');
        const pluginForgetBtn = document.getElementById('pluginForgetBtn');
        const pluginCountBadge = document.getElementById('pluginCountBadge');
        const pluginNameInput = document.getElementById('pluginNameInput');
        const pluginLoadNameBtn = document.getElementById('pluginLoadNameBtn');
        const pluginFolderList = document.getElementById('pluginFolderList');
        const pluginCodeArea = document.getElementById('pluginCodeArea');
        const pluginRunCodeBtn = document.getElementById('pluginRunCodeBtn');
        const pluginDropNote = document.getElementById('pluginDropNote');
        const pluginDiag = document.getElementById('pluginDiag');
        if (pluginDropNote) pluginDropNote.textContent = 'Если диалог не открывается — среда (Whisk/WebView) не даёт системный диалог. Тогда используйте способ 1 или 2.';
        const PKINDS = ['representation', 'condition', 'measure'];

        // ─── Кэш: записи двух видов ───
        //   { type:'code', name, code }  — исходник (вставка / выбор файла); eval при старте
        //   { type:'src',  name }        — файл из plugins/; повторная инъекция <script> при старте
        const pluginCacheRead = () => { try { return JSON.parse(localStorage.getItem(PLUGIN_CACHE_KEY) || '[]'); } catch (_) { return []; } };
        const pluginCacheWrite = list => { try { localStorage.setItem(PLUGIN_CACHE_KEY, JSON.stringify(list)); } catch (_) { } };
        function pluginCachePut(entry) {
            const list = pluginCacheRead().filter(p => p.name !== entry.name);
            list.push(entry);
            pluginCacheWrite(list);
        }
        function pluginCacheDrop(name) { pluginCacheWrite(pluginCacheRead().filter(p => p.name !== name)); }

        // Множество СНЯТЫХ плагинов (`${kind}/${id}`). Нужно, чтобы снятие плагина
        // пережило перезапуск: примеры и manifest грузятся заново при старте, а
        // снятые тут же убираются обратно. «Снял — осталось снятым».
        const PLUGIN_REMOVED_KEY = 'matrix.pluginRemoved';
        const removedRead = () => { try { return new Set(JSON.parse(localStorage.getItem(PLUGIN_REMOVED_KEY) || '[]')); } catch (_) { return new Set(); } };
        const removedWrite = set => { try { localStorage.setItem(PLUGIN_REMOVED_KEY, JSON.stringify([...set])); } catch (_) { } };
        function removedAdd(key) { const s = removedRead(); s.add(key); removedWrite(s); }
        function removedDel(key) { const s = removedRead(); s.delete(key); removedWrite(s); }

        const pluginSnapshot = () => { const s = {}; for (const k of PKINDS) s[k] = new Set(Object.keys(PLUGINS[k])); return s; };
        function pluginDiffAdded(before) {
            const added = [];
            for (const k of PKINDS) for (const id of Object.keys(PLUGINS[k])) if (!before[k].has(id)) added.push({ kind: k, id });
            return added;
        }

        // Выполнить исходник (вставка/файл). Любое падение — в отчёт, а не в ядро.
        function applyPluginCode(name, code) {
            const before = pluginSnapshot();
            let error = null;
            try { (new Function(code))(); }
            catch (e) { error = (e && (e.message || e.msg)) || String(e); }
            const added = pluginDiffAdded(before);
            for (const a of added) REG_SOURCE[`${a.kind}/${a.id}`] = name;
            return { added, error };
        }

        // Загрузка файла из plugins/ ТЕГОМ <script> (не fetch!). Теги грузятся с
        // file:// и в WebView/Whisk — в отличие от fetch, который там блокируется.
        function injectPluginScript(name) {
            return new Promise(resolve => {
                const before = pluginSnapshot();
                const s = document.createElement('script');
                s.src = 'plugins/' + name;
                s.onload = () => { s.remove(); const added = pluginDiffAdded(before); for (const a of added) REG_SOURCE[`${a.kind}/${a.id}`] = name; resolve({ added, error: null }); };
                s.onerror = () => { s.remove(); resolve({ added: [], error: `файл plugins/${name} не найден или не загрузился` }); };
                document.head.appendChild(s);
            });
        }

        function setPluginStatus(html) { if (pluginStatus) pluginStatus.innerHTML = html; }

        function reportLoad(name, added, error) {
            if (error) setPluginStatus(`<span class="err">✗ ${esc(name)}: ${esc(error)}</span>`);
            else if (!added.length) setPluginStatus(`<span class="ok">✓ ${esc(name)}: уже подключён — см. список ниже (ничего нового не добавлено).</span>`);
            else {
                for (const a of added) removedDel(`${a.kind}/${a.id}`);   // раз загрузили — снят с «снятых»
                setPluginStatus(`<span class="ok">✓ Загружен ${esc(name)}: ${esc(added.map(a => a.kind + '/' + a.id).join(', '))} — сохранён, останется после перезапуска.</span>`);
            }
            renderPluginList(); updatePluginCount(); renderDiag();
        }

        // Способ 3: выбранные/бро́шенные файлы через FileReader (обычный браузер).
        function loadPluginFiles(fileList) {
            const files = [...fileList].filter(f => /\.js$/i.test(f.name));
            if (!files.length) { setPluginStatus('<span class="warn">В выборе нет .js-файлов.</span>'); return; }
            const msgs = new Array(files.length); let done = 0;
            files.forEach((file, i) => {
                const rd = new FileReader();
                rd.onload = () => {
                    const { added, error } = applyPluginCode(file.name, rd.result);
                    if (error) msgs[i] = `<span class="err">✗ ${esc(file.name)}: ${esc(error)}</span>`;
                    else if (!added.length) msgs[i] = `<span class="warn">⚠ ${esc(file.name)}: не зарегистрировал плагинов</span>`;
                    else { msgs[i] = `<span class="ok">✓ ${esc(file.name)}: ${esc(added.map(a => a.kind + '/' + a.id).join(', '))}</span>`; pluginCachePut({ type: 'code', name: file.name, code: rd.result }); }
                    if (++done === files.length) { setPluginStatus(msgs.join('\n')); renderPluginList(); updatePluginCount(); renderDiag(); }
                };
                rd.onerror = () => { msgs[i] = `<span class="err">✗ ${esc(file.name)}: не удалось прочитать</span>`; if (++done === files.length) { setPluginStatus(msgs.join('\n')); renderPluginList(); updatePluginCount(); } };
                rd.readAsText(file);
            });
        }

        function renderPluginList() {
            const rows = [];
            for (const kind of PKINDS) {
                for (const id of Object.keys(PLUGINS[kind])) {
                    const p = PLUGINS[kind][id];
                    const builtin = Engine.isBuiltin(kind, id);
                    rows.push(`<div class="plugin-item">
                        <span class="pk">${kind}</span>
                        <span class="pid">${esc(id)}</span>
                        <span class="plabel">${esc((p && p.label) || '')}</span>
                        ${builtin ? '<span class="pbuiltin">встроенный</span>'
                            : `<button class="premove" data-kind="${kind}" data-id="${esc(id)}" title="Снять плагин">×</button>`}
                    </div>`);
                }
            }
            if (pluginList) pluginList.innerHTML = rows.join('') || '<div class="plugin-empty">Плагинов нет</div>';
        }

        function updatePluginCount() {
            let n = 0;
            for (const kind of PKINDS) for (const id of Object.keys(PLUGINS[kind])) if (!Engine.isBuiltin(kind, id)) n++;
            if (pluginCountBadge) pluginCountBadge.textContent = String(n);
        }

        // Диагностика: видно, что все плагины на месте, и работает ли сохранение.
        function storageAvailable() { try { const k = 'matrix.__t'; localStorage.setItem(k, '1'); localStorage.removeItem(k); return true; } catch (_) { return false; } }
        function renderDiag() {
            if (!pluginDiag) return;
            const cnt = k => Object.keys(PLUGINS[k]).length;
            const store = storageAvailable()
                ? 'сохранение вкл. ✓'
                : '<span style="color:var(--orange)">хранилище недоступно — используйте manifest.js</span>';
            pluginDiag.innerHTML = `Подключено: <b>${cnt('representation')}</b> представл., <b>${cnt('condition')}</b> усл., <b>${cnt('measure')}</b> мер · ${store}`;
        }

        function refreshFolderList() {
            if (!pluginFolderList) return;
            const names = Array.isArray(window.PLUGIN_MANIFEST) ? window.PLUGIN_MANIFEST : [];
            if (!names.length) { pluginFolderList.innerHTML = '<div class="plugin-empty">Список пуст. Впишите имя файла выше, или добавьте его в <code>plugins/manifest.js</code>.</div>'; return; }
            const loadedSources = new Set(Object.values(REG_SOURCE));
            pluginFolderList.innerHTML = names.map(n =>
                `<div class="plugin-folder-item"><code>${esc(n)}</code>` +
                (loadedSources.has(n)
                    ? '<span class="plugin-tag-ok">подключён</span>'
                    : `<button class="btn btn-secondary" data-load="${esc(n)}" style="padding:5px 12px;font-size:0.8rem">Загрузить</button>`) +
                '</div>').join('');
        }

        // Способ 2: по имени из папки plugins/ (инъекция тега <script>).
        async function loadFromFolderByName(raw) {
            let name = (raw || '').trim().replace(/^\.?\/?plugins\//i, '');
            if (!name) { setPluginStatus('<span class="warn">Введите имя файла.</span>'); return; }
            if (!/\.js$/i.test(name)) name += '.js';
            setPluginStatus(`<span class="warn">Загрузка ${esc(name)}…</span>`);
            const { added, error } = await injectPluginScript(name);
            if (!error && added.length) pluginCachePut({ type: 'src', name });
            reportLoad(name, added, error);
        }

        // ─── Открытие / закрытие окна (div-оверлей) ───
        function openPluginDialog() {
            renderPluginList(); updatePluginCount(); renderDiag(); refreshFolderList();
            if (pluginStatus && !pluginStatus.innerHTML) setPluginStatus('');
            if (pluginOverlay) pluginOverlay.hidden = false;
        }
        function closePluginDialog() { if (pluginOverlay) pluginOverlay.hidden = true; }

        if (pluginOpenBtn) pluginOpenBtn.addEventListener('click', openPluginDialog);
        if (pluginCloseBtn) pluginCloseBtn.addEventListener('click', closePluginDialog);
        if (pluginOverlay) pluginOverlay.addEventListener('click', e => { if (e.target === pluginOverlay) closePluginDialog(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && pluginOverlay && !pluginOverlay.hidden) closePluginDialog(); });

        if (pluginLoadNameBtn) pluginLoadNameBtn.addEventListener('click', () => loadFromFolderByName(pluginNameInput.value));
        if (pluginNameInput) pluginNameInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); loadFromFolderByName(pluginNameInput.value); } });
        if (pluginFolderList) pluginFolderList.addEventListener('click', e => { const b = e.target.closest('[data-load]'); if (b) loadFromFolderByName(b.dataset.load); });

        if (pluginRunCodeBtn) pluginRunCodeBtn.addEventListener('click', () => {
            const code = pluginCodeArea.value;
            if (!code.trim()) { setPluginStatus('<span class="warn">Вставьте код плагина.</span>'); return; }
            const name = 'вставленный-код-' + (Date.now() % 100000) + '.js';
            const { added, error } = applyPluginCode(name, code);
            if (!error && added.length) { pluginCachePut({ type: 'code', name, code }); pluginCodeArea.value = ''; }
            reportLoad(name, added, error);
        });

        if (pluginFileInput) pluginFileInput.addEventListener('change', () => { if (pluginFileInput.files.length) loadPluginFiles(pluginFileInput.files); pluginFileInput.value = ''; });
        if (pluginDrop) {
            ['dragenter', 'dragover'].forEach(ev => pluginDrop.addEventListener(ev, e => { e.preventDefault(); pluginDrop.classList.add('drag'); }));
            pluginDrop.addEventListener('dragleave', e => { e.preventDefault(); pluginDrop.classList.remove('drag'); });
            pluginDrop.addEventListener('drop', e => { e.preventDefault(); pluginDrop.classList.remove('drag'); if (e.dataTransfer && e.dataTransfer.files.length) loadPluginFiles(e.dataTransfer.files); });
        }

        if (pluginList) pluginList.addEventListener('click', e => {
            const btn = e.target.closest('.premove'); if (!btn) return;
            const kind = btn.dataset.kind, id = btn.dataset.id;
            try { Engine.unregister(kind, id); }
            catch (err) { setPluginStatus(`<span class="err">${esc(err.message || String(err))}</span>`); return; }
            const key = `${kind}/${id}`, src = REG_SOURCE[key];
            removedAdd(key);                       // снятие переживёт перезапуск
            if (src) { pluginCacheDrop(src); delete REG_SOURCE[key]; }
            renderPluginList(); updatePluginCount(); renderDiag();
            setPluginStatus(`<span class="ok">Снят ${esc(kind)}/${esc(id)} — останется снятым и после перезапуска (чтобы вернуть, загрузите снова).</span>`);
        });

        if (pluginForgetBtn) pluginForgetBtn.addEventListener('click', () => {
            localStorage.removeItem(PLUGIN_CACHE_KEY);
            localStorage.removeItem(PLUGIN_REMOVED_KEY);
            setPluginStatus('<span class="ok">Сброшено к набору по умолчанию. Полностью применится после перезагрузки страницы.</span>');
        });

        // Старт (после того как теги <script> примеров и manifest.js отработали):
        //   1) авто-загрузка manifest.js — постоянная установка «на диске»;
        //   2) авто-применение пользовательского кэша (загруженное из интерфейса);
        //   3) применение снятий — что пользователь убрал, остаётся убранным.
        // BUILTIN НЕ пересобираем: неснимаемо только ядро языков.
        window.addEventListener('load', async () => {
            const msgs = [];
            const manifest = Array.isArray(window.PLUGIN_MANIFEST) ? window.PLUGIN_MANIFEST : [];
            for (const name of manifest) {
                const { error } = await injectPluginScript(name);
                if (error) msgs.push(`<span class="warn">manifest ${esc(name)}: ${esc(error)}</span>`);
            }
            for (const entry of pluginCacheRead()) {
                let added, error;
                if (entry.type === 'src') ({ added, error } = await injectPluginScript(entry.name));
                else ({ added, error } = applyPluginCode(entry.name, entry.code));
                if (error) msgs.push(`<span class="err">✗ ${esc(entry.name)}: ${esc(error)}</span>`);
            }
            for (const key of removedRead()) {
                const i = key.indexOf('/');
                try { Engine.unregister(key.slice(0, i), key.slice(i + 1)); } catch (_) { }
            }
            if (msgs.length) setPluginStatus(msgs.join('\n'));
            updatePluginCount(); renderPluginList(); renderDiag();
        });

        // ═══════════════════════════════════════════════════════════════════
        // РАБОЧАЯ ОБЛАСТЬ ПЛАГИНОВ — окно-рэк
        // Каждый подключённый плагин открывается своей самодостаточной панелью.
        // Ядро и существующие панели не трогаются: панели зовут те же
        // Engine/PLUGINS/buildCondition/decode-encode, что и основной интерфейс.
        // ═══════════════════════════════════════════════════════════════════

        const workspaceOverlay = document.getElementById('workspaceOverlay');
        const workspaceOpenBtn = document.getElementById('workspaceOpenBtn');
        const wsCloseBtn = document.getElementById('wsCloseBtn');
        const wsPalette = document.getElementById('wsPalette');
        const wsPanels = document.getElementById('wsPanels');
        const WS_OPEN_KEY = 'matrix.workspaceOpen';
        const wsOpenPanels = new Map();   // "kind/id" → элемент карточки
        let wsRestored = false;

        const wsOpenRead = () => { try { return JSON.parse(localStorage.getItem(WS_OPEN_KEY) || '[]'); } catch (_) { return []; } };
        const wsOpenWrite = () => { try { localStorage.setItem(WS_OPEN_KEY, JSON.stringify([...wsOpenPanels.keys()])); } catch (_) { } };

        function wsRenderPalette() {
            if (!wsPalette) return;
            let html = '';
            for (const [kind, label] of [['measure', 'меры'], ['condition', 'условия'], ['representation', 'представления']]) {
                const ids = Object.keys(PLUGINS[kind]);
                if (!ids.length) continue;
                html += `<div class="ws-palette-group-label">${esc(label)}</div>`;
                html += ids.map(id => `<span class="ws-chip" data-kind="${kind}" data-id="${esc(id)}" title="Двойной щелчок — открыть инструмент"><span class="ws-chip-kind">${kind.slice(0, 4)}</span><span class="ws-chip-id">${esc(id)}</span></span>`).join('');
            }
            wsPalette.innerHTML = html || '<span class="ws-note">Нет подключённых плагинов.</span>';
        }

        function wsRenderEmpty() {
            if (wsPanels && !wsOpenPanels.size) wsPanels.innerHTML = '<div class="ws-empty">Двойной щелчок по плагину сверху — откроется его инструмент. Можно открыть несколько сразу.</div>';
        }

        function wsClosePanel(key) {
            const el = wsOpenPanels.get(key);
            if (el) el.remove();
            wsOpenPanels.delete(key);
            wsOpenWrite();
            wsRenderEmpty();
        }

        function openPluginPanel(kind, id) {
            const key = `${kind}/${id}`;
            const plugin = PLUGINS[kind] && PLUGINS[kind][id];
            if (!plugin) return;
            if (wsOpenPanels.has(key)) { wsOpenPanels.get(key).scrollIntoView({ block: 'nearest' }); return; }
            if (!wsOpenPanels.size && wsPanels) wsPanels.innerHTML = '';   // убрать заглушку

            const panel = document.createElement('div');
            panel.className = 'ws-panel';
            panel.innerHTML = `<div class="ws-panel-head"><span class="wsk">${kind.slice(0, 4)}</span><span class="wsid">${esc(id)}</span><span class="wslabel">${esc(plugin.label || '')}</span><button class="wsclose" title="Закрыть">×</button></div><div class="ws-panel-body"></div>`;
            const body = panel.querySelector('.ws-panel-body');
            panel.querySelector('.wsclose').addEventListener('click', () => wsClosePanel(key));

            const api = {
                Engine, esc, kind, id,
                context: () => ({ sequence: currentSequence, search: searchResult }),
                loadBits: bits => { if (/^[01]+$/.test(bits)) { loadBinIntoField(bits); processSequence(bits); } },
                close: () => wsClosePanel(key)
            };

            // Кастомный UI плагина имеет приоритет; иначе — UI по умолчанию по виду.
            if (typeof plugin.open === 'function') {
                const r = safeRun(() => plugin.open(body, api), key);
                if (!r.ok) body.innerHTML = `<div class="ws-err">Ошибка UI плагина: ${esc(r.err)}</div>`;
            } else if (kind === 'measure') makeMeasurePanel(body, id, plugin);
            else if (kind === 'condition') makeConditionPanel(body, id, plugin);
            else makeReprPanel(body, id, plugin, api);

            wsPanels.appendChild(panel);
            wsOpenPanels.set(key, panel);
            wsOpenWrite();
            panel.scrollIntoView({ block: 'nearest' });
        }

        // ── measure: паттерн → ДКА → счётчики → plugin.run → метрика/строки ──
        function makeMeasurePanel(body, id, plugin) {
            body.innerHTML = `
                <label class="ws-lab">Паттерн (regex-подмножество) — на нём считается язык:</label>
                <div class="ws-row"><input type="text" class="wsm-pat" value=".*" style="flex:1;min-width:120px" placeholder=".*11.*"><label class="ws-lab">классы до</label><input type="number" class="wsm-n" value="40" min="1" max="512" style="width:72px"></div>
                <div class="ws-row"><button class="btn wsm-run">Применить</button><button class="btn btn-secondary wsm-cur">Из текущего поиска</button></div>
                <div class="wsm-err ws-err"></div><div class="wsm-metric ws-metric"></div><div class="wsm-rows ws-out-rows"></div>`;
            const pat = body.querySelector('.wsm-pat'), nEl = body.querySelector('.wsm-n');
            const errEl = body.querySelector('.wsm-err'), metricEl = body.querySelector('.wsm-metric'), rowsEl = body.querySelector('.wsm-rows');
            function show(out) {
                metricEl.textContent = out.value === undefined ? '(нет значения)' : String(out.value);
                const rows = Array.isArray(out.rows) ? out.rows : [];
                rowsEl.innerHTML = rows.map(([k, v]) => `<span class="k">${esc(String(k))}</span><span class="v">${esc(String(v))}</span>`).join('')
                    + (out.note ? `<span class="k">заметка</span><span class="v">${esc(String(out.note))}</span>` : '');
            }
            function run(input) {
                errEl.textContent = ''; metricEl.textContent = ''; rowsEl.innerHTML = '';
                const r = safeRun(() => plugin.run(input), id);
                if (!r.ok) { errEl.textContent = `плагин: ${r.err}`; return; }
                show(r.value || {});
            }
            body.querySelector('.wsm-run').addEventListener('click', () => {
                errEl.textContent = '';
                let N = parseInt(nEl.value, 10); if (!Number.isInteger(N) || N < 1) N = 40; N = Math.min(N, SEARCH_LEN_CAP);
                const rc = safeRun(() => Engine.dfaMinimize(Engine.compile(pat.value || '.*')), 'compile');
                if (!rc.ok) { errEl.textContent = `паттерн: ${rc.err}`; return; }
                run({ D: rc.value, counts: patCountAll(rc.value, N), nMax: N, seq: currentSequence, Engine });
            });
            body.querySelector('.wsm-cur').addEventListener('click', () => {
                errEl.textContent = '';
                if (!searchResult) { errEl.textContent = 'Сначала запустите поиск в основном окне.'; return; }
                run({ D: searchResult.D, counts: searchResult.counts, nMax: searchResult.nMax, seq: currentSequence, Engine });
            });
        }

        // ── condition: поля → buildCondition → состояния + мини-профиль ──
        function makeConditionPanel(body, id, plugin) {
            const fields = (plugin.fields && plugin.fields.length) ? plugin.fields : ((MODES[id] && MODES[id].f) || []);
            let fieldsHtml = fields.map(f => {
                const lab = f.lab ? `<label class="ws-lab">${esc(f.lab)}</label>` : '';
                return f.w === 'num'
                    ? `${lab}<input type="number" class="wsc-f" data-k="${esc(f.k)}" value="1" min="0" max="200" style="width:80px">`
                    : `${lab}<input type="text" class="wsc-f" data-k="${esc(f.k)}" placeholder="${esc(f.ph || '')}" style="width:120px">`;
            }).join(' ');
            if (!fields.length) fieldsHtml = '<span class="ws-note">У условия нет полей — просто нажмите «Собрать».</span>';
            body.innerHTML = `
                <div class="ws-row">${fieldsHtml}</div>
                <div class="ws-row"><button class="btn wsc-run">Собрать</button><label class="ws-lab">классы до</label><input type="number" class="wsc-n" value="30" min="1" max="512" style="width:72px"></div>
                <div class="wsc-err ws-err"></div><div class="wsc-metric ws-metric"></div><div class="wsc-info ws-note"></div><div class="wsc-prof ws-out-rows"></div>`;
            const errEl = body.querySelector('.wsc-err'), metricEl = body.querySelector('.wsc-metric'),
                infoEl = body.querySelector('.wsc-info'), profEl = body.querySelector('.wsc-prof'), nEl = body.querySelector('.wsc-n');
            body.querySelector('.wsc-run').addEventListener('click', () => {
                errEl.textContent = ''; metricEl.textContent = ''; infoEl.textContent = ''; profEl.innerHTML = '';
                const c = { mode: id };
                body.querySelectorAll('.wsc-f').forEach(inp => { c[inp.dataset.k] = inp.value; });
                const r = safeRun(() => buildCondition(c), id);
                if (!r.ok) { errEl.textContent = `условие: ${r.err}`; return; }
                const spec = r.value;
                metricEl.textContent = `${spec.D.n} состояний`;
                infoEl.textContent = spec.human || spec.expr || '';
                let N = parseInt(nEl.value, 10); if (!Number.isInteger(N) || N < 1) N = 30; N = Math.min(N, SEARCH_LEN_CAP);
                const counts = patCountAll(spec.D, N), parts = [];
                for (let n = 1; n <= N && parts.length < 16; n++) parts.push(`<span class="k">длина ${n}</span><span class="v">${esc(counts[n].toString())}</span>`);
                profEl.innerHTML = parts.join('');
            });
        }

        // ── representation: кодер/декодер + «загрузить в приложение» ──
        function makeReprPanel(body, id, plugin, api) {
            const opt = plugin.opt;
            let optHtml = '';
            if (opt) optHtml = opt.values
                ? `<label class="ws-lab">${esc(opt.lab || opt.k)}</label><select class="wsr-opt">${opt.values.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('')}</select>`
                : `<label class="ws-lab">${esc(opt.lab || opt.k)}</label><input type="text" class="wsr-opt" value="${esc(opt.default || opt.ph || '')}" style="width:120px">`;
            body.innerHTML = `
                ${optHtml ? `<div class="ws-row">${optHtml}</div>` : ''}
                <label class="ws-lab">Ввод (${esc(plugin.label || id)}) → биты:</label>
                <div class="ws-row"><input type="text" class="wsr-in" style="flex:1;min-width:120px" placeholder="${esc(plugin.ph || '')}"><button class="btn wsr-dec">→ биты</button></div>
                <div class="wsr-bits ws-mono"></div>
                <div class="ws-row"><button class="btn btn-secondary wsr-load" disabled>Загрузить в приложение ▸</button></div>
                <hr style="border:none;border-top:1px solid var(--border);margin:2px 0;width:100%">
                <label class="ws-lab">Биты → ${esc(plugin.label || id)}:</label>
                <div class="ws-row"><input type="text" class="wsr-bin" style="flex:1;min-width:120px" placeholder="0100100001101001"><button class="btn wsr-enc">→ текст</button></div>
                <div class="wsr-text ws-mono"></div><div class="wsr-err ws-err"></div>`;
            const optEl = body.querySelector('.wsr-opt');
            const getOpt = () => opt ? { [opt.k]: optEl ? optEl.value : (opt.default || opt.ph || '') } : {};
            const inEl = body.querySelector('.wsr-in'), bitsEl = body.querySelector('.wsr-bits'),
                binEl = body.querySelector('.wsr-bin'), textEl = body.querySelector('.wsr-text'),
                errEl = body.querySelector('.wsr-err'), loadBtn = body.querySelector('.wsr-load');
            let lastBits = '';
            body.querySelector('.wsr-dec').addEventListener('click', () => {
                errEl.textContent = ''; textEl.textContent = '';
                const r = safeRun(() => plugin.decode(inEl.value, getOpt()), id);
                if (!r.ok) { bitsEl.textContent = ''; loadBtn.disabled = true; errEl.textContent = `decode: ${r.err}`; return; }
                const d = r.value || {};
                if (d.err) { bitsEl.textContent = ''; loadBtn.disabled = true; errEl.textContent = d.err; return; }
                lastBits = d.bits || '';
                bitsEl.textContent = lastBits + (d.note ? `   (${d.note})` : '');
                loadBtn.disabled = !/^[01]+$/.test(lastBits);
            });
            loadBtn.addEventListener('click', () => { if (/^[01]+$/.test(lastBits)) api.loadBits(lastBits); });
            body.querySelector('.wsr-enc').addEventListener('click', () => {
                errEl.textContent = ''; textEl.textContent = '';
                const bits = binEl.value.trim();
                if (!/^[01]+$/.test(bits)) { errEl.textContent = 'биты: только 0 и 1'; return; }
                const r = safeRun(() => plugin.encode(bits, getOpt()), id);
                if (!r.ok) { errEl.textContent = `encode: ${r.err}`; return; }
                const e = r.value || {};
                if (e.err) { errEl.textContent = e.err; return; }
                textEl.textContent = (e.text || '') + (e.extra ? '   [' + e.extra.map(x => x.join(': ')).join(', ') + ']' : '');
            });
        }

        function openWorkspace() {
            wsRenderPalette();
            if (!wsRestored) {
                wsRestored = true;
                for (const k of wsOpenRead()) { const i = k.indexOf('/'); const kind = k.slice(0, i), id = k.slice(i + 1); if (PLUGINS[kind] && PLUGINS[kind][id]) openPluginPanel(kind, id); }
            }
            wsRenderEmpty();
            if (workspaceOverlay) workspaceOverlay.hidden = false;
        }
        function closeWorkspace() { if (workspaceOverlay) workspaceOverlay.hidden = true; }
        if (workspaceOpenBtn) workspaceOpenBtn.addEventListener('click', openWorkspace);
        if (wsCloseBtn) wsCloseBtn.addEventListener('click', closeWorkspace);
        if (wsPalette) wsPalette.addEventListener('dblclick', e => { const chip = e.target.closest('.ws-chip'); if (chip) openPluginPanel(chip.dataset.kind, chip.dataset.id); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && workspaceOverlay && !workspaceOverlay.hidden) closeWorkspace(); });

        // ─── СТАРТ ───
        renderLangSelect();
        renderLangOpts();
        const def = '101';
        loadBinIntoField(def);
        processSequence(def);
    </script>

    <!-- ─── ПЛАГИНЫ (подключаются ПОСЛЕ ядра, регистрируются на window.Engine) ─── -->
    <!-- Каждый плагин — отдельный файл, разрабатывается независимо. Удалить/добавить
         встроенный плагин = одна строка здесь; ядро не меняется. Свои плагины можно
         не вписывать сюда, а грузить из окна «Плагины» (способы 1–2). -->
    <script src="plugins/manifest.js"></script>
    <script src="plugins/measure-recurrence.js"></script>
    <script src="plugins/condition-onesmod.js"></script>
    <script src="plugins/representation-base64.js"></script>
</body>
</html>
